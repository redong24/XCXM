{
  "module": {
    "name": "uni_modules__rwfit_ble",
    "type": "har",
    "deviceTypes": ["default", "tablet", "2in1"],
    "requestPermissions": [
      {
        "name": "ohos.permission.ACCESS_BLUETOOTH",
        "reason": "$string:rwfit_bluetooth_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      }
    ]
  }
}
