function healthType(metric: string): number {
  switch (metric) {
    case 'hr': return 1
    case 'bloodOxy': return 3
    case 'bloodPressure': return 4
    case 'pressure': return 8
    case 'bloodSugar': return 9
    case 'hrv': return 13
    default: return 0
  }
}

function bindHealthEvents(): void {
  if (removeHealthRealtime == null) {
    removeHealthRealtime = RwBleSdk.onHealthRealtimeData((bean: HealthDataSyncBean): void => {
      const value = bean.muslimCount ?? bean.value ?? bean.hrValue ?? bean.boValue ?? bean.hrvValue ?? bean.pressureValue ?? bean.bloodSugarValue ?? bean.bpSp ?? 0
      realtimeDataListener?.({
        dataType: bean.dataType, dataValue: value,
        diastolic: bean.bpDp, time: bean.timestamp ?? Math.floor(Date.now() / 1000)
      } as RealtimeData)
    })
  }
  if (removeHealthControl == null) {
    removeHealthControl = RwBleSdk.onHealthControlEvent((bean: HealthControlEventBean): void => {
      if (bean.status == 0) realtimeCompleteListener?.()
    })
  }
}

function controlHealth(options: RealtimeMeasureOptions, start: boolean): void {
  const type = healthType(options.metric)
  if (type == 0) { unsupported(options.fail, options.complete, `Unknown realtime metric: ${options.metric}`); return }
  if (start) bindHealthEvents()
  promiseVoid(options.success, options.fail, options.complete, RwBleSdk.controlHealthData(type, start), start ? 'startRealtimeMeasure' : 'stopRealtimeMeasure')
}

export const startRealtimeMeasure: StartRealtimeMeasure = function(options: RealtimeMeasureOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  controlHealth(options, true)
}
export const stopRealtimeMeasure: StopRealtimeMeasure = function(options: RealtimeMeasureOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  controlHealth(options, false)
}

export const getWorkoutState: GetWorkoutState = function(options: WorkoutStateResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  RwBleSdk.getSportStatus().then((bean: NewSportBean): void => {
    resolveValue(options.success, options.complete, { sportType: bean.sportType, controlType: bean.status } as WorkoutState)
  }).catch((error: Error): void => rejectOptions(options.fail, options.complete, error, 'getWorkoutState failed'))
}

export const controlWorkout: ControlWorkout = function(options: WorkoutControlOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  if (options.sportType < 7 || options.sportType > 161 || options.controlType < 1 || options.controlType > 4) {
    invalidOptions(options.fail, options.complete, 'sportType must be 7..161 and controlType must be 1..4'); return
  }
  promiseVoid(options.success, options.fail, options.complete, RwBleSdk.controlSport(options.sportType, options.controlType), 'controlWorkout')
}

export const setWorkoutRealtimeEnabled: SetWorkoutRealtimeEnabled = function(options: EnabledOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  removeWorkoutRealtime?.(); removeWorkoutRealtime = null
  if (options.enabled) {
    removeWorkoutRealtime = RwBleSdk.onSportDataPush((bean: SportDataPushBean): void => {
      workoutRealtimeListener?.({
        duration: bean.activityTime, steps: bean.activitySteps,
        distance: bean.activityDistance, calorie: bean.activityCalorie,
        heartRate: bean.activityHr, dataType: 0x0223
      } as WorkoutRealtimeData)
    })
  }
  promiseVoid(options.success, options.fail, options.complete, RwBleSdk.setExerciseNotify(options.enabled), 'setWorkoutRealtimeEnabled')
}

function pad2(value: number): string { return value < 10 ? `0${value}` : `${value}` }
function dateText(timestamp: number): string {
  const date = new Date(timestamp * 1000)
  return `${date.getFullYear()}${pad2(date.getMonth() + 1)}${pad2(date.getDate())}`
}

function indexed(values?: Array<number>): Array<WorkoutValueItem> {
  const result: Array<WorkoutValueItem> = []
  if (values == null) return result
  values!.forEach((value: number, index: number): void => { result.push({ index, value } as WorkoutValueItem) })
  return result
}

function workoutReport(bean: SportResultBean): WorkoutReport {
  return {
    startTime: bean.startTime, endTime: bean.endTime ?? bean.startTime + bean.exerciseTime,
    date: dateText(bean.startTime), sportType: bean.workModel, duration: bean.exerciseTime,
    step: bean.step, distance: bean.distance, calorie: bean.calorie,
    height: bean.height ?? 0, pressure: bean.barometricPressure ?? 0, cadence: bean.cadence ?? 0,
    speed: bean.speed ?? 0, pace: bean.pace ?? 0, averageHeartRate: bean.averageHr ?? 0,
    maxHeartRate: bean.maxHr ?? 0, minHeartRate: bean.minHr ?? 0,
    maxCadence: bean.maxCadence ?? 0, minCadence: bean.minCadence ?? 0,
    maxPace: bean.maxPace ?? 0, minPace: bean.minPace ?? 0,
    heartRateCount: bean.hrCount ?? bean.newSportHrs.length, viewType: bean.viewType ?? 0,
    heartRateItems: indexed(bean.newSportHrs), pacePerKmItems: indexed(bean.pacePerKmList)
  } as WorkoutReport
}

export const getWorkoutReports: GetWorkoutReports = function(options: WorkoutReportListResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  RwBleSdk.getSportResult().then((beans: Array<SportResultBean>): void => {
    resolveValue(options.success, options.complete, beans.map((bean: SportResultBean): WorkoutReport => workoutReport(bean)))
  }).catch((error: Error): void => rejectOptions(options.fail, options.complete, error, 'getWorkoutReports failed'))
}

