  RwBleSdk.getAlarmRemind().then((beans: Array<AlarmRemainderBean>): void => {
    resolveValue(options.success, options.complete, beans.map((bean: AlarmRemainderBean) => ({
      alarmId: bean.alarmId, startHour: bean.startHour, startMin: bean.startMin,
      isOpen: bean.isOpen, repeats: bean.repeatModel
    })))
  }).catch((error: Error): void => rejectOptions(options.fail, options.complete, error, 'getAlarm failed'))
}
export const setAlarm: SetAlarm = function(options: SetAlarmOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const beans: Array<AlarmRemainderBean> = []
  options.alarms.forEach((value: any): void => {
    const alarm = new UTSJSONObject(value)
    beans.push({
    alarmId: alarm['alarmId'] as number, startHour: alarm['startHour'] as number, startMin: alarm['startMin'] as number,
    isOpen: alarm['isOpen'] as boolean, repeatModel: alarm['repeats'] as Array<number>, alarmTag: ''
  } as AlarmRemainderBean) })
  promiseVoid(options.success, options.fail, options.complete, RwBleSdk.setAlarmRemind(beans), 'setAlarm')
}
