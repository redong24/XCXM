function syncItem(type: string, value: UTSJSONObject): UTSJSONObject {
  const time = (value['timestamp'] ?? value['time'] ?? 0) as number
  if (type == 'bp') return { time, systolic: value['sp'] ?? value['systolic'] ?? 0, diastolic: value['dp'] ?? value['diastolic'] ?? 0 } as UTSJSONObject
  if (type == 'hr') return { time, hr: value['hr'] ?? 0 } as UTSJSONObject
  if (type == 'bo') return { time, bloodOxy: value['bloodOxy'] ?? value['bo'] ?? 0 } as UTSJSONObject
  if (type == 'bloodSugar') return { time, bloodSugar: value['bloodSugar'] ?? value['sugar'] ?? 0 } as UTSJSONObject
  if (type == 'temp') return { time, temp: value['temp'] ?? value['temperature'] ?? 0 } as UTSJSONObject
  if (type == 'pressure') return { time, pressure: value['pressure'] ?? 0 } as UTSJSONObject
  if (type == 'hrv') return { time, hrv: value['hrv'] ?? 0 } as UTSJSONObject
  if (type == 'muslimCount') return { time, count: value['count'] ?? 0 } as UTSJSONObject
  return value
}

function syncPayload(type: string, data: any): Array<UTSJSONObject> {
  const result: Array<UTSJSONObject> = []
  jsonList(data).forEach((day: UTSJSONObject): void => {
    const time = (day['timestamp'] ?? day['time'] ?? 0) as number
    const value = { time, date: day['date'] ?? '' } as UTSJSONObject
    if (type == 'step') {
      value['totalSteps'] = day['totalSteps'] ?? 0; value['totalCalorie'] = day['totalCalorie'] ?? 0
      value['totalDistance'] = day['totalDistance'] ?? 0; value['activityDataInterval'] = day['activityDataInterval'] ?? 60
      const items: Array<UTSJSONObject> = []
      const source = (day['items'] ?? []) as Array<UTSJSONObject>
      source.forEach((item: UTSJSONObject): void => {
        items.push({
          time: item['timestamp'] ?? item['time'] ?? 0,
          index: item['index'] ?? 0,
          steps: item['steps'] ?? item['step'] ?? 0,
          calorie: item['calorie'] ?? 0,
          distance: item['distance'] ?? 0
        } as UTSJSONObject)
      })
      value['items'] = items
    } else if (type == 'sleep') {
      value['duration'] = day['duration'] ?? day['totalSleepTime'] ?? 0
      value['beginTime'] = day['beginTime'] ?? day['asleepTime'] ?? 0
      value['endTime'] = day['endTime'] ?? day['awakeTime'] ?? 0
      value['items'] = day['items'] ?? []
    } else {
      const items: Array<UTSJSONObject> = []
      const source = (day['items'] ?? []) as Array<UTSJSONObject>
      source.forEach((item: UTSJSONObject): void => { items.push(syncItem(type, item)) })
      value['items'] = items
      if (type == 'muslimCount') value['totalCount'] = day['totalCount'] ?? 0
    }
    result.push(value)
  })
  return result
}

function emitSync(type: string, data: any): void { syncResultListener?.({ type, data: syncPayload(type, data) } as SyncResult) }

export const syncAllHealthData: SyncAllHealthData = function(options: VoidOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const callback = {
    onSyncProgress: (progress: number): void => { syncProgressListener?.(progress) },
    onSyncStep: (data): void => emitSync('step', data),
    onSyncSleep: (data): void => emitSync('sleep', data),
    onSyncHr: (data): void => emitSync('hr', data),
    onSyncBo: (data): void => emitSync('bo', data),
    onSyncBp: (data): void => emitSync('bp', data),
    onSyncHrv: (data): void => emitSync('hrv', data),
    onSyncPressure: (data): void => emitSync('pressure', data),
    onSyncBloodSugar: (data): void => emitSync('bloodSugar', data),
    onSyncTemp: (data): void => emitSync('temp', data),
    onSyncMuslimCount: (data): void => emitSync('muslimCount', data),
    onSyncFinish: (): void => { syncFinishListener?.() },
    onSyncError: (code: number): void => { syncErrorListener?.({ code }) }
  } as HealthSyncCallback
  healthSyncCallback = callback
  RwBleSdk.syncAllHealthData(callback); succeed(options.success, options.complete)
}
export const removeHealthDataCallback: RemoveHealthDataCallback = function(options: VoidOptions): void {
  if (!requireInitialized(options.fail, options.complete)) return
  if (healthSyncCallback != null) RwBleSdk.removeHealthDataCallback(healthSyncCallback!)
  healthSyncCallback = null; succeed(options.success, options.complete)
}

export const ringOta: RingOta = function(options: OtaOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const callback = {
    onProgress: (progress: number): void => { otaProgressListener?.(progress) },
    onSuccess: (): void => { otaFinishListener?.({ success: true } as OtaResult) },
    onError: (code: number): void => { otaFinishListener?.({ success: false, code } as OtaResult) }
  } as OTACallback
  RwBleSdk.ringOtaWithFileData(options.path, callback); succeed(options.success, options.complete)
}
export const unbind: Unbind = function(options: VoidOptions): void {
  if (!requireInitialized(options.fail, options.complete)) return
  unsupported(options.fail, options.complete, 'unbind is not exposed by the HarmonyOS SDK')
}

export const pushMessage: PushMessage = function(options: PushMessageOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const value = options.message
  RwBleSdk.setPushMsg({ appId: `${value['appId'] ?? ''}`, title: `${value['title'] ?? ''}`, content: `${value['content'] ?? ''}` } as MsgPushBean)
  succeed(options.success, options.complete)
}
export const setNotificationSwitch: SetNotificationSwitch = function(options: SetNotificationSwitchOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  unsupported(options.fail, options.complete, 'Notification switches are not exposed by the HarmonyOS SDK')
}
export const getNotificationSwitch: GetNotificationSwitch = function(options: JsonResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  unsupported(options.fail, options.complete, 'Notification switches are not exposed by the HarmonyOS SDK')
}

export const onRealtimeData: OnRealtimeData = function(callback: (data: RealtimeData) => void): void { realtimeDataListener = callback; if (initialized) bindHealthEvents() }
export const offRealtimeData: OffRealtimeData = function(): void { realtimeDataListener = null; removeHealthRealtime?.(); removeHealthRealtime = null }
export const onRealtimeMeasureComplete: OnRealtimeMeasureComplete = function(callback: () => void): void { realtimeCompleteListener = callback; if (initialized) bindHealthEvents() }
export const offRealtimeMeasureComplete: OffRealtimeMeasureComplete = function(): void { realtimeCompleteListener = null; removeHealthControl?.(); removeHealthControl = null }
export const onWorkoutRealtimeData: OnWorkoutRealtimeData = function(callback: (data: WorkoutRealtimeData) => void): void { workoutRealtimeListener = callback }
export const offWorkoutRealtimeData: OffWorkoutRealtimeData = function(): void { workoutRealtimeListener = null; removeWorkoutRealtime?.(); removeWorkoutRealtime = null }
export const onSyncProgress: OnSyncProgress = function(callback: (progress: number) => void): void { syncProgressListener = callback }
export const offSyncProgress: OffSyncProgress = function(): void { syncProgressListener = null }
export const onSyncResult: OnSyncResult = function(callback: (result: SyncResult) => void): void { syncResultListener = callback }
export const offSyncResult: OffSyncResult = function(): void { syncResultListener = null }
export const onSyncFinish: OnSyncFinish = function(callback: () => void): void { syncFinishListener = callback }
export const offSyncFinish: OffSyncFinish = function(): void { syncFinishListener = null }
export const onSyncError: OnSyncError = function(callback: (error: UTSJSONObject) => void): void { syncErrorListener = callback }
export const offSyncError: OffSyncError = function(): void { syncErrorListener = null }
export const onOtaProgress: OnOtaProgress = function(callback: (progress: number) => void): void { otaProgressListener = callback }
export const offOtaProgress: OffOtaProgress = function(): void { otaProgressListener = null }
export const onOtaFinish: OnOtaFinish = function(callback: (result: OtaResult) => void): void { otaFinishListener = callback }
export const offOtaFinish: OffOtaFinish = function(): void { otaFinishListener = null }
export const onTouchEvent: OnTouchEvent = function(callback: (event: TouchEvent) => void): void {
  touchEventListener = callback
  removeTouch?.(); removeTouch = RwBleSdk.onTouchEvent((bean: TouchEventBean): void => {
    const action = bean.keyType == 2 ? 'fallDetected'
      : bean.keyType != 1 ? 'unknown'
      : bean.touchType == 1 ? 'singleTap'
      : bean.touchType == 2 ? 'doubleTap'
      : bean.touchType == 3 ? 'tripleTap'
      : bean.touchType == 4 ? 'longPress'
      : bean.touchType == 5 ? 'swing' : 'unknown'
    touchEventListener?.({ action, keyType: bean.keyType, touchType: bean.touchType } as TouchEvent)
  })
  removeTakePhoto?.(); removeTakePhoto = RwBleSdk.onTakePhotoEvent((value: number): void => {
    if (value == 2) touchEventListener?.({ action: 'cameraTakePicture', keyType: value, touchType: 0 } as TouchEvent)
  })
  removeMusicControl?.(); removeMusicControl = RwBleSdk.onMusicControl((value: number): void => {
    const action = value == 1 ? 'musicPlay' : value == 2 ? 'musicPause'
      : value == 3 ? 'musicNext' : value == 4 ? 'musicPrev'
      : value == 5 ? 'musicVolumeUp' : value == 6 ? 'musicVolumeDown' : 'unknown'
    touchEventListener?.({ action, keyType: 0, touchType: 0 } as TouchEvent)
  })
}
export const offTouchEvent: OffTouchEvent = function(): void {
  touchEventListener = null
  removeTouch?.(); removeTouch = null
  removeTakePhoto?.(); removeTakePhoto = null
  removeMusicControl?.(); removeMusicControl = null
}
export const onCallControl: OnCallControl = function(callback: (event: CallControlEvent) => void): void {
  callControlListener = callback
  removeCallControl?.(); removeCallControl = RwBleSdk.onCallControl((value: number): void => {
    const action = value == 1 ? 'answer' : value == 2 ? 'reject' : 'unknown'
    callControlListener?.({ action, rawValue: value } as CallControlEvent)
  })
}
export const offCallControl: OffCallControl = function(): void {
  callControlListener = null
  removeCallControl?.(); removeCallControl = null
}
export const onHealthAlert: OnHealthAlert = function(callback: (event: HealthAlertEvent) => void): void {
  healthAlertListener = callback; removeHealthAlert?.(); removeHealthAlert = RwBleSdk.onHrBoAlertEvent((bean: HrBoActualReminderBean): void => {
    healthAlertListener?.({ type: bean.type, value: bean.remindValue } as HealthAlertEvent)
  })
}
export const offHealthAlert: OffHealthAlert = function(): void { healthAlertListener = null; removeHealthAlert?.(); removeHealthAlert = null }
export const onHeartRateCalibration: OnHeartRateCalibration = function(callback: (result: HeartRateCalibrationResult) => void): void {
  heartRateCalibrationListener = callback; removeCalibration?.(); removeCalibration = RwBleSdk.onFactoryTest((bean: FactoryTestResult): void => {
    heartRateCalibrationListener?.({ testMode: bean.testMode, result: bean.result } as HeartRateCalibrationResult)
  })
}
export const offHeartRateCalibration: OffHeartRateCalibration = function(): void { heartRateCalibrationListener = null; removeCalibration?.(); removeCalibration = null }
export const onSensorRawData: OnSensorRawData = function(callback: (packet: SensorRawPacket) => void): void { sensorRawListener = callback }
export const offSensorRawData: OffSensorRawData = function(): void { sensorRawListener = null; removeSensorRaw?.(); removeSensorRaw = null }
export const onSensorRawStopped: OnSensorRawStopped = function(callback: (event: SensorRawStoppedEvent) => void): void { sensorStoppedListener = callback }
export const offSensorRawStopped: OffSensorRawStopped = function(): void { sensorStoppedListener = null }
