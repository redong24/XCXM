  if (!requireReady(options.fail, options.complete)) return
  RwBleSdk.getHrAlert().then((bean: HrAlertBean): void => resolveValue(options.success, options.complete, {
    isOpen: bean.status == 1, highThreshold: bean.value,
    lowThreshold: bean.underValue == 0xff ? null : bean.underValue
  })).catch((error: Error): void => rejectOptions(options.fail, options.complete, error, 'getHeartRateAlert failed'))
}
export const setHeartRateAlert: SetHeartRateAlert = function(options: HeartRateAlertOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const c = options.config
  if (c.highThreshold < 0 || c.highThreshold > 254 || (c.lowThreshold != null && (c.lowThreshold < 0 || c.lowThreshold > 254))) {
    invalidOptions(options.fail, options.complete, 'heart-rate thresholds must be 0..254'); return
  }
  promiseVoid(options.success, options.fail, options.complete, RwBleSdk.setHrAlert(c.isOpen ? 1 : 0, c.highThreshold, c.lowThreshold ?? 0xff), 'setHeartRateAlert')
}
