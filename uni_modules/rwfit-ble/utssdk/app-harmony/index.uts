const PLUGIN_VERSION = '0.0.1'
let initialized = false
let ready = false
let currentDevice: BleDevice | null = null
let scanResultListener: ((device: BleDevice) => void) | null = null
let scanFinishListener: (() => void) | null = null
let connectStateListener: ((event: ConnectStateEvent) => void) | null = null
let functionMenuListener: ((menu: FunctionMenu) => void) | null = null
let realtimeDataListener: ((data: RealtimeData) => void) | null = null
let realtimeCompleteListener: (() => void) | null = null
let workoutRealtimeListener: ((data: WorkoutRealtimeData) => void) | null = null
let syncProgressListener: ((progress: number) => void) | null = null
let syncResultListener: ((result: SyncResult) => void) | null = null
let syncFinishListener: (() => void) | null = null
let syncErrorListener: ((error: UTSJSONObject) => void) | null = null
let otaProgressListener: ((progress: number) => void) | null = null
let otaFinishListener: ((result: OtaResult) => void) | null = null
let touchEventListener: ((event: TouchEvent) => void) | null = null
let callControlListener: ((event: CallControlEvent) => void) | null = null
let healthAlertListener: ((event: HealthAlertEvent) => void) | null = null
let heartRateCalibrationListener: ((result: HeartRateCalibrationResult) => void) | null = null
let sensorRawListener: ((packet: SensorRawPacket) => void) | null = null
let sensorStoppedListener: ((event: SensorRawStoppedEvent) => void) | null = null
let healthSyncCallback: HealthSyncCallback | null = null
let removeHealthRealtime: (() => void) | null = null
let removeHealthControl: (() => void) | null = null
let removeWorkoutRealtime: (() => void) | null = null
let removeTouch: (() => void) | null = null
let removeTakePhoto: (() => void) | null = null
let removeMusicControl: (() => void) | null = null
let removeCallControl: (() => void) | null = null
let removeHealthAlert: (() => void) | null = null
let removeCalibration: (() => void) | null = null
let removeSensorRaw: (() => void) | null = null

function succeed(successCallback?: () => void, completeCallback?: (result: any | null) => void): void {
  successCallback?.(); completeCallback?.(null)
}

function failure(errorValue: any, message: string = 'HarmonyOS RWFIT SDK error'): RwfitFailImpl {
  const text = errorValue == null ? message : `${message}: ${JSON.stringify(errorValue)}`
  const lower = text.toLowerCase()
  if (lower.includes('timeout') || lower.includes('timed out')) return new RwfitFailImpl(9201006, text, null)
  if (lower.includes('bluetooth') && (lower.includes('off') || lower.includes('unavailable'))) return new RwfitFailImpl(9201002, text, null)
  if (lower.includes('not connected') || lower.includes('not ready')) return new RwfitFailImpl(9201005, text, null)
  return new RwfitFailImpl(9201099, text, null)
}

function rejectOptions(failCallback: ((error: RwfitFail) => void) | null, completeCallback: ((result: any | null) => void) | null, errorValue: any, message: string): void {
  const error = failure(errorValue, message)
  failCallback?.(error); completeCallback?.(error)
}

function unsupported(
  failCallback: ((error: RwfitFail) => void) | null,
  completeCallback: ((result: any | null) => void) | null,
  message: string
): void {
  const error = new RwfitFailImpl(9201007, message, null)
  failCallback?.(error); completeCallback?.(error)
}

function invalidOptions(
  failCallback: ((error: RwfitFail) => void) | null,
  completeCallback: ((result: any | null) => void) | null,
  message: string
): void {
  const error = new RwfitFailImpl(9201004, message, null)
  failCallback?.(error); completeCallback?.(error)
}

function requireInitialized(
  failCallback: ((error: RwfitFail) => void) | null,
  completeCallback: ((result: any | null) => void) | null
): boolean {
  if (initialized) return true
  const error = new RwfitFailImpl(9201001, null, null)
  failCallback?.(error); completeCallback?.(error)
  return false
}

function requireReady(
  failCallback: ((error: RwfitFail) => void) | null,
  completeCallback: ((result: any | null) => void) | null
): boolean {
  if (!requireInitialized(failCallback, completeCallback)) return false
  if (ready && RwBleSdk.isBleConnected()) return true
  const error = new RwfitFailImpl(9201005, null, null)
  failCallback?.(error); completeCallback?.(error)
  return false
}

function validSensorType(value: number): boolean {
  return value == 1 || value == 2 || value == 3 || value == 4 || value == 5 ||
    value == 10 || value == 11 || value == 12 || value == 13
}

function requestBluetoothPermission(
  failCallback: ((error: RwfitFail) => void) | null,
  completeCallback: ((result: any | null) => void) | null,
  onGranted: () => void
): void {
  const context = UTSHarmony.getUIAbilityContext()
  const manager = abilityAccessCtrl.createAtManager()
  const permissions: Array<Permissions> = ['ohos.permission.ACCESS_BLUETOOTH']
  manager.requestPermissionsFromUser(context, permissions).then(result => {
    if (result.authResults.every(value => value === 0)) onGranted()
    else {
      const error = new RwfitFailImpl(9201003, null, null)
      failCallback?.(error); completeCallback?.(error)
    }
  }).catch((error: Error): void => {
    rejectOptions(failCallback, completeCallback, error, 'Bluetooth permission request failed')
  })
}

function promiseVoid(
  successCallback: (() => void) | null,
  failCallback: ((error: RwfitFail) => void) | null,
  completeCallback: ((result: any | null) => void) | null,
  promise: Promise<void>,
  name: string
): void {
  promise.then((): void => succeed(successCallback, completeCallback)).catch((error: Error): void => {
    rejectOptions(failCallback, completeCallback, error, `${name} failed`)
  })
}

function resolveValue<T>(successCallback: ((value: T) => void) | null, completeCallback: ((value: any) => void) | null, value: T): void {
  successCallback?.(value); completeCallback?.(value as any)
}

function jsonObject(value: any): UTSJSONObject {
  return JSON.parse(JSON.stringify(value)) as UTSJSONObject
}

function jsonList(value: any): Array<UTSJSONObject> {
  return JSON.parse(JSON.stringify(value)) as Array<UTSJSONObject>
}

function fromNative(device: RwBleDevice): BleDevice {
  return {
    name: device.name ?? '',
    mac: device.mac ?? '',
    rssi: device.rssi ?? 0,
    uuid: device.uuid ?? device.deviceId,
    deviceId: device.deviceId
  } as BleDevice
}

function toNative(device: BleDevice): RwBleDevice {
  return {
    deviceId: device.deviceId ?? device.uuid ?? device.mac,
    name: device.name,
    mac: device.mac,
    uuid: device.uuid,
    rssi: device.rssi
  } as RwBleDevice
}

function menuMap(bean: SupportMenuBean): UTSJSONObject {
  const interval = bean.activityDataInterval ?? 60
  return {
    isPushMsgEnableSwitch: bean.isPushMsgEnableSwitch ?? false,
    pushMsgSwitchValue: 0,
    pushMsgSwitchValue2: 0,
    activityDataInterval: interval > 0 ? interval : 60,
    isAlarm: bean.isAlarm ?? false,
    isBrightScreenSleepTime: bean.isBrightScreenSleepTime ?? false,
    isBrightScreenTime: bean.isBrightScreenTime ?? false,
    isSupportWorkout: bean.isNewSport ?? false,
    isRememberSwitch: bean.isRememberSwitch ?? false,
    isSupportHrReminder: bean.isSupportHrReminder ?? false,
    isSupportBoReminder: bean.isSupportBoReminder ?? false,
    isSupportMotoVibrationLevel: bean.isSupportMotoVibrationLevel ?? false,
    isSupportAlarmVibrationDuration: bean.isSupportAlarmVibrationDuration ?? false,
    isSupportVibrationInterval: bean.isSupportVibrationInterval ?? false,
    isStep: bean.isStep ?? false,
    isSleep: bean.isSleep ?? false,
    isHr: bean.isHr ?? false,
    isBloodOxy: bean.isBloodOxy ?? false,
    isBloodPress: bean.isBloodPress ?? false,
    isBloodSugar: bean.isBloodSugar ?? false,
    isHrv: bean.isHrv ?? false,
    isPressure: bean.isPressure ?? false,
    isMuslimCountData: bean.isMuslimCountData ?? false,
    isBodyTemp: bean.isDataTypeTemperature ?? false,
    isSupportMuslimTimeDisplayMode: bean.isSupportMuslimTimeDisplayMode ?? false,
    isSupportSensorRawPPG: bean.isSupportSensorRawPPG ?? false,
    isSupportPPGMonitoring: bean.isSupportPPGMonitoring ?? false,
    isSupportTemperatureMonitoring: bean.isSupportTemperatureMonitoring ?? false,
    isSupportCountReminder: bean.isSupportCountReminder ?? false,
    isSupportSensorRawACC: bean.isSupportSensorRawACC ?? false,
    isSupportSensorRawPPGRed: bean.isSupportSensorRawPPGRed ?? false,
    isSupportSensorRawIR: bean.isSupportSensorRawIR ?? false,
    isSupportSensorRawSleep: bean.isSupportSensorRawSleep ?? false,
    isSupportFallDetect: bean.isSupportFallDetect ?? false,
    isSupportRecording: bean.isSupportRecording ?? false,
    isFindDevice: false,
    isTakePhoto: bean.isTakePhoto ?? false,
    isLedLight: bean.isLEDLight ?? false,
    isWearDirection: bean.isWearDir ?? false,
    isVideoHid: false,
    isVideoHidBook: false,
    isVideoHidMusic: false,
    isRaiseBrightScreen: bean.isRaiseBrightScreen ?? false,
    isPowerOff: false,
    isFactoryReset: false,
    isPushMessage: false
  } as UTSJSONObject
}

class RwfitConnectCallback implements RingConnectBleCallback {
  onRingConnecting(): void {
    const device = currentDevice
    connectStateListener?.({ state: 'connecting', name: device?.name, mac: device?.mac, uuid: device?.uuid } as ConnectStateEvent)
  }

  onRingConnected(): void {
    ready = false
    const device = currentDevice
    connectStateListener?.({ state: 'connected', name: device?.name, mac: device?.mac, uuid: device?.uuid } as ConnectStateEvent)
  }

  onRingConnectFailed(reason: string): void {
    ready = false
    const device = currentDevice
    connectStateListener?.({ state: 'failed', name: device?.name, mac: device?.mac, uuid: device?.uuid, reason } as ConnectStateEvent)
  }

  onRingDisconnected(reason: string): void {
    ready = false
    const device = currentDevice
    connectStateListener?.({ state: 'disconnected', name: device?.name, mac: device?.mac, uuid: device?.uuid, reason } as ConnectStateEvent)
  }

  onRingDidFunctionMenu(bean: SupportMenuBean): void {
    ready = true
    const device = currentDevice
    functionMenuListener?.({
      name: bean.name ?? device?.name ?? '',
      mac: bean.mac ?? device?.mac ?? '',
      uuid: bean.uuid ?? device?.uuid,
      raw: menuMap(bean)
    } as FunctionMenu)
  }
}

class RwfitScanCallback implements ScanDeviceCallback {
  onScanDevice(device: RwBleDevice): void {
    scanResultListener?.(fromNative(device))
  }

  onScanFinish(): void {
    scanFinishListener?.()
  }

  onError(code: number, error: Error): void {
    console.error(`RWFIT scan ${code}: ${error.message}`)
  }
}

function bindConnectionCallbacks(): void {
  RwBleSdk.setConnectBleCallback(new RwfitConnectCallback())
}

export const initialize: Initialize = function(options: VoidOptions): void {
  requestBluetoothPermission(options.fail, options.complete, (): void => {
    try {
      const context = UTSHarmony.getUIAbilityContext()
      RwBleSdk.initSDK(context)
      bindConnectionCallbacks()
      initialized = true
      ready = false
      if (realtimeDataListener != null || realtimeCompleteListener != null) bindHealthEvents()
      succeed(options.success, options.complete)
    } catch (error) {
      rejectOptions(options.fail, options.complete, error, 'Unable to initialize HarmonyOS RWFIT SDK')
    }
  })
}

export const getSdkVersion: GetSdkVersion = function(options: StringResultOptions): void {
  const result = RwBleSdk.getSDKVersion(); options.success?.(result); options.complete?.(result)
}

export const getPluginVersion: GetPluginVersion = function(options: StringResultOptions): void {
  const result = `${PLUGIN_VERSION}_${RwBleSdk.getSDKVersion()}`
  options.success?.(result); options.complete?.(result)
}

function beginScan(options: VoidOptions): void {
  RwBleSdk.startScan(new RwfitScanCallback())
  succeed(options.success, options.complete)
}

export const startScan: StartScan = function(options: VoidOptions): void {
  if (!initialized) {
    const error = new RwfitFailImpl(9201001, null, null); options.fail?.(error); options.complete?.(error); return
  }
  requestBluetoothPermission(options.fail, options.complete, (): void => beginScan(options))
}

export const stopScan: StopScan = function(options: VoidOptions): void {
  if (!requireInitialized(options.fail, options.complete)) return
  RwBleSdk.stopScan(); succeed(options.success, options.complete)
}

export const connect: Connect = function(options): void {
  if (!requireInitialized(options.fail, options.complete)) return
  currentDevice = options.device
  RwBleSdk.stopScan(); RwBleSdk.connectDeviceWithModel(toNative(options.device)); succeed(options.success, options.complete)
}

export const reconnect: Reconnect = function(options): void {
  if (!requireInitialized(options.fail, options.complete)) return
  if (options.device == null) {
    const error = new RwfitFailImpl(9201004, 'device is required on HarmonyOS', null)
    options.fail?.(error); options.complete?.(error); return
  }
  currentDevice = options.device!
  RwBleSdk.reconnectDevice(toNative(options.device!)); succeed(options.success, options.complete)
}

export const disconnect: Disconnect = function(options: VoidOptions): void {
  if (!requireInitialized(options.fail, options.complete)) return
  RwBleSdk.disconnect(); succeed(options.success, options.complete)
}

export const iosSetBindedStatus: IosSetBindedStatus = function(options): void {
  if (!requireInitialized(options.fail, options.complete)) return
  succeed(options.success, options.complete)
}

export const isConnected: IsConnected = function(options: BooleanResultOptions): void {
  const result = RwBleSdk.isBleConnected(); options.success?.(result); options.complete?.(result)
}

export const getPower: GetPower = function(options: NumberResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  RwBleSdk.getPower().then((bean: PowerBean) => {
    options.success?.(bean.power); options.complete?.(bean.power)
  }).catch((error: Error): void => {
    const result = failure(error, 'getPower failed'); options.fail?.(result); options.complete?.(result)
  })
}

export const getFirmwareVersion: GetFirmwareVersion = function(options: FirmwareResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  RwBleSdk.getFirmwareVersion().then((bean: FirmVersionBean) => {
    const result = { deviceClazz: bean.deviceClazz ?? '', deviceNo: bean.deviceNo, uiVersion: bean.uiVersion ?? '' } as FirmwareInfo
    options.success?.(result); options.complete?.(result)
  }).catch((error: Error): void => {
    const result = failure(error, 'getFirmwareVersion failed'); options.fail?.(result); options.complete?.(result)
  })
}

export const setUserInfo: SetUserInfo = function(options): void {
  if (!requireReady(options.fail, options.complete)) return
  const person = {
    gender: options.info.gender, age: options.info.age, height: options.info.height,
    weight: options.info.weight, measureUnit: 0
  } as PersonBean
  RwBleSdk.setUserInfo(person).then((): void => {
    succeed(options.success, options.complete)
  }).catch((error: Error): void => {
    rejectOptions(options.fail, options.complete, error, 'setUserInfo failed')
  })
}

export const setTimeFormat: SetTimeFormat = function(options): void {
  if (!requireReady(options.fail, options.complete)) return
  RwBleSdk.setTimeFormat(options.format).then((): void => {
    succeed(options.success, options.complete)
  }).catch((error: Error): void => {
    rejectOptions(options.fail, options.complete, error, 'setTimeFormat failed')
  })
}

export const getFunctionList: GetFunctionList = function(options: FunctionListResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const bean = RwBleSdk.getSupportMenu()
  if (bean == null) {
    const error = new RwfitFailImpl(9201005, null, null); options.fail?.(error); options.complete?.(error); return
  }
  const result = { code: 0, msg: 'success', supportMenu: menuMap(bean!) } as FunctionListResult
  options.success?.(result); options.complete?.(result)
}

export const setRingBtName: SetRingBtName = function(options): void {
  if (!requireReady(options.fail, options.complete)) return
  const error = new RwfitFailImpl(9201007, 'setRingBtName is not exposed by the HarmonyOS SDK', null)
  options.fail?.(error); options.complete?.(error)
}

export const onScanResult: OnScanResult = function(callback: (device: BleDevice) => void): void { scanResultListener = callback }
export const offScanResult: OffScanResult = function(): void { scanResultListener = null }
export const onScanFinish: OnScanFinish = function(callback: () => void): void { scanFinishListener = callback }
export const offScanFinish: OffScanFinish = function(): void { scanFinishListener = null }
export const onConnectState: OnConnectState = function(callback: (event: ConnectStateEvent) => void): void { connectStateListener = callback }
export const offConnectState: OffConnectState = function(): void { connectStateListener = null }
export const onFunctionMenu: OnFunctionMenu = function(callback: (menu: FunctionMenu) => void): void { functionMenuListener = callback }
export const offFunctionMenu: OffFunctionMenu = function(): void { functionMenuListener = null }

function timedFromNative(bean: DrinkReminderBean): TimedConfig {
  return {
    isOpen: bean.isOpen, duration: bean.remindDuration,
    startHour: bean.startHour, startMin: bean.startMin,
    endHour: bean.endHour, endMin: bean.endMin
  } as TimedConfig
}

function timedToNative(config: TimedConfig): DrinkReminderBean {
  return {
    isOpen: config.isOpen, remindDuration: config.duration,
    startHour: config.startHour, startMin: config.startMin,
    endHour: config.endHour, endMin: config.endMin
  } as DrinkReminderBean
}

function getTimed(options: TimedConfigResultOptions, promise: Promise<DrinkReminderBean>, name: string): void {
  promise.then((bean: DrinkReminderBean): void => resolveValue(options.success, options.complete, timedFromNative(bean))).catch((error: Error): void => {
    rejectOptions(options.fail, options.complete, error, `${name} failed`)
  })
}

export const getTimedHeartRate: GetTimedHeartRate = function(options: TimedConfigResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  getTimed(options, RwBleSdk.getTimedHeartRate(), 'getTimedHeartRate')
}
export const setTimedHeartRate: SetTimedHeartRate = function(options: SetTimedConfigOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  promiseVoid(options.success, options.fail, options.complete, RwBleSdk.setTimedHeartRate(timedToNative(options.config)), 'setTimedHeartRate')
}
