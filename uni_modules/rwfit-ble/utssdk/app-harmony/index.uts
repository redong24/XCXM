}

function sensorPacket(bean: SensorRawDataBean): SensorRawPacket {
  const acc: Array<AccRawSample> = []
  bean.accDataList?.forEach((item): void => { acc.push({ x: item.x, y: item.y, z: item.z } as AccRawSample) })
  const sleep: Array<SleepRawSample> = []
  bean.sleepDataList?.forEach((item): void => { sleep.push({ timestampSec: item.time, mode: item.mode } as SleepRawSample) })
  return {
    type: bean.type, timestampSec: bean.timestamp,
    ppg: bean.ppgDataList ?? [], acc,
    ppgRed: bean.ppgRedDataList ?? [], ir: bean.irDataList ?? [], sleep
  } as SensorRawPacket
}

export const controlSensorRaw: ControlSensorRaw = function(options: SensorRawControlOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  if (!validSensorType(options.sensorType)) { invalidOptions(options.fail, options.complete, 'unsupported sensorType combination'); return }
  removeSensorRaw?.(); removeSensorRaw = null
  if (options.enabled) {
    removeSensorRaw = RwBleSdk.onSensorRawData((bean: SensorRawDataBean): void => { sensorRawListener?.(sensorPacket(bean)) })
  }
  RwBleSdk.controlSensorRaw(options.enabled ? 1 : 2, options.sensorType).then((): void => {
    if (!options.enabled) sensorStoppedListener?.({ reason: 0 } as SensorRawStoppedEvent)
    succeed(options.success, options.complete)
  }).catch((error: Error): void => rejectOptions(options.fail, options.complete, error, 'controlSensorRaw failed'))
}
export const getSensorRawHistory: GetSensorRawHistory = function(options: SensorRawListResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  RwBleSdk.getSensorHistoryRaw().then((beans: Array<SensorHistoryRawBean>): void => {
    const result: Array<SensorRawPacket> = []
    beans.forEach((bean: SensorHistoryRawBean): void => {
      const packet = sensorPacket(bean); packet.sequence = bean.sequence; result.push(packet)
    })
    resolveValue(options.success, options.complete, result)
  }).catch((error: Error): void => rejectOptions(options.fail, options.complete, error, 'getSensorRawHistory failed'))
}

