function healthKey(metric: string): Byte {
  const zero = 0
  switch (metric) {
    case 'hr': return CmdConstants.JL_HR_DATA_TRANSFER_KEY
    case 'bloodOxy': return CmdConstants.JL_BO_DATA_TRANSFER_KEY
    case 'hrv': return CmdConstants.JL_HRV_DATA_TRANSFER_KEY
    case 'pressure': return CmdConstants.JL_PRESSURE_DATA_TRANSFER_KEY
    case 'bloodSugar': return CmdConstants.JL_BLOODSUGAR_DATA_TRANSFER_KEY
    case 'bloodPressure': return CmdConstants.JL_BP_DATA_TRANSFER_KEY
    default: return zero.toByte()
  }
}

function bindRealtimeCallback(): void {
  if (realtimeCallback != null) return
  const callback = new (class implements HealthDataBroCallback {
    override onResult(data: HealthDataSyncBean): void {
      const type = data.getDataType()
      if (type == 1) { // Constants.RingHealthType.HR
        const list = data.getHrPartData(); if (list == null || list.isEmpty()) return
        const item: HrPartData = list.get(list.size - 1)
        realtimeDataListener?.({ dataType: type, dataValue: item.getHr(), time: item.getTime().toDouble() } as RealtimeData)
      } else if (type == 13) { // Constants.RingHealthType.HRV; SDK also stores it in HrPartData
        const list = data.getHrPartData(); if (list == null || list.isEmpty()) return
        const item: HrPartData = list.get(list.size - 1)
        realtimeDataListener?.({ dataType: type, dataValue: item.getHr(), time: item.getTime().toDouble() } as RealtimeData)
      } else if (type == 3) {
        const list = data.getBoPartData(); if (list == null || list.isEmpty()) return
        const item: BoPartData = list.get(list.size - 1)
        realtimeDataListener?.({ dataType: type, dataValue: item.getBo(), time: item.getTime().toDouble() } as RealtimeData)
      } else if (type == 4) {
        const list = data.getBpPartData(); if (list == null || list.isEmpty()) return
        const item: BpPartData = list.get(list.size - 1)
        realtimeDataListener?.({ dataType: type, dataValue: item.getSp(), diastolic: item.getDp(), time: item.getTime().toDouble() } as RealtimeData)
      } else if (type == 8) {
        const list = data.getPressurePartData(); if (list == null || list.isEmpty()) return
        const item: PressurePartData = list.get(list.size - 1)
        realtimeDataListener?.({ dataType: type, dataValue: item.getPressure(), time: item.getTime().toDouble() } as RealtimeData)
      } else if (type == 9) { // Constants.RingHealthType.BLOOD_SUGAR; SDK stores it in TempPartData
        const list = data.getTempPartData(); if (list == null || list.isEmpty()) return
        const item: TempPartData = list.get(list.size - 1)
        realtimeDataListener?.({ dataType: type, dataValue: item.getTemp().toDouble() / 10.0, time: item.getTime().toDouble() } as RealtimeData)
      } else if (type == 10) { // Constants.RingHealthType.MUSLIM_COUNT
        const item = data.getMuslimCountPartData(); if (item == null) return
        realtimeDataListener?.({ dataType: type, dataValue: item!.getCount(), time: item!.getTimeMills().toDouble() } as RealtimeData)
      }
    }
    override onFail(_code: Int): void {}
    override onSuccess(): void {}
  })
  realtimeCallback = callback
  DHBleSdk.subscribeData(callback)
}

function controlHealth(options: RealtimeMeasureOptions, start: boolean): void {
  const key = healthKey(options.metric)
  const zero = 0
  if (key == zero.toByte()) { const error = new RwfitFailImpl(9201004, `Unknown realtime metric: ${options.metric}`, null); options.fail?.(error); options.complete?.(error); return }
  bindRealtimeCallback()
  const status = new (class implements HealthDataControlCallback {
    override onResult(data: Int): void { if (data >= 10) realtimeCompleteListener?.() }
    override onFail(code: Int): void { fail(options.fail, options.complete, start ? 'startRealtimeMeasure failed' : 'stopRealtimeMeasure failed', code); DHBleSdk.dispose(this) }
    override onSuccess(): void { succeed(options.success, options.complete) }
  }); DHBleSdk.subscribeData(status)
  const state = start ? 1 : 0
  DHBleSdk.controlHealthDataJL(key, state.toByte())
}

export const startRealtimeMeasure: StartRealtimeMeasure = function(options: RealtimeMeasureOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  controlHealth(options, true) }
export const stopRealtimeMeasure: StopRealtimeMeasure = function(options: RealtimeMeasureOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  controlHealth(options, false) }

export const getWorkoutState: GetWorkoutState = function(options: WorkoutStateResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const cb = new (class implements SportGetControlCallback {
    override onResult(data: NewSportBean): void {
      const result = { sportType: data.getSportType().value, controlType: data.getStatus().value } as WorkoutState
      options.success?.(result); options.complete?.(result); DHBleSdk.dispose(this)
    }
    override onFail(code: Int): void { fail(options.fail, options.complete, 'getWorkoutState failed', code); DHBleSdk.dispose(this) }
    override onSuccess(): void {}
  }); DHBleSdk.subscribeData(cb); DHBleSdk.controlGetSportJLData()
}

export const controlWorkout: ControlWorkout = function(options: WorkoutControlOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  if (options.sportType < 7 || options.sportType > 161 || options.controlType < 1 || options.controlType > 4) {
    invalidOptions(options.fail, options.complete, 'sportType must be 7..161 and controlType must be 1..4'); return
  }
  const sport = BleActivityMode.Companion.fromValue(options.sportType.toInt())
  const control = WorkoutControlType.Companion.fromValue(options.controlType.toInt())
  if (sport == null || control == null) { const error = new RwfitFailImpl(9201004, 'invalid sportType or controlType', null); options.fail?.(error); options.complete?.(error); return }
  const cb = new (class implements SportControlCallback {
    override onResult(_data: NewSportBean): void { succeed(options.success, options.complete); DHBleSdk.dispose(this) }
    override onFail(code: Int): void { fail(options.fail, options.complete, 'controlWorkout failed', code); DHBleSdk.dispose(this) }
    override onSuccess(): void {}
  }); DHBleSdk.subscribeData(cb); DHBleSdk.controlSportJL(sport!, control!)
}

export const setWorkoutRealtimeEnabled: SetWorkoutRealtimeEnabled = function(options: EnabledOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  if (workoutCallback != null) { DHBleSdk.dispose(workoutCallback!); workoutCallback = null }
  if (options.enabled) {
    const cb = new (class implements SportDataPushCallback {
      override onResult(data: SportDataPushBean): void {
        workoutRealtimeListener?.({
          duration: data.gettActivityTime() ?? 0, steps: data.gettActivitySteps() ?? 0,
          // The bundled Android SDK already converts the protocol's 0.1 cal
          // value while parsing workout realtime packets.
          distance: data.gettActivityDistance() ?? 0, calorie: data.gettActivityCalorie() ?? 0,
          heartRate: data.gettActivityHr() ?? 0, dataType: 0x0223
        } as WorkoutRealtimeData)
      }
      override onFail(_code: Int): void {}
      override onSuccess(): void {}
    }); workoutCallback = cb; DHBleSdk.subscribeData(cb)
  }
  const status = new (class implements SportDataPushCallback {
    override onResult(_data: SportDataPushBean): void {}
    override onFail(code: Int): void { fail(options.fail, options.complete, 'setWorkoutRealtimeEnabled failed', code); DHBleSdk.dispose(this) }
    override onSuccess(): void { succeed(options.success, options.complete); DHBleSdk.dispose(this) }
  }); DHBleSdk.subscribeData(status); DHBleSdk.setExerciseMore(options.enabled ? 1 : 0)
}

function pad2(value: number): string { return value < 10 ? `0${value}` : `${value}` }
function workoutDate(timestamp: number): string {
  if (timestamp <= 0) return ''
  const date = new Date(timestamp * 1000)
  return `${date.getFullYear()}${pad2(date.getMonth() + 1)}${pad2(date.getDate())}`
}

function workoutValues(raw: string | null): Array<WorkoutValueItem> {
  const result: Array<WorkoutValueItem> = []
  if (raw == null || raw!.trim().length == 0) return result
  try {
    const values = JSON.parse(raw!) as Array<UTSJSONObject>
    values.forEach((value: UTSJSONObject, index: number): void => {
      result.push({ index: (value['index'] ?? index) as number, value: (value['value'] ?? 0) as number } as WorkoutValueItem)
    })
  } catch (_error) {
    const clean = raw!.replace('[', '').replace(']', '')
    clean.split(',').forEach((value: string, index: number): void => { result.push({ index, value: parseInt(value.trim()) } as WorkoutValueItem) })
  }
  return result
}

function reportFromNative(item: SportResultBean): WorkoutReport {
  const start = item.getStartTime().toDouble(); let end = item.getEndTime().toDouble()
  if (end <= 0 && start > 0) end = start + item.getExerciseTime()
  return {
    startTime: start, endTime: end, date: workoutDate(start), sportType: item.getWorkModel(), duration: item.getExerciseTime(),
    step: item.getStep().toDouble(), distance: item.getDistance().toDouble(), calorie: item.getCalorie().toDouble(),
    height: item.getHeight(), pressure: item.getBarometricPressure(), cadence: item.getCadence(),
    speed: JavaFloat.intBitsToFloat(JavaInteger.reverseBytes(item.getSpeed())).toDouble(), pace: item.getPace(),
    averageHeartRate: item.getAverageHr(), maxHeartRate: item.getMaxHr(), minHeartRate: item.getMinHr(),
    maxCadence: item.getMaxCadence(), minCadence: item.getMinCadence(), maxPace: item.getMaxPace(), minPace: item.getMinPace(),
    heartRateCount: item.getHrCount(), viewType: item.getViewType(),
