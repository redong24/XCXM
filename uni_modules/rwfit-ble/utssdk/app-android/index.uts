export const getFunctionList: GetFunctionList = function(options: FunctionListResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const callback = new (class implements SupportCallback {
    override onSuccess(): void {}
    override onFail(code: Int): void {
      const error = new RwfitFailImpl(9201099, 'getFunctionList failed', code)
      options.fail?.(error); options.complete?.(error); DHBleSdk.dispose(this)
    }
    override onResult(bean: SupportMenuBean): void {
      const result = { code: 0, msg: 'success', supportMenu: menuFromNative(bean) } as FunctionListResult
      options.success?.(result); options.complete?.(result); DHBleSdk.dispose(this)
    }
  })
  DHBleSdk.subscribeData(callback); DHBleSdk.getFunctionListV2JL()
}

export const onScanResult: OnScanResult = function(callback: (device: BleDevice) => void): void { scanResultListener = callback }
export const offScanResult: OffScanResult = function(): void { scanResultListener = null }
export const onScanFinish: OnScanFinish = function(callback: () => void): void { scanFinishListener = callback }
export const offScanFinish: OffScanFinish = function(): void { scanFinishListener = null }
export const onConnectState: OnConnectState = function(callback: (event: ConnectStateEvent) => void): void { connectStateListener = callback }
export const offConnectState: OffConnectState = function(): void { connectStateListener = null }
export const onFunctionMenu: OnFunctionMenu = function(callback: (menu: FunctionMenu) => void): void { functionMenuListener = callback }
export const offFunctionMenu: OffFunctionMenu = function(): void { functionMenuListener = null }

function timedBean(config: TimedConfig): DrinkReminderBean {
  const bean = new DrinkReminderBean()
  bean.setOpen(config.isOpen); bean.setRemindDuration(config.duration.toInt())
  bean.setStartHour(config.startHour.toInt()); bean.setStartMin(config.startMin.toInt())
  bean.setEndHour(config.endHour.toInt()); bean.setEndMin(config.endMin.toInt())
  return bean
}

function timedResult(bean: DrinkReminderBean): TimedConfig {
  return {
    isOpen: bean.isOpen(), duration: bean.getRemindDuration(),
    startHour: bean.getStartHour(), startMin: bean.getStartMin(),
    endHour: bean.getEndHour(), endMin: bean.getEndMin()
  } as TimedConfig
}

