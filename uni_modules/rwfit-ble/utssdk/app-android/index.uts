    override onFail(code: Int): void { fail(options.fail, options.complete, 'setAlarmVibrationDuration failed', code); DHBleSdk.dispose(this) }
    override onSuccess(): void { succeed(options.success, options.complete); DHBleSdk.dispose(this) }
  }); DHBleSdk.subscribeData(cb); DHBleSdk.setAlarmVibrationDuration(options.duration.toInt())
}

function integerList(values: MutableList<Int> | null): Array<number> {
  const result: Array<number> = []; values?.forEach((value: Int): void => { result.push(value) }); return result
}
function accList(values: MutableList<SensorRawDataBean.AccRawItem> | null): Array<AccRawSample> {
  const result: Array<AccRawSample> = []; values?.forEach((item: SensorRawDataBean.AccRawItem): void => { result.push({ x: item.getX(), y: item.getY(), z: item.getZ() } as AccRawSample) }); return result
}
function sensorPacket(data: SensorRawDataBean): SensorRawPacket {
  const sleep: Array<SleepRawSample> = []
  data.getSleepDataList()?.forEach((item: LongArray): void => { if (item.size >= 2) sleep.push({ timestampSec: item[0].toDouble(), mode: item[1].toDouble() } as SleepRawSample) })
  return { type: data.getType(), timestampSec: data.getTimestamp().toDouble(), ppg: integerList(data.getPpgDataList()), acc: accList(data.getAccDataList()), ppgRed: integerList(data.getPpgRedDataList()), ir: integerList(data.getIrDataList()), sleep } as SensorRawPacket
}
function sensorHistoryPacket(data: SensorHistoryRawBean): SensorRawPacket {
  return { type: data.getType(), sequence: data.getSequence(), ppg: integerList(data.getPpgDataList()), acc: accList(data.getAccDataList()), ppgRed: integerList(data.getPpgRedDataList()), ir: integerList(data.getIrDataList()), sleep: [] } as SensorRawPacket
}
export const controlSensorRaw: ControlSensorRaw = function(options: SensorRawControlOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  if (!validSensorType(options.sensorType)) { invalidOptions(options.fail, options.complete, 'unsupported sensorType combination'); return }
  if (sensorRawCallback != null) { DHBleSdk.dispose(sensorRawCallback!); sensorRawCallback = null }
  if (options.enabled) {
    const dataCb = new (class implements SensorRawDataCallback {
      override onResult(data: SensorRawDataBean): void { sensorRawListener?.(sensorPacket(data)) }
      override onFail(_code: Int): void {}
      override onSuccess(): void {}
    }); sensorRawCallback = dataCb; DHBleSdk.subscribeData(dataCb)
  }
  const status = new (class implements SensorRawControlCallback {
    override onResult(data: Int): void { sensorStoppedListener?.({ reason: data } as SensorRawStoppedEvent) }
    override onFail(code: Int): void { fail(options.fail, options.complete, 'controlSensorRaw failed', code); DHBleSdk.dispose(this) }
    override onSuccess(): void { succeed(options.success, options.complete) }
  }); DHBleSdk.subscribeData(status); DHBleSdk.ringControlSensorRaw(options.enabled ? 1 : 2, options.sensorType.toInt())
}
export const getSensorRawHistory: GetSensorRawHistory = function(options: SensorRawListResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const packets: Array<any> = []
  const cb = new (class implements SensorHistoryRawCallback {
    override onResult(data: MutableList<SensorHistoryRawBean>): void { data.forEach((item: SensorHistoryRawBean): void => { packets.push(sensorHistoryPacket(item) as any) }) }
    override onFail(code: Int): void { fail(options.fail, options.complete, 'getSensorRawHistory failed', code); DHBleSdk.dispose(this) }
    override onSuccess(): void { options.success?.(packets); options.complete?.(packets); DHBleSdk.dispose(this) }
  }); DHBleSdk.subscribeData(cb); DHBleSdk.ringGetHistorySensorRaw()
}

export const createOrRemoveBond: CreateOrRemoveBond = function(options: BondOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const result = BlueToothUtils.createOrRemoveBond(options.type.toInt(), options.mac)
  options.success?.(result); options.complete?.(result)
}

function syncDay(time: Long): UTSJSONObject { const value = time.toDouble(); return { time: value, date: workoutDate(value) } as UTSJSONObject }
function emitSync(type: string, data: Array<UTSJSONObject>): void { syncResultListener?.({ type, data } as SyncResult) }

function stepSync(data: MutableList<StepSyncBean>): Array<UTSJSONObject> {
  const result: Array<UTSJSONObject> = []
  data.forEach((bean: StepSyncBean): void => {
    const day = syncDay(bean.getTime()); day['totalSteps'] = bean.getTotalSteps(); day['totalCalorie'] = bean.getTotalCalorie(); day['totalDistance'] = bean.getTotalDistance(); day['activityDataInterval'] = bean.getActivityDataInterval()
    const items: Array<UTSJSONObject> = []; bean.getItems()?.forEach((item: StepItemBean): void => { items.push({ time: item.getTimestamp().toDouble(), index: item.getIndex(), steps: item.getSteps(), calorie: item.getCalorie(), distance: item.getDistance() } as UTSJSONObject) }); day['items'] = items; result.push(day)
  }); return result
}
function sleepSync(data: MutableList<SleepSyncBean>): Array<UTSJSONObject> {
  const result: Array<UTSJSONObject> = []; data.forEach((bean: SleepSyncBean): void => { const day = syncDay(bean.getTime()); day['duration'] = bean.getTotalSleepTime(); day['beginTime'] = bean.getAsleepTime(); day['endTime'] = bean.getAwakeTime(); const items: Array<UTSJSONObject> = []; bean.getItems()?.forEach((item: SleepItemBean): void => { items.push({ len: item.getLen(), sleepType: item.getSleepType() } as UTSJSONObject) }); day['items'] = items; result.push(day) }); return result
}
function hrSync(data: MutableList<HeartRateSyncBean>): Array<UTSJSONObject> {
  const result: Array<UTSJSONObject> = []; data.forEach((bean: HeartRateSyncBean): void => { const day = syncDay(bean.getTime()); const items: Array<UTSJSONObject> = []; bean.getItems()?.forEach((item: HeartRateItemBean): void => { items.push({ time: item.getTimeMills().toDouble(), hr: item.getHr() } as UTSJSONObject) }); day['items'] = items; result.push(day) }); return result
}
function bpSync(data: MutableList<BloodPressSyncBean>): Array<UTSJSONObject> {
  const result: Array<UTSJSONObject> = []; data.forEach((bean: BloodPressSyncBean): void => { const day = syncDay(bean.getTime()); const items: Array<UTSJSONObject> = []; bean.getItems()?.forEach((item: BloodPressItemBean): void => { items.push({ time: item.getTimeMills().toDouble(), systolic: item.getSp(), diastolic: item.getDp() } as UTSJSONObject) }); day['items'] = items; result.push(day) }); return result
}
function boSync(data: MutableList<BloodOxySyncBean>): Array<UTSJSONObject> {
  const result: Array<UTSJSONObject> = []; data.forEach((bean: BloodOxySyncBean): void => { const day = syncDay(bean.getTime()); const items: Array<UTSJSONObject> = []; bean.getItems()?.forEach((item: BloodOxyItemBean): void => { items.push({ time: item.getTimeMills().toDouble(), bloodOxy: item.getBloodOxy() } as UTSJSONObject) }); day['items'] = items; result.push(day) }); return result
}
function tempSync(data: MutableList<BodyTempSyncBean>): Array<UTSJSONObject> {
  const result: Array<UTSJSONObject> = []; data.forEach((bean: BodyTempSyncBean): void => { const day = syncDay(bean.getTime()); const items: Array<UTSJSONObject> = []; bean.getItems()?.forEach((item: BodyTempItemBean): void => { items.push({ time: item.getTimeMills().toDouble(), temp: item.getTemp() } as UTSJSONObject) }); day['items'] = items; result.push(day) }); return result
}
function pressureSync(data: MutableList<PressureSyncBean>): Array<UTSJSONObject> {
  const result: Array<UTSJSONObject> = []; data.forEach((bean: PressureSyncBean): void => { const day = syncDay(bean.getTime()); const items: Array<UTSJSONObject> = []; bean.getItems()?.forEach((item: PressureItemBean): void => { items.push({ time: item.getTimeMills().toDouble(), pressure: item.getPressure() } as UTSJSONObject) }); day['items'] = items; result.push(day) }); return result
}
function sugarSync(data: MutableList<BloodSugarSyncBean>): Array<UTSJSONObject> {
  const result: Array<UTSJSONObject> = []; data.forEach((bean: BloodSugarSyncBean): void => { const day = syncDay(bean.getTime()); const items: Array<UTSJSONObject> = []; bean.getItems()?.forEach((item: BloodSugarItemBean): void => { items.push({ time: item.getTimeMills().toDouble(), bloodSugar: item.getSugar() } as UTSJSONObject) }); day['items'] = items; result.push(day) }); return result
}
function hrvSync(data: MutableList<HrvSyncBean>): Array<UTSJSONObject> {
  const result: Array<UTSJSONObject> = []; data.forEach((bean: HrvSyncBean): void => { const day = syncDay(bean.getTime()); const items: Array<UTSJSONObject> = []; bean.getItems()?.forEach((item: HrvItemBean): void => { items.push({ time: item.getTimeMills().toDouble(), hrv: item.getHrv() } as UTSJSONObject) }); day['items'] = items; result.push(day) }); return result
}
function muslimSync(data: MutableList<MuslimCountSyncBean>): Array<UTSJSONObject> {
  const result: Array<UTSJSONObject> = []; data.forEach((bean: MuslimCountSyncBean): void => { const day = syncDay(bean.getTime()); day['totalCount'] = bean.getTotalCount(); const items: Array<UTSJSONObject> = []; bean.getItems()?.forEach((item: MuslimCountItemBean): void => { items.push({ time: item.getTimeMills().toDouble(), count: item.getCount() } as UTSJSONObject) }); day['items'] = items; result.push(day) }); return result
}

export const syncAllHealthData: SyncAllHealthData = function(options: VoidOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  if (syncCallback != null) DHBleSdk.removeHealthDataCallBack(syncCallback!)
  const cb = new (class implements HealthDataSyncCallback {
    override onSyncProgress(progress: Int): void { if (progress >= 100) syncProgressListener?.(100) }
    override onSyncFinish(): void { syncFinishListener?.() }
    override onSyncError(code: Int): void { syncErrorListener?.({ code }) }
    override onSyncStep(data: MutableList<StepSyncBean>): void { emitSync('step', stepSync(data)) }
    override onSyncSleep(data: MutableList<SleepSyncBean>): void { emitSync('sleep', sleepSync(data)) }
    override onSyncHr(data: MutableList<HeartRateSyncBean>): void { emitSync('hr', hrSync(data)) }
    override onSyncBp(data: MutableList<BloodPressSyncBean>): void { emitSync('bp', bpSync(data)) }
    override onSyncBo(data: MutableList<BloodOxySyncBean>): void { emitSync('bo', boSync(data)) }
    override onSyncTemp(data: MutableList<BodyTempSyncBean>): void { emitSync('temp', tempSync(data)) }
    override onSyncPressure(data: MutableList<PressureSyncBean>): void { emitSync('pressure', pressureSync(data)) }
    override onSyncBloodSugar(data: MutableList<BloodSugarSyncBean>): void { emitSync('bloodSugar', sugarSync(data)) }
    override onSyncBreath(_data: MutableList<BreatheSyncBean>): void {}
    override onSyncHrv(data: MutableList<HrvSyncBean>): void { emitSync('hrv', hrvSync(data)) }
    override onSyncMuslimCount(data: MutableList<MuslimCountSyncBean>): void { emitSync('muslimCount', muslimSync(data)) }
  }); syncCallback = cb; DHBleSdk.syncAllHealthData(cb); succeed(options.success, options.complete)
}
export const removeHealthDataCallback: RemoveHealthDataCallback = function(options: VoidOptions): void {
  if (!requireInitialized(options.fail, options.complete)) return
  if (syncCallback != null) DHBleSdk.removeHealthDataCallBack(syncCallback!); syncCallback = null; succeed(options.success, options.complete) }

export const ringOta: RingOta = function(options: OtaOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  DHBleSdk.ringOtaWithFileData(options.path, new (class implements OnFileTransferCallback {
    override onProgress(progress: Float): void { const value = progress > 1.0 ? progress.toDouble() / 100.0 : progress.toDouble(); otaProgressListener?.(value) }
    override onFinish(): void { otaFinishListener?.({ success: true } as OtaResult) }
    override onFail(code: Int): void { otaFinishListener?.({ success: false, code } as OtaResult) }
  })); succeed(options.success, options.complete)
}

export const unbind: Unbind = function(options: VoidOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const cb = new (class implements CommonStatusCallback {
    override onSuccess(_msgId: Int): void { succeed(options.success, options.complete); DHBleSdk.dispose(this) }
    override onFail(_msgId: Int, code: Int): void { fail(options.fail, options.complete, 'unbind failed', code); DHBleSdk.dispose(this) }
  }); DHBleSdk.subscribeStatus(cb); DHBleSdk.unbindJL()
}

export const pushMessage: PushMessage = function(options: PushMessageOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const value = options.message; const bean = new MsgPushBean()
  bean.setAppId(`${value['appId'] ?? ''}`); bean.setTitle(`${value['title'] ?? ''}`); bean.setContent(`${value['content'] ?? ''}`)
  if (value['msgType'] != null) bean.setMsgType((value['msgType'] as number).toInt())
  if (value['timeMill'] != null) bean.setTimeMill((value['timeMill'] as number).toLong())
  const cb = new (class implements MsgPushSettingCallback {
    override onResult(_data: Int): void {}
    override onFail(code: Int): void { fail(options.fail, options.complete, 'pushMessage failed', code); DHBleSdk.dispose(this) }
    override onSuccess(): void { succeed(options.success, options.complete); DHBleSdk.dispose(this) }
  }); DHBleSdk.subscribeData(cb); DHBleSdk.setPushMsgJL(bean)
}

export const setNotificationSwitch: SetNotificationSwitch = function(options: SetNotificationSwitchOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  unsupported(options.fail, options.complete, 'Notification switches are not exposed by the Android SDK') }
export const getNotificationSwitch: GetNotificationSwitch = function(options: JsonResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  unsupported(options.fail, options.complete, 'Notification switches are not exposed by the Android SDK') }

export const onRealtimeData: OnRealtimeData = function(callback: (data: RealtimeData) => void): void { realtimeDataListener = callback; if (initialized) bindRealtimeCallback() }
export const offRealtimeData: OffRealtimeData = function(): void { realtimeDataListener = null; if (realtimeCallback != null) DHBleSdk.dispose(realtimeCallback!); realtimeCallback = null }
export const onRealtimeMeasureComplete: OnRealtimeMeasureComplete = function(callback: () => void): void { realtimeCompleteListener = callback }
export const offRealtimeMeasureComplete: OffRealtimeMeasureComplete = function(): void { realtimeCompleteListener = null }
export const onWorkoutRealtimeData: OnWorkoutRealtimeData = function(callback: (data: WorkoutRealtimeData) => void): void { workoutRealtimeListener = callback }
export const offWorkoutRealtimeData: OffWorkoutRealtimeData = function(): void { workoutRealtimeListener = null; if (workoutCallback != null) DHBleSdk.dispose(workoutCallback!); workoutCallback = null }
export const onSyncProgress: OnSyncProgress = function(callback: (progress: number) => void): void { syncProgressListener = callback }
export const offSyncProgress: OffSyncProgress = function(): void { syncProgressListener = null }
export const onSyncResult: OnSyncResult = function(callback: (result: SyncResult) => void): void { syncResultListener = callback }
export const offSyncResult: OffSyncResult = function(): void { syncResultListener = null }
export const onSyncFinish: OnSyncFinish = function(callback: () => void): void { syncFinishListener = callback }
export const offSyncFinish: OffSyncFinish = function(): void { syncFinishListener = null }
export const onSyncError: OnSyncError = function(callback: (error: UTSJSONObject) => void): void { syncErrorListener = callback }
export const offSyncError: OffSyncError = function(): void { syncErrorListener = null }
export const onOtaProgress: OnOtaProgress = function(callback: (progress: number) => void): void { otaProgressListener = callback }
export const offOtaProgress: OffOtaProgress = function(): void { otaProgressListener = null }
export const onOtaFinish: OnOtaFinish = function(callback: (result: OtaResult) => void): void { otaFinishListener = callback }
export const offOtaFinish: OffOtaFinish = function(): void { otaFinishListener = null }
function touchAction(keyType: Int, touchType: Int): string {
  if (keyType == 2) return 'fallDetected'
  if (keyType != 1) return 'unknown'
  switch (touchType) { case 1: return 'singleTap'; case 2: return 'doubleTap'; case 3: return 'tripleTap'; case 4: return 'longPress'; case 5: return 'swing'; default: return 'unknown' }
}
export const onTouchEvent: OnTouchEvent = function(callback: (event: TouchEvent) => void): void {
  touchEventListener = callback
  if (touchCallback != null) DHBleSdk.dispose(touchCallback!)
  const cb = new (class implements TouchEventCallback {
    override onResult(data: IntArray): void { if (data.size >= 2) touchEventListener?.({ action: touchAction(data[0], data[1]), keyType: data[0], touchType: data[1] } as TouchEvent) }
    override onFail(_code: Int): void {}
    override onSuccess(): void {}
  }); touchCallback = cb; DHBleSdk.subscribeData(cb)
  if (musicCallback != null) DHBleSdk.dispose(musicCallback!)
  const music = new (class implements MusicPushSettingCallback {
    override onResult(data: Int): void { const action = data == 1 ? 'musicPlay' : data == 2 ? 'musicPause' : data == 3 ? 'musicNext' : data == 4 ? 'musicPrev' : data == 5 ? 'musicVolumeUp' : data == 6 ? 'musicVolumeDown' : 'unknown'; touchEventListener?.({ action, keyType: 0, touchType: 0 } as TouchEvent) }
    override onFail(_code: Int): void {}
    override onSuccess(): void {}
  }); musicCallback = music; DHBleSdk.subscribeData(music)
}
export const offTouchEvent: OffTouchEvent = function(): void { touchEventListener = null; if (touchCallback != null) DHBleSdk.dispose(touchCallback!); touchCallback = null; if (musicCallback != null) DHBleSdk.dispose(musicCallback!); musicCallback = null }
export const onCallControl: OnCallControl = function(callback: (event: CallControlEvent) => void): void {
  callControlListener = callback
  if (callCallback != null) DHBleSdk.dispose(callCallback!)
  const cb = new (class implements CallRemindCallback {
    override onResult(data: Int): void { const action = data == 1 ? 'answer' : data == 2 ? 'reject' : 'unknown'; callControlListener?.({ action, rawValue: data } as CallControlEvent) }
    override onFail(_code: Int): void {}
    override onSuccess(): void {}
  }); callCallback = cb; DHBleSdk.subscribeData(cb)
}
export const offCallControl: OffCallControl = function(): void { callControlListener = null; if (callCallback != null) DHBleSdk.dispose(callCallback!); callCallback = null }
export const onHealthAlert: OnHealthAlert = function(callback: (event: HealthAlertEvent) => void): void {
  healthAlertListener = callback
  if (alertCallback != null) { DHBleSdk.dispose(alertCallback!); alertCallback = null }
  const cb = new (class implements HrBoActualReminderCallback {
    override onResult(data: HrBoActualReminderBean): void { healthAlertListener?.({ type: data.getType(), value: data.getRemindValue() } as HealthAlertEvent) }
    override onFail(_code: Int): void {}
    override onSuccess(): void {}
  }); alertCallback = cb; DHBleSdk.subscribeData(cb)
}
export const offHealthAlert: OffHealthAlert = function(): void { healthAlertListener = null; if (alertCallback != null) DHBleSdk.dispose(alertCallback!); alertCallback = null }
