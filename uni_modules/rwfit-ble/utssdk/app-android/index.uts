}
export const setHeartRateAlert: SetHeartRateAlert = function(options: HeartRateAlertOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const low = options.config.lowThreshold
  if (options.config.highThreshold < 0 || options.config.highThreshold > 254 || (low != null && (low < 0 || low > 254))) {
    invalidOptions(options.fail, options.complete, 'heart-rate thresholds must be 0..254'); return
  }
  const cb = new (class implements HrReminderCallback {
    override onResult(_data: HrReminderBean): void {}
    override onFail(code: Int): void { fail(options.fail, options.complete, 'setHeartRateAlert failed', code); DHBleSdk.dispose(this) }
    override onSuccess(): void { succeed(options.success, options.complete); DHBleSdk.dispose(this) }
  }); DHBleSdk.subscribeData(cb)
  DHBleSdk.deviceSetHrAlertCmd(options.config.isOpen ? 1 : 0, options.config.highThreshold.toInt(), (options.config.lowThreshold ?? 0xff).toInt())
}
