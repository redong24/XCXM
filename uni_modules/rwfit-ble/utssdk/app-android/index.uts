function deviceFromNative(device: NativeBleDevice): BleDevice {
  return {
    name: device.getBleName() ?? '',
    mac: device.getBleMac() ?? '',
    rssi: device.getBleRssi()
  } as BleDevice
}

function menuFromNative(bean: SupportMenuBean): UTSJSONObject {
  const interval = bean.getActivityDataInterval()
  return {
    isPushMsgEnableSwitch: bean.isPushMsgEnableSwitch(),
    pushMsgSwitchValue: bean.getPushMsgSwitchValue(),
    pushMsgSwitchValue2: bean.getPushMsgSwitchValue2(),
    activityDataInterval: interval > 0 ? interval : 60,
    isAlarm: bean.isAlarm(),
    isBrightScreenSleepTime: bean.isBrightScreenSleepTime(),
    isBrightScreenTime: bean.isBrightScreenTime(),
    isSupportWorkout: bean.isNewSport(),
    isRememberSwitch: bean.isRememberSwitch(),
    isSupportHrReminder: bean.isSupportHrReminder(),
    isSupportBoReminder: bean.isSupportBoReminder(),
    isSupportMotoVibrationLevel: bean.isSupportMotoVibrationLevel(),
    isSupportAlarmVibrationDuration: bean.isSupportAlarmVibrationDuration(),
    isSupportVibrationInterval: bean.isSupportVibrationInterval(),
    isStep: bean.isStep(),
    isSleep: bean.isSleep(),
    isHr: bean.isHr(),
    isBloodOxy: bean.isBloodOxy(),
    isBloodPress: bean.isBloodPress(),
    isBloodSugar: bean.isBloodSugar(),
    isHrv: bean.isHrv(),
    isPressure: bean.isPressure(),
    isMuslimCountData: bean.isMuslimCountData(),
    isBodyTemp: bean.isDataTypeTemperature(),
    isSupportMuslimTimeDisplayMode: bean.isSupportMuslimTimeDisplayMode(),
    isSupportSensorRawPPG: bean.isSupportSensorRawPPG(),
    isSupportPPGMonitoring: bean.isSupportPPGMonitoring(),
    isSupportTemperatureMonitoring: bean.isSupportTemperatureMonitoring(),
    isSupportCountReminder: bean.isSupportCountReminder(),
    isSupportSensorRawACC: bean.isSupportSensorRawACC(),
    isSupportSensorRawPPGRed: bean.isSupportSensorRawPPGRed(),
    isSupportSensorRawIR: bean.isSupportSensorRawIR(),
    isSupportSensorRawSleep: bean.isSupportSensorRawSleep(),
    isSupportFallDetect: bean.isSupportFallDetect(),
    isSupportRecording: bean.isSupportRecording(),
    isFindDevice: bean.isFindDevice(),
    isTakePhoto: bean.isTakePhoto(),
    isLedLight: bean.isLEDLight(),
    isWearDirection: bean.isWearDir(),
    isVideoHid: bean.isVideoHid(),
    isVideoHidBook: bean.isVideoHidBook(),
    isVideoHidMusic: bean.isVideoHidMusic(),
    isRaiseBrightScreen: bean.isRaiseBrightScreen(),
    isPowerOff: bean.isPowerOff(),
    isFactoryReset: bean.isRecovery(),
    isPushMessage: bean.isMsgNotification()
  } as UTSJSONObject
}

class CoreCallback implements ScanDeviceCallback, RingConnectBleCallback {
  override onScanDevice(device: NativeBleDevice): void {
    scanResultListener?.(deviceFromNative(device))
  }

  override onScanFinish(): void {
    scanFinishListener?.()
  }

  override onError(errorCode: Int, error: Exception): void {
    console.error(`RWFIT scan error ${errorCode}: ${error.message ?? ''}`)
  }

  override onRingConnecting(device: NativeBleDevice | null): void {
    if (device == null) return
    connectStateListener?.({
      state: 'connecting', name: device.getBleName(), mac: device.getBleMac()
    } as ConnectStateEvent)
  }

  override onRingConnected(device: NativeBleDevice | null): void {
    ready = false
    if (device == null) return
    connectStateListener?.({
      state: 'connected', name: device.getBleName(), mac: device.getBleMac()
    } as ConnectStateEvent)
  }

  override onRingConnectFailed(device: NativeBleDevice | null, reason: RingBleError): void {
    ready = false
    if (device == null) return
    connectStateListener?.({
      state: 'failed', name: device.getBleName(), mac: device.getBleMac(),
      reason: reason.name
    } as ConnectStateEvent)
  }

  override onRingDidFunctionMenu(device: NativeBleDevice | null, supportMenuBean: SupportMenuBean): void {
    if (device == null) return
    ready = true
    functionMenuListener?.({
      name: device.getBleName() ?? '',
      mac: device.getBleMac() ?? '',
      raw: menuFromNative(supportMenuBean)
    } as FunctionMenu)
  }
}

const coreCallback = new CoreCallback()

function requireInitialized(failCallback?: (error: RwfitFail) => void, completeCallback?: (result: any | null) => void): boolean {
  if (initialized) return true
  const error = new RwfitFailImpl(9201001, null, null)
  failCallback?.(error); completeCallback?.(error)
  return false
}

function requireBluetoothAvailable(failCallback?: (error: RwfitFail) => void,
  completeCallback?: (result: any | null) => void): boolean {
  const context = UTSAndroid.getAppContext()
  const manager = context?.getSystemService(Context.BLUETOOTH_SERVICE) as BluetoothManager | null
  const adapter = manager?.getAdapter()
  if (adapter != null && adapter!.isEnabled()) return true
  const error = new RwfitFailImpl(9201002, null, null)
  failCallback?.(error); completeCallback?.(error)
  return false
}

function requireReady(failCallback?: (error: RwfitFail) => void, completeCallback?: (result: any | null) => void): boolean {
  if (!requireInitialized(failCallback, completeCallback)) return false
  if (!requireBluetoothAvailable(failCallback, completeCallback)) return false
  if (ready && DHBleSdk.isBleConnected()) return true
  const error = new RwfitFailImpl(9201005, null, null)
  failCallback?.(error); completeCallback?.(error)
  return false
}

function succeed(successCallback?: () => void, completeCallback?: (result: any | null) => void): void {
  successCallback?.(); completeCallback?.(null)
}

function fail(failCallback: ((error: RwfitFail) => void) | null, completeCallback: ((result: any | null) => void) | null, message: string, nativeCode: number | null): void {
  const lower = message.toLowerCase()
  const code = lower.includes('timeout') || lower.includes('timed out') ? 9201006
    : lower.includes('bluetooth') && (lower.includes('off') || lower.includes('unavailable')) ? 9201002
    : lower.includes('not connected') || lower.includes('not ready') ? 9201005
    : 9201099
  const error = new RwfitFailImpl(code, message, nativeCode)
  failCallback?.(error); completeCallback?.(error)
}

function invalidOptions(failCallback: ((error: RwfitFail) => void) | null, completeCallback: ((result: any | null) => void) | null, message: string): void {
  const error = new RwfitFailImpl(9201004, message, null)
  failCallback?.(error); completeCallback?.(error)
}

function unsupported(failCallback: ((error: RwfitFail) => void) | null,
  completeCallback: ((result: any | null) => void) | null, message: string): void {
  const error = new RwfitFailImpl(9201007, message, null)
  failCallback?.(error); completeCallback?.(error)
}

function validSensorType(value: number): boolean {
  return value == 1 || value == 2 || value == 3 || value == 4 || value == 5 ||
    value == 10 || value == 11 || value == 12 || value == 13
}

function androidBluetoothPermissions(): Array<string> {
  return Build.VERSION.SDK_INT >= 31
    ? ['android.permission.BLUETOOTH_SCAN', 'android.permission.BLUETOOTH_CONNECT']
    : ['android.permission.ACCESS_FINE_LOCATION']
}

function requestBluetoothPermissions(
  failCallback: ((error: RwfitFail) => void) | null,
  completeCallback: ((result: any | null) => void) | null,
  onGranted: () => void
): void {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) {
    fail(failCallback, completeCallback, 'Android activity is unavailable', null); return
  }
  const permissions = androidBluetoothPermissions()
  if (UTSAndroid.checkSystemPermissionGranted(activity, permissions)) {
    onGranted(); return
  }
  let settled = false
  UTSAndroid.requestSystemPermission(
    activity,
    permissions,
    (allRight: boolean, _grantedList: Array<string>): void => {
      if (settled) return
      settled = true
      if (allRight) onGranted()
      else {
        const error = new RwfitFailImpl(9201003, null, null)
        failCallback?.(error); completeCallback?.(error)
      }
    },
    (_doNotAskAgain: boolean, _grantedList: Array<string>): void => {
      if (settled) return
      settled = true
      const error = new RwfitFailImpl(9201003, null, null)
      failCallback?.(error); completeCallback?.(error)
    },
    true
  )
}

function connectNative(device: BleDevice, successCallback?: () => void, failCallback?: (error: RwfitFail) => void, completeCallback?: (result: any | null) => void): void {
  if ((device.mac ?? '').trim().length == 0) {
    const error = new RwfitFailImpl(9201004, 'mac is required on Android', null)
    failCallback?.(error); completeCallback?.(error); return
  }
  const nativeDevice = new NativeBleDevice()
  ready = false
  nativeDevice.setBleName(device.name)
  nativeDevice.setBleMac(device.mac)
  nativeDevice.setBleRssi(device.rssi.toInt())
  DHBleSdk.setConnectBleCallback(coreCallback)
  DHBleSdk.connectDeviceWithModel(nativeDevice)
  succeed(successCallback, completeCallback)
}

export const initialize: Initialize = function(options: VoidOptions): void {
  const context = UTSAndroid.getAppContext()
  if (context == null) {
    fail(options.fail, options.complete, 'Android application context is unavailable', null); return
  }
  requestBluetoothPermissions(options.fail, options.complete, (): void => {
    try {
      DHBleSdk.initSDK(context)
      DHBleSdk.setConnectBleCallback(coreCallback)
      ScanBleService.getService().initBle(context)
      ScanBleService.getService().registerScanBleCallback(coreCallback)
      initialized = true
      ready = false
      if (realtimeDataListener != null) bindRealtimeCallback()
      succeed(options.success, options.complete)
    } catch (error) {
      fail(options.fail, options.complete, `${error}`, null)
    }
  })
}

export const getSdkVersion: GetSdkVersion = function(options: StringResultOptions): void {
  const result = DHBleSdk.getSDKVersion()
  options.success?.(result); options.complete?.(result)
}

export const getPluginVersion: GetPluginVersion = function(options: StringResultOptions): void {
  const result = `${PLUGIN_VERSION}_${DHBleSdk.getSDKVersion()}`
  options.success?.(result); options.complete?.(result)
}

function beginScan(options: VoidOptions): void {
  try {
    ScanBleService.getService().startScan(false, null)
    succeed(options.success, options.complete)
  } catch (error) {
    fail(options.fail, options.complete, `${error}`, null)
  }
}

export const startScan: StartScan = function(options: VoidOptions): void {
  if (!requireInitialized(options.fail, options.complete)) return
  if (!requireBluetoothAvailable(options.fail, options.complete)) return
  requestBluetoothPermissions(options.fail, options.complete, (): void => beginScan(options))
}

export const stopScan: StopScan = function(options: VoidOptions): void {
  if (!requireInitialized(options.fail, options.complete)) return
  ScanBleService.getService().stopScan(); succeed(options.success, options.complete)
}

export const connect: Connect = function(options): void {
  if (!requireInitialized(options.fail, options.complete)) return
  if (!requireBluetoothAvailable(options.fail, options.complete)) return
  connectNative(options.device, options.success, options.fail, options.complete)
}

export const reconnect: Reconnect = function(options): void {
  if (!requireInitialized(options.fail, options.complete)) return
  if (!requireBluetoothAvailable(options.fail, options.complete)) return
  if (options.device == null) {
    const error = new RwfitFailImpl(9201004, 'device is required on Android', null)
    options.fail?.(error); options.complete?.(error); return
  }
  connectNative(options.device!, options.success, options.fail, options.complete)
}

export const disconnect: Disconnect = function(options: VoidOptions): void {
  if (!requireInitialized(options.fail, options.complete)) return
  ready = false
  DHBleSdk.disconnect()
  connectStateListener?.({ state: 'disconnected' } as ConnectStateEvent)
  succeed(options.success, options.complete)
}

export const iosSetBindedStatus: IosSetBindedStatus = function(options): void {
  if (!requireInitialized(options.fail, options.complete)) return
  unsupported(options.fail, options.complete, 'iosSetBindedStatus is only supported on iOS')
}

export const isConnected: IsConnected = function(options: BooleanResultOptions): void {
  const result = initialized && DHBleSdk.isBleConnected()
  options.success?.(result); options.complete?.(result)
}

export const getPower: GetPower = function(options: NumberResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  if (!initialized) {
    const error = new RwfitFailImpl(9201001, null, null); options.fail?.(error); options.complete?.(error); return
  }
  const callback = new (class implements PowerCallback {
    override onSuccess(): void {}
    override onFail(code: Int): void {
      const error = new RwfitFailImpl(9201099, 'getPower failed', code)
      options.fail?.(error); options.complete?.(error); DHBleSdk.dispose(this)
    }
    override onResult(data: PowerBean): void {
      const result = data.getPower()
      options.success?.(result); options.complete?.(result); DHBleSdk.dispose(this)
    }
  })
  DHBleSdk.subscribeData(callback); DHBleSdk.getPowerJL()
}

export const getFirmwareVersion: GetFirmwareVersion = function(options: FirmwareResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const callback = new (class implements FirmwareCallback {
    override onSuccess(): void {}
    override onFail(code: Int): void {
      const error = new RwfitFailImpl(9201099, 'getFirmwareVersion failed', code)
      options.fail?.(error); options.complete?.(error); DHBleSdk.dispose(this)
    }
    override onResult(data: FirmVersionBean): void {
      const result = {
        deviceClazz: data.getDeviceClazz() ?? '',
        deviceNo: data.getDeviceNo() ?? '',
        uiVersion: data.getUiVersion() ?? ''
      } as FirmwareInfo
      options.success?.(result); options.complete?.(result); DHBleSdk.dispose(this)
    }
  })
  DHBleSdk.subscribeData(callback); DHBleSdk.getFirmwareVersionJL()
}

function statusThen(successCallback: (() => void) | null, failCallback: ((error: RwfitFail) => void) | null, completeCallback: ((result: any | null) => void) | null, action: () => void): void {
  const callback = new (class implements CommonStatusCallback {
    override onSuccess(msgId: Int): void {
      succeed(successCallback, completeCallback); DHBleSdk.dispose(this)
    }
    override onFail(msgId: Int, code: Int): void {
      fail(failCallback, completeCallback, 'RWFIT set operation failed', code); DHBleSdk.dispose(this)
    }
  })
  DHBleSdk.subscribeStatus(callback); action()
}

export const setUserInfo: SetUserInfo = function(options): void {
  if (!requireReady(options.fail, options.complete)) return
  const bean = new PersonBean()
  bean.setGender(options.info.gender.toInt()); bean.setAge(options.info.age.toInt())
  bean.setHeight(options.info.height.toFloat()); bean.setWeight(options.info.weight.toFloat())
  bean.setMeasureUnit(0)
  statusThen(options.success, options.fail, options.complete, () => DHBleSdk.setUserInfo(bean))
}

export const setTimeFormat: SetTimeFormat = function(options): void {
  if (!requireReady(options.fail, options.complete)) return
  statusThen(options.success, options.fail, options.complete, () => DHBleSdk.ringSetTimeformat(options.format.toInt()))
}

export const setRingBtName: SetRingBtName = function(options): void {
  if (!requireReady(options.fail, options.complete)) return
  const bean = new BtNameBean(); bean.setBtName(options.name)
