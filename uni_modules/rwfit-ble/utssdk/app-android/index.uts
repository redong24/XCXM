export const startHeartRateCalibration: StartHeartRateCalibration = function(options: VoidOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  if (factoryCallback != null) { DHBleSdk.dispose(factoryCallback!); factoryCallback = null }
  const cb = new (class implements FactoryTestCallback {
    override onResult(data: LongArray): void {
      if (data.size >= 2) heartRateCalibrationListener?.({ testMode: data[0].toDouble(), result: data[1].toDouble() } as HeartRateCalibrationResult)
    }
    override onFail(code: Int): void { fail(options.fail, options.complete, 'startHeartRateCalibration failed', code); DHBleSdk.dispose(this) }
    override onSuccess(): void { succeed(options.success, options.complete) }
  }); factoryCallback = cb; DHBleSdk.subscribeData(cb); DHBleSdk.startFactoryTest(0x15)
}

export const getAlarm: GetAlarm = function(options: AlarmListResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const cb = new (class implements AlarmCallback {
    override onResult(data: MutableList<AlarmRemainderBean>): void {
      const result: Array<any> = []
      data.forEach((bean: AlarmRemainderBean): void => {
        const repeats: Array<number> = []; bean.getRepeatModel().forEach((value: Int): void => { repeats.push(value) })
        result.push(({ alarmId: bean.getAlarmId(), startHour: bean.getStartHour(), startMin: bean.getStartMin(), isOpen: bean.isOpen(), repeats } as Alarm) as any)
      })
      options.success?.(result); options.complete?.(result); DHBleSdk.dispose(this)
    }
    override onFail(code: Int): void { fail(options.fail, options.complete, 'getAlarm failed', code); DHBleSdk.dispose(this) }
    override onSuccess(): void {}
  }); DHBleSdk.subscribeData(cb); DHBleSdk.getAlarmRemindJL()
}

function alarmBeans(alarms: Array<any>): ArrayList<AlarmRemainderBean> {
  const result = new ArrayList<AlarmRemainderBean>()
  alarms.forEach((value: any): void => {
    const alarm = new UTSJSONObject(value)
    const bean = new AlarmRemainderBean(); bean.setAlarmId((alarm['alarmId'] as number).toInt()); bean.setStartHour((alarm['startHour'] as number).toInt()); bean.setStartMin((alarm['startMin'] as number).toInt()); bean.setOpen(alarm['isOpen'] as boolean); bean.setAlarmTag('')
    const repeats = new IntArray(7)
    const rawRepeats = alarm['repeats']
    if (rawRepeats != null) {
      const repeatValues = rawRepeats as Array<any>
      repeatValues.forEach((item: any, index: number): void => { if (index < 7) repeats[index.toInt()] = (item as number).toInt() })
    }
    bean.setRepeatModel(repeats); result.add(bean)
  })
  return result
}

