export const getHeartRateAlert: GetHeartRateAlert = function(options: HeartRateAlertResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const cb = new (class implements HrReminderCallback {
    override onResult(data: HrReminderBean): void {
      const low: number | null = data.getUnderValue() == 0xff ? null : data.getUnderValue()
      const result = { isOpen: data.isOpen(), highThreshold: data.getRemindValue(), lowThreshold: low } as HeartRateAlertConfig
      options.success?.(result); options.complete?.(result); DHBleSdk.dispose(this)
    }
    override onFail(code: Int): void { fail(options.fail, options.complete, 'getHeartRateAlert failed', code); DHBleSdk.dispose(this) }
    override onSuccess(): void {}
