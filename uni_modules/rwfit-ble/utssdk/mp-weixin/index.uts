function syncType(nativeType: string): string {
  const types: UTSJSONObject = {
    steps: 'step', sleep: 'sleep', heartRate: 'hr', bloodOxygen: 'bo',
    bloodPressure: 'bp', hrv: 'hrv', stress: 'pressure', bloodSugar: 'bloodSugar',
    muslimCount: 'muslimCount', temperature: 'temp'
  }
  return (types[nativeType] ?? nativeType) as string
}

function timestampSeconds(value: any): number {
  const timestamp = Number(value ?? 0)
  return Math.floor(timestamp > 100000000000 ? timestamp / 1000 : timestamp)
}

function localDate(timestamp: number): string {
  const date = new Date(timestamp > 100000000000 ? timestamp : timestamp * 1000)
  const month = `${date.getMonth() + 1}`.padStart(2, '0')
  const day = `${date.getDate()}`.padStart(2, '0')
  return `${date.getFullYear()}-${month}-${day}`
}

/**
 * The WeChat SDK exposes BLE_KEY_ACTIVITY_CURRENT_DAY and BLE_KEY_ACTIVITY as
 * flat HealthRecord entries: one `steps-day-*` total plus `steps-hour-*`
 * entries. The shared UTS contract uses one day object with nested items, so
 * group the flat records before emitting them. Zero-step hours are retained.
 */
function normalizedStepRecords(records: Array<any>): Array<UTSJSONObject> {
  const days: Map<string, UTSJSONObject> = new Map()
  const datesWithTotal: Set<string> = new Set()

  records.forEach((record: any): void => {
    const detail = (record.detail ?? {}) as UTSJSONObject
    const recordTime = timestampSeconds(record.measuredAt ?? 0)
    const date = `${detail['date'] ?? ''}` || localDate(recordTime)
    let value = days.get(date)
    if (value == null) {
      value = {
        time: recordTime,
        date,
        totalSteps: 0,
        totalCalorie: 0,
        totalDistance: 0,
        activityDataInterval: detail['activityDataInterval'] ?? 60,
        items: []
      } as UTSJSONObject
      days.set(date, value)
    }

    const id = `${record.id ?? ''}`
    const source = `${detail['source'] ?? ''}`
    const rawItems = (detail['items'] ?? []) as Array<any>
    const isDayTotal = id.startsWith('steps-day-') || source == 'todayTotal' || rawItems.length > 0

    if (isDayTotal) {
      datesWithTotal.add(date)
      value['time'] = recordTime
      value['totalSteps'] = Number(record.value ?? 0)
      value['totalCalorie'] = Number(detail['calorie'] ?? detail['totalCalorie'] ?? 0)
      value['totalDistance'] = Number(detail['distance'] ?? detail['totalDistance'] ?? 0)
      value['activityDataInterval'] = Number(detail['activityDataInterval'] ?? 60)
    } else {
      const items = value['items'] as Array<UTSJSONObject>
      items.push({
        time: recordTime,
        index: detail['slot'] ?? items.length,
        steps: Number(record.value ?? 0),
        calorie: Number(detail['calorie'] ?? 0),
        distance: Number(detail['distance'] ?? 0)
      } as UTSJSONObject)
    }

    if (rawItems.length > 0) {
      const items = value['items'] as Array<UTSJSONObject>
      rawItems.forEach((item: any, index: number): void => {
        items.push({
          time: timestampSeconds(item.measuredAt ?? item.timestamp ?? item.time ?? 0),
          index: item.index ?? item.slot ?? index,
          steps: Number(item.steps ?? item.step ?? 0),
          calorie: Number(item.calorie ?? 0),
          distance: Number(item.distance ?? 0)
        } as UTSJSONObject)
      })
    }
  })

  const result: Array<UTSJSONObject> = []
  days.forEach((day: UTSJSONObject, date: string): void => {
    const source = day['items'] as Array<UTSJSONObject>
    const unique: Map<string, UTSJSONObject> = new Map()
    source.forEach((item: UTSJSONObject): void => {
      const key = `${item['time'] ?? 0}:${item['index'] ?? 0}`
      unique.set(key, item)
    })
    const items = Array.from(unique.values()).sort((first: UTSJSONObject, second: UTSJSONObject): number =>
      Number(first['time'] ?? 0) - Number(second['time'] ?? 0))
    day['items'] = items
    if (!datesWithTotal.has(date)) {
      day['totalSteps'] = items.reduce((total: number, item: UTSJSONObject): number =>
        total + Number(item['steps'] ?? 0), 0)
      day['totalCalorie'] = items.reduce((total: number, item: UTSJSONObject): number =>
        total + Number(item['calorie'] ?? 0), 0)
      day['totalDistance'] = items.reduce((total: number, item: UTSJSONObject): number =>
        total + Number(item['distance'] ?? 0), 0)
    }
    result.push(day)
  })
  return result.sort((first: UTSJSONObject, second: UTSJSONObject): number =>
    Number(second['time'] ?? 0) - Number(first['time'] ?? 0))
}

function recordDay(type: string, record: any): UTSJSONObject {
  const detail = (record.detail ?? {}) as UTSJSONObject
  const time = Math.floor((record.measuredAt ?? Date.now()) / 1000)
  const date = `${detail['date'] ?? ''}`
  if (type == 'step') {
    const rawItems = (detail['items'] ?? []) as Array<any>
    const items = rawItems.map((item: any, index: number): UTSJSONObject => ({
      time: timestampSeconds(item.measuredAt ?? item.timestamp ?? item.time ?? 0),
      index: item.index ?? index,
      steps: item.steps ?? item.step ?? 0,
      calorie: item.calorie ?? 0,
      distance: item.distance ?? 0
    } as UTSJSONObject))
    return { time, date, totalSteps: record.value ?? 0, totalCalorie: detail['calorie'] ?? 0,
      totalDistance: detail['distance'] ?? 0, activityDataInterval: detail['activityDataInterval'] ?? 60,
      items } as UTSJSONObject
  }
  if (type == 'sleep') {
    const rawItems = (detail['items'] ?? []) as Array<any>
    const items = rawItems.map((item: any): UTSJSONObject => ({ len: item.minutes ?? item.len ?? 0, sleepType: item.sleepType ?? 0 } as UTSJSONObject))
    return { time, date, duration: (detail['totalMinutes'] ?? 0) as number,
      beginTime: Math.floor(((detail['asleepAt'] ?? 0) as number) / 1000),
      endTime: Math.floor(((detail['awakeAt'] ?? 0) as number) / 1000), items } as UTSJSONObject
  }
  if (type == 'muslimCount') return { time, date, totalCount: record.value ?? 0, items: [{ time, count: record.value ?? 0 }] } as UTSJSONObject
  let item = { time } as UTSJSONObject
  if (type == 'hr') item['hr'] = record.value ?? 0
  else if (type == 'bo') item['bloodOxy'] = record.value ?? 0
  else if (type == 'bp') {
    const parts = `${record.value ?? ''}`.split('/')
    item['systolic'] = detail['systolic'] ?? Number(parts[0] ?? 0)
    item['diastolic'] = detail['diastolic'] ?? Number(parts[1] ?? 0)
  } else if (type == 'hrv') item['hrv'] = record.value ?? 0
  else if (type == 'pressure') item['pressure'] = record.value ?? 0
  else if (type == 'bloodSugar') item['bloodSugar'] = record.value ?? 0
  else if (type == 'temp') item['temp'] = record.value ?? 0
  return { time, date, items: [item] } as UTSJSONObject
}

function normalizedSyncRecords(nativeType: string, records: Array<any>): SyncResult {
  const type = syncType(nativeType)
  const data = type == 'step'
    ? normalizedStepRecords(records)
    : records.map((record: any): UTSJSONObject => recordDay(type, record))
  return { type, data } as SyncResult
}

export const syncAllHealthData: SyncAllHealthData = function(options: VoidOptions): void {
  if (!ensureClient(options)) return
  client!.syncAllHealthData({
    onProgress: (progress: any) => syncProgressListener?.(progress.percent ?? 0)
  }).then((result: any) => {
    Object.keys(result.records ?? {}).forEach(type => {
      syncResultListener?.(normalizedSyncRecords(type, result.records[type] ?? []))
    })
    if (Object.keys(result.errors ?? {}).length > 0) syncErrorListener?.(result.errors as UTSJSONObject)
    syncProgressListener?.(100); syncFinishListener?.(); succeed(options.success, options.complete)
  }).catch(error => {
    syncErrorListener?.({ message: `${error}` } as UTSJSONObject)
    rejectValue(options, error, 'syncAllHealthData failed')
  })
}

export const removeHealthDataCallback: RemoveHealthDataCallback = function(options: VoidOptions): void {
  if (!initialized) {
    const error = new RwfitFailImpl(9201001, null, null); options.fail?.(error); options.complete?.(error); return
  }
  syncProgressListener = null; syncResultListener = null; syncFinishListener = null; syncErrorListener = null
  succeed(options.success, options.complete)
}

export const ringOta: RingOta = function(options: OtaOptions): void {
  if (!ensureClient(options)) return
  wx.getFileSystemManager().readFile({
    filePath: options.path,
    success: (result: any): void => {
      const bytes = new Uint8Array(result.data as ArrayBuffer)
      client!.upgradeFirmware(bytes, { onProgress: (progress: number) => otaProgressListener?.(progress) })
        .then(() => {
          otaFinishListener?.({ success: true } as OtaResult)
          succeed(options.success, options.complete)
        }).catch(error => {
          const code = typeof error?.errCode === 'number' ? error.errCode : undefined
          otaFinishListener?.({ success: false, code } as OtaResult)
          rejectValue(options, error, 'ringOta failed')
        })
    },
    fail: (error: any): void => rejectValue(options, error, 'read firmware failed')
  })
}

export const unbind: Unbind = function(options: VoidOptions): void {
  if (!initialized) {
    const error = new RwfitFailImpl(9201001, null, null); options.fail?.(error); options.complete?.(error); return
  }
  if (client == null) { currentDevice = null; succeed(options.success, options.complete); return }
  client!.disconnect('unbind').then(() => {
    deviceEventUnsubscribe?.(); deviceEventUnsubscribe = null
    connectionUnsubscribe?.(); connectionUnsubscribe = null
    client = null; connected = false; currentDevice = null
    succeed(options.success, options.complete)
  }).catch(error => rejectValue(options, error, 'unbind failed'))
}

export const pushMessage: PushMessage = function(options: PushMessageOptions): void { unsupported(options, 'Message push is not exposed by the WeChat SDK') }
export const setNotificationSwitch: SetNotificationSwitch = function(options: SetNotificationSwitchOptions): void { unsupported(options, 'Notification switch is not exposed by the WeChat SDK') }
export const getNotificationSwitch: GetNotificationSwitch = function(options: JsonResultOptions): void { unsupported(options, 'Notification switch is not exposed by the WeChat SDK') }

