export const startRealtimeMeasure: StartRealtimeMeasure = function(options: RealtimeMeasureOptions): void {
  if (!ensureClient(options)) return
  const code = measurementCodes[options.metric]
  if (typeof code !== 'number') { rejectValue(options, 'invalid metric', 'startRealtimeMeasure failed'); return }
  client!.setHealthMeasurement(code, true).then(() => succeed(options.success, options.complete))
    .catch(error => rejectValue(options, error, 'startRealtimeMeasure failed'))
}

export const stopRealtimeMeasure: StopRealtimeMeasure = function(options: RealtimeMeasureOptions): void {
  if (!ensureClient(options)) return
  const code = measurementCodes[options.metric]
  if (typeof code !== 'number') { rejectValue(options, 'invalid metric', 'stopRealtimeMeasure failed'); return }
  client!.setHealthMeasurement(code, false).then(() => succeed(options.success, options.complete))
    .catch(error => rejectValue(options, error, 'stopRealtimeMeasure failed'))
}

