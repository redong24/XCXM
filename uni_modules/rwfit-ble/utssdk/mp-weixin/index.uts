export const controlWorkout: ControlWorkout = function(options: WorkoutControlOptions): void {
  if (!ensureClient(options)) return
  if (options.sportType < 7 || options.sportType > 161 || options.controlType < 1 || options.controlType > 4) {
    invalidOptions(options, 'sportType must be 7..161 and controlType must be 1..4'); return
  }
  client!.controlWorkout(options.sportType, options.controlType)
    .then(() => succeed(options.success, options.complete))
    .catch(error => rejectValue(options, error, 'controlWorkout failed'))
}

