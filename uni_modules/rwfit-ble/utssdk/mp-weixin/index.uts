import type {
  BleDevice, ConnectStateEvent, FirmwareInfo, FunctionListResult, FunctionMenu,
  Initialize, GetSdkVersion, GetPluginVersion, StartScan, StopScan, Connect,
  Disconnect, IosSetBindedStatus, Reconnect, IsConnected, GetPower,
  GetFirmwareVersion, SetUserInfo, SetTimeFormat, GetFunctionList,
  SetRingBtName, OnScanResult, OffScanResult, OnScanFinish, OffScanFinish,
  OnConnectState, OffConnectState, OnFunctionMenu, OffFunctionMenu, VoidOptions,
  StringResultOptions, BooleanResultOptions, NumberResultOptions,
  FirmwareResultOptions, FunctionListResultOptions, RwfitFail,
  TimedConfig, TimedConfigResultOptions, SetTimedConfigOptions, RealtimeMetric, RealtimeData,
  RealtimeMeasureOptions, WorkoutStateResultOptions, WorkoutControlOptions, EnabledOptions,
  WorkoutReportListResultOptions, PhotoControlOptions, PhoneControlOptions,
  HeartRateAlertResultOptions, HeartRateAlertOptions, BloodOxygenAlertResultOptions,
  BloodOxygenAlertOptions, SetVibrationIntervalOptions, SetCountReminderIntervalOptions,
  SensorRawControlOptions, SensorRawListResultOptions, AlarmListResultOptions, SetAlarmOptions,
  ScheduleToggleResultOptions, ScheduleToggleOptions, SetBrightScreenTimeOptions,
  LedLevelResultOptions, LedLevelOptions, SetVideoHidOptions, BondOptions, WearHandOptions,
  VibrationResultOptions, VibrationOptions, SetAlarmVibrationDurationOptions, OtaOptions,
  PushMessageOptions, SetNotificationSwitchOptions, JsonResultOptions,
  WorkoutState, WorkoutRealtimeData, WorkoutReport, Alarm, ScheduleToggle,
  LedLevel, VibrationConfig, HeartRateAlertConfig, BloodOxygenAlertConfig,
  HealthAlertEvent, HeartRateCalibrationResult, SensorRawPacket,
  SensorRawStoppedEvent, SyncResult, OtaResult, TouchEvent, CallControlEvent
} from '../interface.uts'
import { RwfitFailImpl } from './unierror.uts'
import type {
  GetTimedHeartRate, GetTimedBloodOxygen, GetTimedHRV, GetTimedStress, GetTimedBloodSugar, GetTimedBloodPressure, GetTimedBodyTemperature, GetTimedPPG,
  SetTimedHeartRate, SetTimedBloodOxygen, SetTimedHRV, SetTimedStress, SetTimedBloodSugar, SetTimedBloodPressure, SetTimedBodyTemperature, SetTimedPPG,
  StartRealtimeMeasure, StopRealtimeMeasure, GetWorkoutState, ControlWorkout, SetWorkoutRealtimeEnabled, GetWorkoutReports, FindDevice, PowerOff,
  FactoryReset, ControlPhoto, ControlPhone, GetMuslimCountEnabled, SetMuslimCountEnabled, GetHeartRateAlert, SetHeartRateAlert, GetBloodOxygenAlert,
  SetBloodOxygenAlert, GetVibrationInterval, SetVibrationInterval, GetFallDetect, SetFallDetect, GetCountReminderInterval, SetCountReminderInterval, StartHeartRateCalibration,
  GetAlarm, SetAlarm, DeleteAllAlarm, GetRaiseBrightScreen, SetRaiseBrightScreen, GetBrightScreenTime, SetBrightScreenTime, GetBrightScreenSleepTime,
  SetBrightScreenSleepTime, GetRingLedLevel, SetRingLedLevel, GetVideoHid, SetVideoHid, GetRingWearDir, SetRingWearHand, GetVibrationCount,
  SetVibrationCount, GetAlarmVibrationDuration, SetAlarmVibrationDuration, ControlSensorRaw, GetSensorRawHistory, CreateOrRemoveBond, SyncAllHealthData, RemoveHealthDataCallback,
  RingOta, Unbind, PushMessage, SetNotificationSwitch, GetNotificationSwitch, OnRealtimeData, OffRealtimeData, OnRealtimeMeasureComplete,
  OffRealtimeMeasureComplete, OnWorkoutRealtimeData, OffWorkoutRealtimeData, OnSyncProgress, OffSyncProgress, OnSyncResult, OffSyncResult, OnSyncFinish,
  OffSyncFinish, OnSyncError, OffSyncError, OnOtaProgress, OffOtaProgress, OnOtaFinish, OffOtaFinish, OnTouchEvent,
  OffTouchEvent, OnCallControl, OffCallControl, OnHealthAlert, OffHealthAlert, OnHeartRateCalibration, OffHeartRateCalibration, OnSensorRawData,
  OffSensorRawData, OnSensorRawStopped, OffSensorRawStopped
} from '../interface.uts'

const PLUGIN_VERSION = '0.0.1'
let initialized = false
let connected = false
let client: RingSdk | null = null
let scanSession: any | null = null
let scanStarting = false
let connecting = false
let lifecycleBound = false
let adapterStateListener: ((state: any) => void) | null = null
let currentDevice: BleDevice | null = null
let connectionUnsubscribe: (() => void) | null = null
let deviceEventUnsubscribe: (() => void) | null = null
let scanResultListener: ((device: BleDevice) => void) | null = null
let scanFinishListener: (() => void) | null = null
let connectStateListener: ((event: ConnectStateEvent) => void) | null = null
let functionMenuListener: ((menu: FunctionMenu) => void) | null = null
let realtimeDataListener: ((data: RealtimeData) => void) | null = null
let realtimeCompleteListener: (() => void) | null = null
let workoutRealtimeListener: ((data: WorkoutRealtimeData) => void) | null = null
let syncProgressListener: ((progress: number) => void) | null = null
let syncResultListener: ((result: SyncResult) => void) | null = null
let syncFinishListener: (() => void) | null = null
let syncErrorListener: ((error: UTSJSONObject) => void) | null = null
let otaProgressListener: ((progress: number) => void) | null = null
let otaFinishListener: ((result: OtaResult) => void) | null = null
let touchEventListener: ((event: TouchEvent) => void) | null = null
let healthAlertListener: ((event: HealthAlertEvent) => void) | null = null
let heartRateCalibrationListener: ((result: HeartRateCalibrationResult) => void) | null = null
let sensorRawListener: ((packet: SensorRawPacket) => void) | null = null
let sensorStoppedListener: ((event: SensorRawStoppedEvent) => void) | null = null

function succeed(successCallback?: () => void, completeCallback?: (result: any | null) => void): void {
  successCallback?.(); completeCallback?.(null)
}

function sdkError(value: any, message: string): RwfitFailImpl {
  const nativeCode = typeof value?.errCode === 'number' ? value.errCode : undefined
  const detail = `${value?.message ?? value?.errMsg ?? value ?? ''}`
  const lower = detail.toLowerCase()
  if (value?.state == 3 || lower.includes('auth') || lower.includes('permission') || lower.includes('authorize')) {
    return new RwfitFailImpl(9201003, `${message}: ${detail}`, nativeCode)
  }
  if (nativeCode == 10001 || nativeCode == 10009) {
    return new RwfitFailImpl(9201002, `${message}: ${detail}`, nativeCode)
  }
  if (lower.includes('timeout') || lower.includes('timed out')) {
    return new RwfitFailImpl(9201006, `${message}: ${detail}`, nativeCode)
  }
  if (lower.includes('not connected') || lower.includes('not ready') || lower.includes('disconnected')) {
    return new RwfitFailImpl(9201005, `${message}: ${detail}`, nativeCode)
  }
  return new RwfitFailImpl(9201099, `${message}: ${detail}`, nativeCode)
}

function failOptions(failCallback: ((error: RwfitFail) => void) | null, completeCallback: ((result: any | null) => void) | null, value: any, message: string): void {
  const error = sdkError(value, message); failCallback?.(error); completeCallback?.(error)
}

function authorizeBluetooth(successCallback: () => void, failCallback: (error: any) => void): void {
  wx.authorize({
    scope: 'scope.bluetooth',
    success: (result: any): void => {
      successCallback()
    },
    fail: (error: any): void => {
      failCallback(error)
    }
  })
}

function authorizeLocation(successCallback: () => void, failCallback: (error: any) => void): void {
  let hostLocationAuthorization = ''
  try { hostLocationAuthorization = wx.getAppAuthorizeSetting().locationAuthorized }
  catch (_error) {}
  if (hostLocationAuthorization == 'denied') {
    failCallback({
      errCode: -1,
      errMsg: 'WeChat location permission is denied in system settings; enable it and scan again'
    })
    return
  }
  wx.authorize({
    scope: 'scope.userLocation',
    success: (result: any): void => {
      successCallback()
    },
    fail: (error: any): void => {
      failCallback(error)
    }
  })
}

function isLocationPermissionError(error: any): boolean {
  const detail = `${error?.message ?? error?.errMsg ?? error ?? ''}`.toLowerCase()
  // Some WeChat versions return the misspelled text "locaiton permission".
  return (detail.includes('location') || detail.includes('locaiton')) &&
    (detail.includes('permission') || detail.includes('auth') || detail.includes('denied'))
}

function openBluetoothAdapter(options: VoidOptions): void {
  wx.openBluetoothAdapter({
    success: (result: any): void => {
      initialized = true; bindLifecycle(); succeed(options.success, options.complete)
    },
    fail: (error: any): void => {
      failOptions(options.fail, options.complete, error, 'Bluetooth adapter initialization failed')
    }
  })
}

function beginScan(options: VoidOptions, canRequestLocation: boolean): void {
  RingSdk.startScan({
    timeoutMs: 10000,
    onDevices: devices => devices.forEach(device => scanResultListener?.(fromScan(device)))
  }).then(session => {
    scanStarting = false
    scanSession = session
    session.finished.then(() => {
      if (scanSession == session) scanSession = null
      scanFinishListener?.()
    }).catch(error => console.error(`RWFIT scan finish: ${error}`))
    succeed(options.success, options.complete)
  }).catch(error => {
    if (canRequestLocation && isLocationPermissionError(error)) {
      authorizeLocation(
        (): void => beginScan(options, false),
        (authorizationError: any): void => {
          scanStarting = false
          failOptions(options.fail, options.complete, authorizationError, 'Location permission denied')
        }
      )
      return
    }
    scanStarting = false
    failOptions(options.fail, options.complete, error, 'scan failed')
  })
}

function ensureClient(options: any): boolean {
  if (!initialized) {
    const error = new RwfitFailImpl(9201001, null, null)
    options.fail?.(error); options.complete?.(error)
    return false
  }
  if (client != null) return true
  const error = new RwfitFailImpl(9201005, null, null)
  options.fail?.(error); options.complete?.(error)
  return false
}

function bindLifecycle(): void {
  if (lifecycleBound) return
  lifecycleBound = true
  if (typeof wx.onAppHide === 'function') {
    wx.onAppHide((): void => {
      if (scanSession != null) {
        const session = scanSession
        scanSession = null
        session.stop().catch((_error: any): void => {})
      }
    })
  }
  if (typeof wx.onBluetoothAdapterStateChange === 'function') {
    adapterStateListener = (state: any): void => {
      if (state?.available !== false) return
      if (scanSession != null) {
        const session = scanSession
        scanSession = null
        session.stop().catch((_error: any): void => {})
      }
      connectionUnsubscribe?.(); connectionUnsubscribe = null
      deviceEventUnsubscribe?.(); deviceEventUnsubscribe = null
      client?.dispose('Bluetooth adapter unavailable')
      client = null; connected = false; initialized = false
      emitState('disconnected', 'Bluetooth adapter unavailable')
    }
    wx.onBluetoothAdapterStateChange(adapterStateListener!)
  }
}

function resolveValue(options: any, value: any): void {
  options.success?.(value); options.complete?.(value)
}

function rejectValue(options: any, error: any, message: string): void {
  failOptions(options.fail, options.complete, error, message)
}

function invalidOptions(options: any, message: string): void {
  const error = new RwfitFailImpl(9201004, message, null)
  options.fail?.(error); options.complete?.(error)
}

function validSensorType(value: number): boolean {
  return value == 1 || value == 2 || value == 3 || value == 4 || value == 5 ||
    value == 10 || value == 11 || value == 12 || value == 13
}

const measurementCodes: UTSJSONObject = {
  hr: 3,
  bloodPressure: 4,
  bloodOxy: 9,
  hrv: 10,
  pressure: 13,
  bloodSugar: 16
}

const healthDataTypes: UTSJSONObject = {
  heartRate: 1,
  bloodOxygen: 3,
  bloodPressure: 4,
  stress: 8,
  bloodSugar: 9,
  muslimCount: 10,
  hrv: 13
}

function rawPacket(data: any): SensorRawPacket {
  return {
    type: data.type ?? 0,
    sequence: data.sequence,
    timestampSec: data.timestamp,
    ppg: data.ppgDataList ?? [],
    acc: (data.accDataList ?? []).map((item: any) => ({ x: item.x ?? 0, y: item.y ?? 0, z: item.z ?? 0 })),
    ppgRed: data.ppgRedDataList ?? [],
    ir: data.irDataList ?? [],
    sleep: (data.sleepDataList ?? []).map((item: any) => ({ timestampSec: Math.floor((item.timestamp ?? 0) / 1000), mode: item.sleepMode ?? 0 }))
  } as SensorRawPacket
}

function workoutReport(report: any): WorkoutReport {
  return {
    startTime: Math.floor((report.startTime ?? 0) / 1000),
    endTime: Math.floor((report.endTime ?? 0) / 1000),
    date: '',
    sportType: report.workModel ?? 0,
    duration: report.exerciseTime ?? 0,
    step: report.step ?? 0,
    distance: report.distance ?? 0,
    calorie: report.calorie ?? 0,
    height: 0,
    pressure: 0,
    cadence: report.cadence ?? 0,
    speed: report.speed ?? 0,
    pace: report.pace ?? 0,
    averageHeartRate: report.averageHeartRate ?? 0,
    maxHeartRate: report.maxHeartRate ?? 0,
    minHeartRate: report.minHeartRate ?? 0,
    maxCadence: report.maxCadence ?? 0,
    minCadence: report.minCadence ?? 0,
    maxPace: report.maxPace ?? 0,
    minPace: report.minPace ?? 0,
    heartRateCount: (report.heartRates ?? []).length,
    viewType: report.viewType ?? 0,
    heartRateItems: (report.heartRates ?? []).map((value: number, index: number) => ({ index, value })),
    pacePerKmItems: (report.pacePerKmList ?? []).map((value: number, index: number) => ({ index, value }))
  } as WorkoutReport
}

function handleDeviceEvent(event: any): void {
  if (event == null) return
  if (event.type === 'health' && (event.records ?? []).length > 0) {
    const record = event.records[event.records.length - 1]
    const rawValue = typeof record.value === 'number' ? record.value : Number(record.value ?? 0)
    realtimeDataListener?.({
      dataType: healthDataTypes[event.healthType] ?? 0,
      dataValue: Number.isFinite(rawValue) ? rawValue : 0,
      diastolic: record.detail?.diastolic,
      time: Math.floor((record.measuredAt ?? Date.now()) / 1000)
    } as RealtimeData)
    return
  }
  if (event.type === 'healthStatus' && event.completed === true) {
    realtimeCompleteListener?.(); return
  }
  if (event.type === 'healthAlert') {
    healthAlertListener?.({ type: event.alertType ?? -1, value: event.value ?? 0 } as HealthAlertEvent); return
  }
  if (event.type === 'camera') {
    touchEventListener?.({ action: 'cameraTakePicture', keyType: event.action ?? 0, touchType: 0 } as TouchEvent); return
  }
  if (event.type === 'touch') {
    const keyType = event.keyType ?? 0
    const touchType = event.touchType ?? 0
    const action = keyType === 2 ? 'fallDetected'
      : keyType !== 1 ? 'unknown'
      : touchType === 1 ? 'singleTap'
      : touchType === 2 ? 'doubleTap'
      : touchType === 3 ? 'tripleTap'
      : touchType === 4 ? 'longPress'
      : touchType === 5 ? 'swing' : 'unknown'
    touchEventListener?.({ action, keyType, touchType } as TouchEvent); return
  }
  if (event.type === 'workoutData') {
    workoutRealtimeListener?.({
      duration: event.data?.activityTime ?? 0,
      steps: event.data?.steps ?? 0,
      distance: event.data?.distance ?? 0,
      calorie: event.data?.calorie ?? 0,
      heartRate: event.data?.heartRate ?? 0,
      dataType: 0x0223
    } as WorkoutRealtimeData); return
  }
  if (event.type === 'sensorRaw') { sensorRawListener?.(rawPacket(event.data)); return }
  if (event.type === 'sensorStopped') { sensorStoppedListener?.({ reason: event.reason ?? 0 } as SensorRawStoppedEvent); return }
  if (event.type === 'factoryTest') {
    heartRateCalibrationListener?.({ testMode: event.testMode ?? 0, result: event.result ?? 0 } as HeartRateCalibrationResult)
  }
}

function fromScan(device: any): BleDevice {
  return {
    name: device.name ?? device.localName ?? '',
    mac: device.macAddress ?? '',
    rssi: device.RSSI ?? 0,
    uuid: device.deviceId,
    deviceId: device.deviceId
  } as BleDevice
}

function menuMap(menu: any): UTSJSONObject {
  return {
    isPushMsgEnableSwitch: menu.pushMsgEnableSwitch ?? false,
    pushMsgSwitchValue: menu.pushMsgSwitchValue ?? 0,
    pushMsgSwitchValue2: menu.pushMsgSwitchValue2 ?? 0,
    activityDataInterval: menu.activityDataInterval > 0 ? menu.activityDataInterval : 60,
    isAlarm: menu.alarm ?? false,
    isBrightScreenSleepTime: menu.brightScreenSleepTime ?? false,
    isBrightScreenTime: menu.brightScreenTime ?? false,
    isSupportWorkout: menu.newSport ?? menu.workout ?? false,
    isRememberSwitch: menu.rememberSwitch ?? false,
    isSupportHrReminder: menu.supportHrReminder ?? false,
    isSupportBoReminder: menu.supportBoReminder ?? false,
    isSupportMotoVibrationLevel: menu.supportMotoVibrationLevel ?? false,
    isSupportAlarmVibrationDuration: menu.supportAlarmVibrationDuration ?? false,
    isSupportVibrationInterval: menu.supportVibrationInterval ?? false,
    isStep: menu.step ?? false,
    isSleep: menu.sleep ?? false,
    isHr: menu.hr ?? false,
    isBloodOxy: menu.bloodOxy ?? false,
    isBloodPress: menu.bloodPress ?? false,
    isBloodSugar: menu.bloodSugar ?? false,
    isHrv: menu.hrv ?? false,
    isPressure: menu.pressure ?? false,
    isMuslimCountData: menu.muslimCountData ?? false,
    isBodyTemp: menu.temperature ?? false,
    isSupportMuslimTimeDisplayMode: menu.supportMuslimTimeDisplayMode ?? false,
    isSupportSensorRawPPG: menu.supportSensorRawPPG ?? false,
    isSupportPPGMonitoring: menu.supportPPGMonitoring ?? false,
    isSupportTemperatureMonitoring: menu.supportTemperatureMonitoring ?? false,
    isSupportCountReminder: menu.supportCountReminder ?? false,
    isSupportSensorRawACC: menu.supportSensorRawACC ?? false,
    isSupportSensorRawPPGRed: menu.supportSensorRawPPGRed ?? false,
    isSupportSensorRawIR: menu.supportSensorRawIR ?? false,
    isSupportSensorRawSleep: menu.supportSensorRawSleep ?? false,
    isSupportFallDetect: menu.supportFallDetect ?? false,
    isSupportRecording: menu.supportRecording ?? false,
    isFindDevice: menu.findDevice ?? false,
    isTakePhoto: menu.takePhoto ?? false,
    isLedLight: menu.ledLight ?? false,
    isWearDirection: menu.wearDir ?? false,
    isVideoHid: menu.videoHid ?? false,
    isVideoHidBook: menu.videoHidBook ?? false,
    isVideoHidMusic: menu.videoHidMusic ?? false,
    isRaiseBrightScreen: menu.raiseBrightScreen ?? false,
    isPowerOff: menu.powerOff ?? false,
    isFactoryReset: menu.recovery ?? false,
    isPushMessage: menu.msgNotification ?? false
  } as UTSJSONObject
}

function emitState(state: 'connecting' | 'connected' | 'disconnected' | 'failed', reason?: string): void {
  connectStateListener?.({
    state, name: currentDevice?.name, mac: currentDevice?.mac,
    uuid: currentDevice?.uuid, reason
  } as ConnectStateEvent)
}

function connectDevice(device: BleDevice, successCallback?: () => void, failCallback?: (error: RwfitFail) => void, completeCallback?: (result: any | null) => void): void {
  if (!initialized) {
    const error = new RwfitFailImpl(9201001, null, null)
    failCallback?.(error); completeCallback?.(error); return
  }
  if (connecting) {
    const error = new RwfitFailImpl(9201004, 'A connection attempt is already in progress', null)
    failCallback?.(error); completeCallback?.(error); return
  }
  const deviceId = device.deviceId ?? device.uuid
  if (deviceId == null || deviceId.length === 0) {
    const error = new RwfitFailImpl(9201004, 'deviceId/uuid is required on WeChat Mini Program', null)
    failCallback?.(error); completeCallback?.(error); return
  }
  connecting = true
  currentDevice = device
  emitState('connecting')
  const beginConnect = (): void => {
    RingSdk.connect(deviceId, {
      onStage: (stage: string) => {
        if (stage === 'connecting') emitState('connecting')
      }
    }).then((sdk: RingSdk) => {
      connecting = false
      connectionUnsubscribe?.()
      deviceEventUnsubscribe?.()
      client = sdk; connected = true
      connectionUnsubscribe = sdk.onConnectionStateChange(state => {
        connected = state.connected
        emitState(state.connected ? 'connected' : 'disconnected')
      })
      deviceEventUnsubscribe = sdk.onDeviceEvent(handleDeviceEvent)
      emitState('connected')
      const raw = menuMap(sdk.supportMenu ?? {})
      functionMenuListener?.({ name: device.name, mac: device.mac, uuid: device.uuid ?? deviceId, raw } as FunctionMenu)
      succeed(successCallback, completeCallback)
    }).catch(error => {
      connecting = false; connected = false; emitState('failed', error?.message ?? error?.errMsg ?? 'unknown')
      failOptions(failCallback, completeCallback, error, 'connect failed')
    })
  }
  if (client == null) { beginConnect(); return }
  const previous = client!
  connectionUnsubscribe?.(); connectionUnsubscribe = null
  deviceEventUnsubscribe?.(); deviceEventUnsubscribe = null
  client = null; connected = false
  previous.disconnect('replaced by a new connection').catch((_error: any): void => {
    previous.dispose('replaced by a new connection')
  }).then((): void => beginConnect())
}

export const initialize: Initialize = function(options: VoidOptions): void {
  if (initialized) { succeed(options.success, options.complete); return }
  authorizeBluetooth(
    (): void => openBluetoothAdapter(options),
    (error: any): void => failOptions(options.fail, options.complete, error, 'Bluetooth permission denied')
  )
}

export const getSdkVersion: GetSdkVersion = function(options: StringResultOptions): void {
  const result = getSDKVersion(); options.success?.(result); options.complete?.(result)
}

export const getPluginVersion: GetPluginVersion = function(options: StringResultOptions): void {
  const result = `${PLUGIN_VERSION}_${getSDKVersion()}`
  options.success?.(result); options.complete?.(result)
}

export const startScan: StartScan = function(options: VoidOptions): void {
  if (!initialized) {
    const error = new RwfitFailImpl(9201001, null, null); options.fail?.(error); options.complete?.(error); return
  }
  if (scanStarting || scanSession != null) {
    const error = new RwfitFailImpl(9201004, 'A scan is already in progress', null)
    options.fail?.(error); options.complete?.(error); return
  }
  scanStarting = true
  authorizeBluetooth(
    (): void => beginScan(options, true),
    (error: any): void => {
      scanStarting = false
      failOptions(options.fail, options.complete, error, 'Bluetooth permission denied')
    }
  )
}

export const stopScan: StopScan = function(options: VoidOptions): void {
  if (!initialized) {
    const error = new RwfitFailImpl(9201001, null, null); options.fail?.(error); options.complete?.(error); return
  }
  if (scanStarting) {
    const error = new RwfitFailImpl(9201004, 'Scan startup is still in progress', null)
    options.fail?.(error); options.complete?.(error); return
  }
  if (scanSession == null) { succeed(options.success, options.complete); return }
  scanSession.stop().then(() => {
    scanSession = null; succeed(options.success, options.complete)
  }).catch(error => failOptions(options.fail, options.complete, error, 'stopScan failed'))
}

export const connect: Connect = function(options): void { connectDevice(options.device, options.success, options.fail, options.complete) }

export const reconnect: Reconnect = function(options): void {
  if (!initialized) {
    const error = new RwfitFailImpl(9201001, null, null); options.fail?.(error); options.complete?.(error); return
  }
  if (options.device == null) {
    const error = new RwfitFailImpl(9201004, 'device is required on WeChat Mini Program', null)
    options.fail?.(error); options.complete?.(error); return
  }
  connectDevice(options.device!, options.success, options.fail, options.complete)
}

export const disconnect: Disconnect = function(options: VoidOptions): void {
  if (!initialized) {
    const error = new RwfitFailImpl(9201001, null, null); options.fail?.(error); options.complete?.(error); return
  }
  if (connecting) {
    const error = new RwfitFailImpl(9201004, 'Connection startup is still in progress', null)
    options.fail?.(error); options.complete?.(error); return
  }
  if (client == null) { connected = false; succeed(options.success, options.complete); return }
  client!.disconnect('app request').then(() => {
    connectionUnsubscribe?.(); connectionUnsubscribe = null
    deviceEventUnsubscribe?.(); deviceEventUnsubscribe = null
    client = null; connected = false; emitState('disconnected'); succeed(options.success, options.complete)
  }).catch(error => failOptions(options.fail, options.complete, error, 'disconnect failed'))
}

export const iosSetBindedStatus: IosSetBindedStatus = function(options): void {
  if (!initialized) {
    const error = new RwfitFailImpl(9201001, null, null); options.fail?.(error); options.complete?.(error); return
  }
  succeed(options.success, options.complete)
}

export const isConnected: IsConnected = function(options: BooleanResultOptions): void {
  options.success?.(connected); options.complete?.(connected)
}

export const getPower: GetPower = function(options: NumberResultOptions): void {
  if (!ensureClient(options)) return
  client!.readPower().then(info => {
    options.success?.(info.level); options.complete?.(info.level)
  }).catch(error => {
    const result = sdkError(error, 'getPower failed'); options.fail?.(result); options.complete?.(result)
  })
}

export const getFirmwareVersion: GetFirmwareVersion = function(options: FirmwareResultOptions): void {
  if (!ensureClient(options)) return
  client!.readFirmwareVersion().then(info => {
    const result = {
      deviceClazz: info?.deviceModel ?? '',
      deviceNo: info?.version ?? '',
      uiVersion: info?.uiVersion ?? ''
    } as FirmwareInfo
    options.success?.(result); options.complete?.(result)
  }).catch(error => {
    const result = sdkError(error, 'getFirmwareVersion failed'); options.fail?.(result); options.complete?.(result)
  })
}

export const setUserInfo: SetUserInfo = function(options): void {
  if (!ensureClient(options)) return
  client!.setUserProfile({ measureUnit: 0, ...options.info }).then(() => succeed(options.success, options.complete)).catch(error => failOptions(options.fail, options.complete, error, 'setUserInfo failed'))
}

export const setTimeFormat: SetTimeFormat = function(options): void {
  if (!ensureClient(options)) return
  client!.setHourSystem(options.format).then(() => succeed(options.success, options.complete)).catch(error => failOptions(options.fail, options.complete, error, 'setTimeFormat failed'))
}

export const getFunctionList: GetFunctionList = function(options: FunctionListResultOptions): void {
  if (!ensureClient(options)) return
  client!.readFunctionList().then(menu => {
    const result = { code: 0, msg: 'success', supportMenu: menuMap(menu ?? {}) } as FunctionListResult
    options.success?.(result); options.complete?.(result)
  }).catch(error => {
    const result = sdkError(error, 'getFunctionList failed'); options.fail?.(result); options.complete?.(result)
  })
}

export const setRingBtName: SetRingBtName = function(options): void {
  if (!ensureClient(options)) return
  client!.setRingName(options.name).then(() => succeed(options.success, options.complete)).catch(error => failOptions(options.fail, options.complete, error, 'setRingBtName failed'))
}

function timedConfig(info: any): TimedConfig {
  return {
    isOpen: info.enabled ?? false,
    duration: info.intervalMinutes ?? 60,
    startHour: info.startHour ?? 0,
    startMin: info.startMinute ?? 0,
    endHour: info.endHour ?? 23,
    endMin: info.endMinute ?? 59
  } as TimedConfig
}

function getTimed(type: string, options: any): void {
  if (!ensureClient(options)) return
  client!.getMonitoring(type).then((info: any) => resolveValue(options, timedConfig(info)))
    .catch(error => rejectValue(options, error, `get ${type} monitoring failed`))
}

function setTimed(type: string, options: SetTimedConfigOptions): void {
  if (!ensureClient(options)) return
  const config = options.config
  client!.setMonitoring(type, {
    enabled: config.isOpen,
    intervalMinutes: config.duration,
    startHour: config.startHour,
    startMinute: config.startMin,
    endHour: config.endHour,
    endMinute: config.endMin
  }).then(() => succeed(options.success, options.complete))
    .catch(error => rejectValue(options, error, `set ${type} monitoring failed`))
}

