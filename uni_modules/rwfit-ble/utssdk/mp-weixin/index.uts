export const getHeartRateAlert: GetHeartRateAlert = function(options: HeartRateAlertResultOptions): void {
  if (!ensureClient(options)) return
  client!.getHeartRateAlert().then((config: any) => resolveValue(options, {
    isOpen: config.enabled ?? false,
    highThreshold: config.upperValue ?? 160,
    lowThreshold: config.lowerValue == 0xff ? null : config.lowerValue
  } as HeartRateAlertConfig)).catch(error => rejectValue(options, error, 'getHeartRateAlert failed'))
}

export const setHeartRateAlert: SetHeartRateAlert = function(options: HeartRateAlertOptions): void {
  if (!ensureClient(options)) return
  const c = options.config as HeartRateAlertConfig
  if (c.highThreshold < 0 || c.highThreshold > 254 || (c.lowThreshold != null && (c.lowThreshold < 0 || c.lowThreshold > 254))) {
    invalidOptions(options, 'heart-rate thresholds must be 0..254'); return
  }
  client!.setHeartRateAlert(c.isOpen, c.highThreshold, c.lowThreshold ?? 0xff)
    .then(() => succeed(options.success, options.complete))
    .catch(error => rejectValue(options, error, 'setHeartRateAlert failed'))
}

