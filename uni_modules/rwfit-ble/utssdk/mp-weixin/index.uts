// WeChat SDK has no call-control event source. Event registration deliberately
// remains a safe no-op because the shared on* contract has no failure callback;
// the command-style controlPhone API reports 9201007 instead.
export const onCallControl: OnCallControl = function(_callback: (event: CallControlEvent) => void): void {}
export const offCallControl: OffCallControl = function(): void {}
