function getTimed(name: string, options: TimedConfigResultOptions): void {
  nativeInvoke(`getTimed:${name}`, {} as UTSJSONObject, (value: UTSJSONObject): void => { const result = timedValue(value); options.success?.(result); options.complete?.(result) }, options.fail, options.complete)
}
function setTimed(name: string, options: SetTimedConfigOptions): void { nativeVoid(`setTimed:${name}`, objectValue(options.config), options.success, options.fail, options.complete) }
export const getTimedHeartRate: GetTimedHeartRate = function(options: TimedConfigResultOptions): void { getTimed('heartRate', options) }
export const setTimedHeartRate: SetTimedHeartRate = function(options: SetTimedConfigOptions): void { setTimed('heartRate', options) }
