export const startRealtimeMeasure: StartRealtimeMeasure = function(options: RealtimeMeasureOptions): void { nativeVoid('startRealtimeMeasure', { metric: options.metric } as UTSJSONObject, options.success, options.fail, options.complete) }
export const stopRealtimeMeasure: StopRealtimeMeasure = function(options: RealtimeMeasureOptions): void { nativeVoid('stopRealtimeMeasure', { metric: options.metric } as UTSJSONObject, options.success, options.fail, options.complete) }
export const getWorkoutState: GetWorkoutState = function(options: WorkoutStateResultOptions): void { nativeInvoke('getWorkoutState', {} as UTSJSONObject, (value: UTSJSONObject): void => { const result = workoutStateValue(value); options.success?.(result); options.complete?.(result) }, options.fail, options.complete) }
export const controlWorkout: ControlWorkout = function(options: WorkoutControlOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  if (options.sportType < 7 || options.sportType > 161 || options.controlType < 1 || options.controlType > 4) { invalidOptions(options.fail, options.complete, 'sportType must be 7..161 and controlType must be 1..4'); return }
  nativeVoid('controlWorkout', { sportType: options.sportType, controlType: options.controlType } as UTSJSONObject, options.success, options.fail, options.complete)
}
export const setWorkoutRealtimeEnabled: SetWorkoutRealtimeEnabled = function(options: EnabledOptions): void { nativeVoid('setWorkoutRealtimeEnabled', { enabled: options.enabled } as UTSJSONObject, options.success, options.fail, options.complete) }
export const getWorkoutReports: GetWorkoutReports = function(options: WorkoutReportListResultOptions): void { nativeList('getWorkoutReports', {} as UTSJSONObject, (values: Array<UTSJSONObject>): void => { const result = workoutReportValues(values); options.success?.(result); options.complete?.(result) }, options.fail, options.complete) }
