export const getHeartRateAlert: GetHeartRateAlert = function(options: HeartRateAlertResultOptions): void { nativeInvoke('getHeartRateAlert', {} as UTSJSONObject, (value: UTSJSONObject): void => { const result = heartRateAlertValue(value); options.success?.(result); options.complete?.(result) }, options.fail, options.complete) }
export const setHeartRateAlert: SetHeartRateAlert = function(options: HeartRateAlertOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const low = options.config.lowThreshold
  if (options.config.highThreshold < 0 || options.config.highThreshold > 254 || (low != null && (low < 0 || low > 254))) { invalidOptions(options.fail, options.complete, 'heart-rate thresholds must be 0..254'); return }
  nativeVoid('setHeartRateAlert', objectValue(options.config), options.success, options.fail, options.complete)
}
export const getBloodOxygenAlert: GetBloodOxygenAlert = function(options: BloodOxygenAlertResultOptions): void { nativeInvoke('getBloodOxygenAlert', {} as UTSJSONObject, (value: UTSJSONObject): void => { const result = bloodOxygenAlertValue(value); options.success?.(result); options.complete?.(result) }, options.fail, options.complete) }
export const setBloodOxygenAlert: SetBloodOxygenAlert = function(options: BloodOxygenAlertOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  if (options.config.lowThreshold < 0 || options.config.lowThreshold > 254) { invalidOptions(options.fail, options.complete, 'blood-oxygen threshold must be 0..254'); return }
  nativeVoid('setBloodOxygenAlert', objectValue(options.config), options.success, options.fail, options.complete)
}
export const getVibrationInterval: GetVibrationInterval = function(options: NumberResultOptions): void { nativeNumber('getVibrationInterval', {} as UTSJSONObject, options.success, options.fail, options.complete) }
export const setVibrationInterval: SetVibrationInterval = function(options: SetVibrationIntervalOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  if (options.intervalMs < 100 || options.intervalMs > 1000) { invalidOptions(options.fail, options.complete, 'intervalMs must be 100..1000'); return }
  nativeVoid('setVibrationInterval', { intervalMs: options.intervalMs } as UTSJSONObject, options.success, options.fail, options.complete)
}
export const startHeartRateCalibration: StartHeartRateCalibration = function(options: VoidOptions): void { nativeVoid('startHeartRateCalibration', {} as UTSJSONObject, options.success, options.fail, options.complete) }
export const getFallDetect: GetFallDetect = function(options: BooleanResultOptions): void { nativeBoolean('getFallDetect', {} as UTSJSONObject, options.success, options.fail, options.complete) }
export const setFallDetect: SetFallDetect = function(options: EnabledOptions): void { nativeVoid('setFallDetect', { enabled: options.enabled } as UTSJSONObject, options.success, options.fail, options.complete) }
export const getCountReminderInterval: GetCountReminderInterval = function(options: NumberResultOptions): void { nativeNumber('getCountReminderInterval', {} as UTSJSONObject, options.success, options.fail, options.complete) }
export const setCountReminderInterval: SetCountReminderInterval = function(options: SetCountReminderIntervalOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const value = options.intervalMinutes
  if (value != 0 && value != 30 && value != 60 && value != 90 && value != 120) { invalidOptions(options.fail, options.complete, 'intervalMinutes must be 0, 30, 60, 90, or 120'); return }
  nativeVoid('setCountReminderInterval', { intervalMinutes: value } as UTSJSONObject, options.success, options.fail, options.complete)
}
export const controlSensorRaw: ControlSensorRaw = function(options: SensorRawControlOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  if (!validSensorType(options.sensorType)) { invalidOptions(options.fail, options.complete, 'unsupported sensorType combination'); return }
  nativeVoid('controlSensorRaw', { enabled: options.enabled, sensorType: options.sensorType } as UTSJSONObject, options.success, options.fail, options.complete)
}
