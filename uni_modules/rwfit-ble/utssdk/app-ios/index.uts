export const unbind: Unbind = function(options: VoidOptions): void {
  if (!requireInitialized(options.fail, options.complete)) return
  bridge.invoke('unbind', payloadJSON='{}', completion=(code: number, _json: string, message: string): void => {
    if (code == 0) succeed(options.success, options.complete)
    else fail(options.fail, options.complete, code, message)
  })
}
