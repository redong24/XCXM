  TimedConfig, TimedConfigResultOptions, SetTimedConfigOptions,
  RealtimeData, RealtimeMeasureOptions, WorkoutState, WorkoutStateResultOptions,
  WorkoutControlOptions, WorkoutRealtimeData, EnabledOptions, WorkoutReport, WorkoutValueItem,
