const PLUGIN_VERSION = '0.0.1'
const bridge = RwfitIosNativeBridge.shared
let initialized = false
let scanResultListener: ((device: BleDevice) => void) | null = null
let scanFinishListener: (() => void) | null = null
let connectStateListener: ((event: ConnectStateEvent) => void) | null = null
let functionMenuListener: ((menu: FunctionMenu) => void) | null = null
let realtimeDataListener: ((data: RealtimeData) => void) | null = null
let realtimeCompleteListener: (() => void) | null = null
let workoutRealtimeListener: ((data: WorkoutRealtimeData) => void) | null = null
let syncProgressListener: ((progress: number) => void) | null = null
let syncResultListener: ((result: SyncResult) => void) | null = null
let syncFinishListener: (() => void) | null = null
let syncErrorListener: ((error: UTSJSONObject) => void) | null = null
let otaProgressListener: ((progress: number) => void) | null = null
let otaFinishListener: ((result: OtaResult) => void) | null = null
let touchEventListener: ((event: TouchEvent) => void) | null = null
let callControlListener: ((event: CallControlEvent) => void) | null = null
let healthAlertListener: ((event: HealthAlertEvent) => void) | null = null
let heartRateCalibrationListener: ((result: HeartRateCalibrationResult) => void) | null = null
let sensorRawListener: ((packet: SensorRawPacket) => void) | null = null
let sensorStoppedListener: ((event: SensorRawStoppedEvent) => void) | null = null

function succeed(successCallback?: () => void, completeCallback?: (result: any | null) => void): void {
  successCallback?.(); completeCallback?.(null)
}

function nativeFailure(code: number, message: string): RwfitFailImpl {
  const lower = message.toLowerCase()
  if (code == -7) return new RwfitFailImpl(9201007, message, code)
  if (lower.includes('timeout') || lower.includes('timed out')) return new RwfitFailImpl(9201006, message, code)
  if (lower.includes('powered off') || lower.includes('bluetooth unavailable')) return new RwfitFailImpl(9201002, message, code)
  if (lower.includes('not connected') || lower.includes('not ready')) return new RwfitFailImpl(9201005, message, code)
  return new RwfitFailImpl(9201099, message, code)
}

function fail(failCallback: ((error: RwfitFail) => void) | null, completeCallback: ((result: any | null) => void) | null, code: number, message: string): void {
  const error = nativeFailure(code, message)
  failCallback?.(error); completeCallback?.(error)
}

function invalidOptions(failCallback: ((error: RwfitFail) => void) | null, completeCallback: ((result: any | null) => void) | null, message: string): void {
  const error = new RwfitFailImpl(9201004, message, null)
  failCallback?.(error); completeCallback?.(error)
}

function requireInitialized(failCallback: ((error: RwfitFail) => void) | null,
  completeCallback: ((result: any | null) => void) | null): boolean {
  if (initialized) return true
  const error = new RwfitFailImpl(9201001, null, null)
  failCallback?.(error); completeCallback?.(error)
  return false
}

function requireReady(failCallback: ((error: RwfitFail) => void) | null,
  completeCallback: ((result: any | null) => void) | null): boolean {
  if (!requireInitialized(failCallback, completeCallback)) return false
  if (bridge.isReady()) return true
  const error = new RwfitFailImpl(9201005, null, null)
  failCallback?.(error); completeCallback?.(error)
  return false
}

function validSensorType(value: number): boolean {
  return value == 1 || value == 2 || value == 3 || value == 4 || value == 5 ||
    value == 10 || value == 11 || value == 12 || value == 13
}

function parseObject(json: string): UTSJSONObject {
  try { return JSON.parse(json) as UTSJSONObject }
  catch (_error) { return {} as UTSJSONObject }
}

function nativeInvoke(method: string, payload: UTSJSONObject, onSuccess: (value: UTSJSONObject) => void,
  failCallback: ((error: RwfitFail) => void) | null, completeCallback: ((result: any | null) => void) | null): void {
  if (!requireReady(failCallback, completeCallback)) return
  bridge.invoke(method, payloadJSON=JSON.stringify(payload) ?? "{}", completion=(code: number, json: string, message: string): void => {
    if (code == 0) onSuccess(parseObject(json))
    else fail(failCallback, completeCallback, code, message)
  })
}

function nativeVoid(method: string, payload: UTSJSONObject, successCallback: (() => void) | null,
  failCallback: ((error: RwfitFail) => void) | null, completeCallback: ((result: any | null) => void) | null): void {
  nativeInvoke(method, payload, (_value: UTSJSONObject): void => { succeed(successCallback, completeCallback) }, failCallback, completeCallback)
}

function nativeNumber(method: string, payload: UTSJSONObject, successCallback: ((value: number) => void) | null,
  failCallback: ((error: RwfitFail) => void) | null, completeCallback: ((result: any | null) => void) | null): void {
  if (!requireReady(failCallback, completeCallback)) return
  bridge.invoke(method, payloadJSON=JSON.stringify(payload) ?? "{}", completion=(code: number, json: string, message: string): void => {
    if (code == 0) { const value = JSON.parse(json) as number; successCallback?.(value); completeCallback?.(value) }
    else fail(failCallback, completeCallback, code, message)
  })
}

function nativeBoolean(method: string, payload: UTSJSONObject, successCallback: ((value: boolean) => void) | null,
  failCallback: ((error: RwfitFail) => void) | null, completeCallback: ((result: any | null) => void) | null): void {
  if (!requireReady(failCallback, completeCallback)) return
  bridge.invoke(method, payloadJSON=JSON.stringify(payload) ?? "{}", completion=(code: number, json: string, message: string): void => {
    if (code == 0) { const value = JSON.parse(json) as boolean; successCallback?.(value); completeCallback?.(value) }
    else fail(failCallback, completeCallback, code, message)
  })
}

function nativeList(method: string, payload: UTSJSONObject, onSuccess: (value: Array<UTSJSONObject>) => void,
  failCallback: ((error: RwfitFail) => void) | null, completeCallback: ((result: any | null) => void) | null): void {
  if (!requireReady(failCallback, completeCallback)) return
  bridge.invoke(method, payloadJSON=JSON.stringify(payload) ?? "{}", completion=(code: number, json: string, message: string): void => {
    if (code == 0) onSuccess(JSON.parse(json) as Array<UTSJSONObject>)
    else fail(failCallback, completeCallback, code, message)
  })
}

function objectValue(value: any): UTSJSONObject { return JSON.parse(JSON.stringify(value) ?? "{}") as UTSJSONObject }

function eventNumber(value: any): number { return (value ?? 0) as number }
function eventString(value: any): string {
  if (value == null) return ''
  // JSON round-trip unwraps Swift Optional values exposed by UTSJSONObject.
  // Do not cast the raw Any directly: iOS would generate `as! String`.
  return JSON.parse(JSON.stringify(value) ?? '""') as string
}
function eventBoolean(value: any): boolean { return (value ?? false) as boolean }

function connectStateValue(value: string): ConnectState {
  if (value == 'connecting') return 'connecting'
  if (value == 'connected') return 'connected'
  if (value == 'disconnected') return 'disconnected'
  return 'failed'
}

function eventNumbers(value: any): Array<number> {
  const result: Array<number> = []
  const values = (value ?? []) as Array<any>
  values.forEach((item: any): void => { result.push(eventNumber(item)) })
  return result
}

function eventObjects(value: any): Array<UTSJSONObject> {
  const result: Array<UTSJSONObject> = []
  const values = (value ?? []) as Array<any>
  values.forEach((item: any): void => { result.push(objectValue(item)) })
  return result
}

function eventAcc(value: any): Array<AccRawSample> {
  const result: Array<AccRawSample> = []
  eventObjects(value).forEach((item: UTSJSONObject): void => {
    result.push({ x: eventNumber(item['x']), y: eventNumber(item['y']), z: eventNumber(item['z']) } as AccRawSample)
  })
  return result
}

function eventSleep(value: any): Array<SleepRawSample> {
  const result: Array<SleepRawSample> = []
  eventObjects(value).forEach((item: UTSJSONObject): void => {
    result.push({ timestampSec: eventNumber(item['timestampSec']), mode: eventNumber(item['mode']) } as SleepRawSample)
  })
  return result
}

function eventRealtime(value: UTSJSONObject): RealtimeData {
  const result = {
    dataType: eventNumber(value['dataType']),
    dataValue: eventNumber(value['dataValue']),
    time: eventNumber(value['time'])
  } as RealtimeData
  if (value['diastolic'] != null) result.diastolic = eventNumber(value['diastolic'])
  return result
}

function eventOtaResult(value: UTSJSONObject): OtaResult {
  const result = { success: value['success'] == true } as OtaResult
  if (value['code'] != null) result.code = eventNumber(value['code'])
  return result
}

function eventSensorPacket(value: UTSJSONObject): SensorRawPacket {
  const result = {
    type: eventNumber(value['type']),
    ppg: eventNumbers(value['ppg']),
    acc: eventAcc(value['acc']),
    ppgRed: eventNumbers(value['ppgRed']),
    ir: eventNumbers(value['ir']),
    sleep: eventSleep(value['sleep'])
  } as SensorRawPacket
  if (value['sequence'] != null) result.sequence = eventNumber(value['sequence'])
  if (value['timestampSec'] != null) result.timestampSec = eventNumber(value['timestampSec'])
  return result
}

function timedValue(value: UTSJSONObject): TimedConfig {
  return {
    isOpen: eventBoolean(value['isOpen']),
    duration: eventNumber(value['duration']),
    startHour: eventNumber(value['startHour']),
    startMin: eventNumber(value['startMin']),
    endHour: eventNumber(value['endHour']),
    endMin: eventNumber(value['endMin'])
  } as TimedConfig
}

function workoutStateValue(value: UTSJSONObject): WorkoutState {
  return {
    sportType: eventNumber(value['sportType']),
    controlType: eventNumber(value['controlType'])
  } as WorkoutState
}

function workoutItems(value: any): Array<WorkoutValueItem> {
  const result: Array<WorkoutValueItem> = []
  eventObjects(value).forEach((item: UTSJSONObject): void => {
    result.push({ index: eventNumber(item['index']), value: eventNumber(item['value']) } as WorkoutValueItem)
  })
  return result
}

function workoutReportValue(value: UTSJSONObject): WorkoutReport {
  return {
    startTime: eventNumber(value['startTime']),
    endTime: eventNumber(value['endTime']),
    date: eventString(value['date']),
    sportType: eventNumber(value['sportType']),
    duration: eventNumber(value['duration']),
    step: eventNumber(value['step']),
    distance: eventNumber(value['distance']),
    calorie: eventNumber(value['calorie']),
    height: eventNumber(value['height']),
    pressure: eventNumber(value['pressure']),
    cadence: eventNumber(value['cadence']),
    speed: eventNumber(value['speed']),
    pace: eventNumber(value['pace']),
    averageHeartRate: eventNumber(value['averageHeartRate']),
    maxHeartRate: eventNumber(value['maxHeartRate']),
    minHeartRate: eventNumber(value['minHeartRate']),
    maxCadence: eventNumber(value['maxCadence']),
    minCadence: eventNumber(value['minCadence']),
    maxPace: eventNumber(value['maxPace']),
    minPace: eventNumber(value['minPace']),
    heartRateCount: eventNumber(value['heartRateCount']),
    viewType: eventNumber(value['viewType']),
    heartRateItems: workoutItems(value['heartRateItems']),
    pacePerKmItems: workoutItems(value['pacePerKmItems'])
  } as WorkoutReport
}

function workoutReportValues(values: Array<UTSJSONObject>): Array<WorkoutReport> {
  const result: Array<WorkoutReport> = []
  values.forEach((value: UTSJSONObject): void => { result.push(workoutReportValue(value)) })
  return result
}

function heartRateAlertValue(value: UTSJSONObject): HeartRateAlertConfig {
  const result = {
    isOpen: eventBoolean(value['isOpen']),
    highThreshold: eventNumber(value['highThreshold'])
  } as HeartRateAlertConfig
  if (value['lowThreshold'] != null) result.lowThreshold = eventNumber(value['lowThreshold'])
  return result
}

function bloodOxygenAlertValue(value: UTSJSONObject): BloodOxygenAlertConfig {
  return {
    isOpen: eventBoolean(value['isOpen']),
    lowThreshold: eventNumber(value['lowThreshold'])
  } as BloodOxygenAlertConfig
}

function sensorPacketValues(values: Array<UTSJSONObject>): Array<SensorRawPacket> {
  const result: Array<SensorRawPacket> = []
  values.forEach((value: UTSJSONObject): void => { result.push(eventSensorPacket(value)) })
  return result
}

function alarmValue(value: UTSJSONObject): Alarm {
  return {
    alarmId: eventNumber(value['alarmId']),
    startHour: eventNumber(value['startHour']),
    startMin: eventNumber(value['startMin']),
    isOpen: eventBoolean(value['isOpen']),
    repeats: eventNumbers(value['repeats'])
  } as Alarm
}

function alarmValues(values: Array<UTSJSONObject>): Array<Alarm> {
  const result: Array<Alarm> = []
  values.forEach((value: UTSJSONObject): void => { result.push(alarmValue(value)) })
  return result
}

function scheduleValue(value: UTSJSONObject): ScheduleToggle {
  return {
    isOpen: eventBoolean(value['isOpen']),
    startHour: eventNumber(value['startHour']),
    startMin: eventNumber(value['startMin']),
    endHour: eventNumber(value['endHour']),
    endMin: eventNumber(value['endMin'])
  } as ScheduleToggle
}

function ledValue(value: UTSJSONObject): LedLevel {
  return { isOpen: eventBoolean(value['isOpen']), lcdLevel: eventNumber(value['lcdLevel']) } as LedLevel
}

function vibrationValue(value: UTSJSONObject): VibrationConfig {
  return { count: eventNumber(value['count']), level: eventNumber(value['level']) } as VibrationConfig
}

function bindNativeEvents(): void {
  bridge.setScanResultListener((name: string, mac: string, rssi: number, uuid: string): void => {
    scanResultListener?.({ name, mac, rssi, uuid } as BleDevice)
  })
  bridge.setScanFinishListener((): void => { scanFinishListener?.() })
  bridge.setConnectStateListener((state: string, name: string, mac: string, uuid: string, reason: string): void => {
    console.log(`[RWFIT][iOS][callback][uts] connectState state=${state} uuid=${uuid} reason=${reason}`)
    connectStateListener?.({
      state: connectStateValue(state),
      name, mac, uuid, reason
    } as ConnectStateEvent)
  })
  bridge.setFunctionMenuListener((name: string, mac: string, uuid: string, json: string): void => {
    console.log(`[RWFIT][iOS][callback][uts] functionMenu uuid=${uuid}`)
    functionMenuListener?.({ name, mac, uuid, raw: parseObject(json) } as FunctionMenu)
  })
  // Health sync uses a dedicated typed callback instead of the generic JSON
  // event dictionary. This avoids iOS UTS generating unsafe Any -> String
  // casts for the result type.
  bridge.setHealthSyncResultListener((type: string, json: string): void => {
    const data = JSON.parse(json) as Array<UTSJSONObject>
    syncResultListener?.({ type, data } as SyncResult)
  })
  bridge.setEventListener((name: string, json: string): void => {
    const value = parseObject(json)
    switch (name) {
      case 'realtimeData': realtimeDataListener?.(eventRealtime(value)); break
      case 'realtimeMeasureComplete': realtimeCompleteListener?.(); break
      case 'workoutRealtimeData': workoutRealtimeListener?.({
        duration: eventNumber(value['duration']),
        steps: eventNumber(value['steps']),
        distance: eventNumber(value['distance']),
        calorie: eventNumber(value['calorie']),
        heartRate: eventNumber(value['heartRate']),
        dataType: eventNumber(value['dataType'])
      } as WorkoutRealtimeData); break
      case 'syncProgress': syncProgressListener?.((value['progress'] ?? 0) as number); break
      case 'syncFinish': syncFinishListener?.(); break
      case 'syncError': syncErrorListener?.(value); break
      case 'otaProgress': otaProgressListener?.((value['progress'] ?? 0) as number); break
      case 'otaFinish': otaFinishListener?.(eventOtaResult(value)); break
      case 'touchEvent': touchEventListener?.({
        action: eventString(value['action']),
        keyType: eventNumber(value['keyType']),
        touchType: eventNumber(value['touchType'])
      } as TouchEvent); break
      case 'callControl': callControlListener?.({
        action: eventString(value['action']), rawValue: eventNumber(value['rawValue'])
      } as CallControlEvent); break
      case 'healthAlert': healthAlertListener?.({
        type: eventNumber(value['type']), value: eventNumber(value['value'])
      } as HealthAlertEvent); break
      case 'heartRateCalibration': heartRateCalibrationListener?.({
        testMode: eventNumber(value['testMode']), result: eventNumber(value['result'])
      } as HeartRateCalibrationResult); break
      case 'sensorRawData': sensorRawListener?.(eventSensorPacket(value)); break
      case 'sensorRawStopped': sensorStoppedListener?.({
        reason: eventNumber(value['reason'])
      } as SensorRawStoppedEvent); break
    }
  })
}

export const initialize: Initialize = function(options: VoidOptions): void {
  // Register both bridge listeners before native SDK initialization. The iOS
  // SDK may auto-reconnect synchronously when a bound UUID already exists.
  console.log('[RWFIT][iOS][callback][uts] initialize begin')
  bindNativeEvents(); bridge.initializeSDK()
  console.log('[RWFIT][iOS][callback][uts] initialize native ready')
  const authorization = bridge.bluetoothAuthorizationStatus().toInt()
  if (authorization == 1 || authorization == 2) {
    const error = new RwfitFailImpl(9201003, null, null)
    options.fail?.(error); options.complete?.(error); return
  }
  initialized = true; succeed(options.success, options.complete)
}

export const getSdkVersion: GetSdkVersion = function(options: StringResultOptions): void {
  const result = bridge.sdkVersion(); options.success?.(result); options.complete?.(result)
}

export const getPluginVersion: GetPluginVersion = function(options: StringResultOptions): void {
  const result = `${PLUGIN_VERSION}_${bridge.sdkVersion()}`
  options.success?.(result); options.complete?.(result)
}

export const startScan: StartScan = function(options: VoidOptions): void {
  if (!initialized) { const error = new RwfitFailImpl(9201001, null, null); options.fail?.(error); options.complete?.(error); return }
  const authorization = bridge.bluetoothAuthorizationStatus().toInt()
  if (authorization == 1 || authorization == 2) {
    const error = new RwfitFailImpl(9201003, null, null)
    options.fail?.(error); options.complete?.(error); return
  }
  bridge.startScan(); succeed(options.success, options.complete)
}

export const stopScan: StopScan = function(options: VoidOptions): void {
  if (!requireInitialized(options.fail, options.complete)) return
  bridge.stopScan(); succeed(options.success, options.complete)
}

export const connect: Connect = function(options): void {
  if (!requireInitialized(options.fail, options.complete)) return
  const device = options.device!
  bridge.connect(
    name=device.name,
    mac=device.mac,
    rssi=device.rssi,
    uuid=device.uuid ?? '',
    completion=(code: number, message: string): void => {
      if (code == 0) succeed(options.success, options.complete); else fail(options.fail, options.complete, code, message)
    }
  )
}

export const reconnect: Reconnect = function(options): void {
  if (!requireInitialized(options.fail, options.complete)) return
  bridge.reconnect(); succeed(options.success, options.complete)
}

export const disconnect: Disconnect = function(options: VoidOptions): void {
  if (!requireInitialized(options.fail, options.complete)) return
  bridge.disconnect(); succeed(options.success, options.complete)
}

export const iosSetBindedStatus: IosSetBindedStatus = function(options): void {
  if (!requireInitialized(options.fail, options.complete)) return
  bridge.setBinded(options.isBinded); succeed(options.success, options.complete)
}

export const isConnected: IsConnected = function(options: BooleanResultOptions): void {
  const result = bridge.isConnected(); options.success?.(result); options.complete?.(result)
}

export const getPower: GetPower = function(options: NumberResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  bridge.getPower((code: number, power: number, message: string): void => {
    if (code == 0) { options.success?.(power); options.complete?.(power) }
    else { const error = nativeFailure(code, message); options.fail?.(error); options.complete?.(error) }
  })
}

export const getFirmwareVersion: GetFirmwareVersion = function(options: FirmwareResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  bridge.getFirmware((code: number, deviceClazz: string, deviceNo: string, uiVersion: string, message: string): void => {
    if (code == 0) {
      const result = { deviceClazz, deviceNo, uiVersion } as FirmwareInfo
      options.success?.(result); options.complete?.(result)
    } else {
      const error = nativeFailure(code, message); options.fail?.(error); options.complete?.(error)
    }
  })
}

export const setUserInfo: SetUserInfo = function(options): void {
  if (!requireReady(options.fail, options.complete)) return
  const info = options.info!
  bridge.setUserInfo(
    gender=info.gender, age=info.age, height=info.height, weight=info.weight,
    completion=(code: number, message: string): void => {
      if (code == 0) succeed(options.success, options.complete); else fail(options.fail, options.complete, code, message)
    }
  )
}

export const setTimeFormat: SetTimeFormat = function(options): void {
  if (!requireReady(options.fail, options.complete)) return
  bridge.setTimeFormat(options.format!, completion=(code: number, message: string): void => {
    if (code == 0) succeed(options.success, options.complete); else fail(options.fail, options.complete, code, message)
  })
}

export const getFunctionList: GetFunctionList = function(options: FunctionListResultOptions): void {
  if (!requireReady(options.fail, options.complete)) return
  const result = {
    code: 0, msg: 'success', supportMenu: parseObject(bridge.getFunctionMenuJSON())
  } as FunctionListResult
  options.success?.(result); options.complete?.(result)
}

export const setRingBtName: SetRingBtName = function(options): void {
  if (!requireReady(options.fail, options.complete)) return
  bridge.setRingName(options.name!, completion=(code: number, message: string): void => {
    if (code == 0) succeed(options.success, options.complete); else fail(options.fail, options.complete, code, message)
  })
}

export const onScanResult: OnScanResult = function(callback: (device: BleDevice) => void): void { scanResultListener = callback }
export const offScanResult: OffScanResult = function(): void { scanResultListener = null }
export const onScanFinish: OnScanFinish = function(callback: () => void): void { scanFinishListener = callback }
export const offScanFinish: OffScanFinish = function(): void { scanFinishListener = null }
export const onConnectState: OnConnectState = function(callback: (event: ConnectStateEvent) => void): void { connectStateListener = callback }
