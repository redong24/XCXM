<template>
  <!-- 根节点必须是 scroll-view，不能是 view：
       官方明确「VDOM模式中，App平台的页面默认不可滚动，需要开发者在页面中
       显示使用scroll-view」（doc.dcloud.net.cn/uni-app-x/page.html）。
       用 view 的后果是超出首屏的内容用户永远触达不到，且不报任何错。 -->
  <scroll-view class="device-page" :scroll-y="true">
    <!-- 当前设备状态 -->
    <view class="current-device card">
      <text class="card-title">当前设备</text>
      <template v-if="deviceState.currentDevice != null">
        <view class="device-row">
          <view>
            <text class="device-name">RWFit 智能戒指</text>
            <text class="device-mac">{{ deviceState.currentDevice?.mac }}</text>
          </view>
          <view class="status-badge" :class="deviceState.connected ? 'online' : 'offline'">
            <text>{{ deviceState.connected ? '已连接' : '未连接' }}</text>
          </view>
        </view>
        <button class="unbind-btn" @click="onUnbind">解绑设备</button>
      </template>
      <template v-else>
        <view class="empty">
          <text class="empty-text">尚未绑定设备</text>
        </view>
      </template>
    </view>

    <!-- 扫描连接 -->
    <view class="scan-area card">
      <text class="card-title">扫描附近设备</text>
      <button class="scan-btn" :loading="deviceState.scanning" @click="onScan">
        {{ deviceState.scanning ? '扫描中...' : '开始扫描' }}
      </button>

      <view v-if="deviceState.nearbyDevices.length > 0" class="device-list">
        <view
          v-for="(d, idx) in deviceState.nearbyDevices"
          :key="idx"
          class="device-item"
        >
          <view>
            <text class="device-name">{{ d.name }}</text>
            <text class="device-mac">{{ d.mac }}（信号 {{ d.rssi }}）</text>
          </view>
          <button class="connect-btn" @click="onConnect(d)">连接</button>
        </view>
      </view>
      <view v-else class="empty">
        <text class="empty-text">点击「开始扫描」搜索附近的戒指设备</text>
      </view>
    </view>
    <!-- 滚动到底部时的收尾留白，避免最后一行内容贴住屏幕边缘 -->
    <view class="tail"></view>
  </scroll-view>
</template>

<script setup lang="uts">
// 注意：uni-app x 会自动引入 vue 公开 API（ref/onMounted 等），无需 import
import { deviceState, setCurrentDevice, setScanning, setNearbyDevices, restore as restoreDevice } from '../../store/device.uts'
import { userId } from '../../store/user.uts'
import { deviceApi, type DeviceInfo } from '../../api/index.uts'
import { takeApiErrorText, clearApiError } from '../../common/request.uts'
import {
  initSDK,
  destroySDK,
  startScan,
  stopScan,
  connect,
  type BleDevice
} from '../../utils/rwble.uts'

const connectingMac = ref('')

// 扫描不再是 Promise：官方 rwfit-ble 的 startScan 只负责「开始扫描」，
// 设备是通过独立的 onScanResult 事件陆续到达的，没有一个「扫描完成」的
// 时刻可以 await。原来的 await + try/finally 会在第一个设备到达前就
// 走到 finally，语义是错的。改为「开始扫描 + 固定 5s 后收摊」。
function onScan() {
  setScanning(true)
  setNearbyDevices([] as BleDevice[])

  startScan(
    (device: BleDevice) => {
      // 空 mac 的条目在适配层已丢弃，这里再兜一层：
      // 若 mac 为空，some() 会把多个空 mac 判为同一设备而静默合并。
      if (device.mac === '') {
        return
      }
      const list = deviceState.nearbyDevices.slice()
      if (!list.some((d) => d.mac === device.mac)) {
        list.push(device)
        setNearbyDevices(list)
      }
    },
    (errMsg: string) => {
      setScanning(false)
      uni.showToast({ title: errMsg != '' ? errMsg : '扫描失败', icon: 'none' })
    }
  )

  // 扫描窗口 5s -> 15s。
  // 原因：BLE 广播间隔由固件决定，部分戒指为省电用较长间隔（可达数秒），
  // 5 秒窗口有可能整窗错过，表现为「设备明明在旁边却扫不到」。
  // 15 秒是权衡：足以覆盖常见广播间隔，又不至于让用户等太久。
  setTimeout(() => {
    setScanning(false)
    stopScan()
  }, 15000)
}

// 向后端解析设备的真实 id（按 MAC 在「我的设备」中匹配）
//
// 背景（重要，勿回退）：此前蓝牙连上后本地直接存 id=0「临时 id」，
// 但代码里从未有任何一步去后端换取真实 id，导致上报心率/血氧时
// device_id=0，后端返回 404「设备不存在」，且错误被 catch 吞掉，
// 表现为「采集成功但预警永远不触发」的静默失败。
//
// 权限说明：后端 POST /api/devices/（创建设备）仅 admin 可用，
// 故移动端不能自助登记，只能绑定已登记到自己名下的设备。
async function resolveDeviceId(mac: string): Promise<DeviceInfo | null> {
  clearApiError()
  try {
    const list = await deviceApi.mine()
    const target = mac.toUpperCase()
    for (let i = 0; i < list.length; i++) {
      const d = list[i]
      if (d.mac.toUpperCase() === target) {
        return d
      }
    }
    return null
  } catch (e) {
    return null
  }
}

// 蓝牙连接成功后的处理（前置 async 函数；UTS 无声明提升，须先定义后使用）
async function onConnected(mac: string): Promise<boolean> {
  const bound = await resolveDeviceId(mac)
  if (bound == null) {
    // 后端查不到该 MAC 的绑定记录：仍记录本地连接态（MAC 可见），
    // 但必须明确告知用户，避免其以为「已连上就能上传数据」
    setCurrentDevice({
      id: 0,
      mac: mac,
      firmware: null,
      bind_user_id: userId(),
      status: 1,
      created_at: ''
    } as DeviceInfo)
    const reason = takeApiErrorText('')
    uni.showModal({
      title: '设备未登记',
      content:
        reason != ''
          ? `蓝牙已连接，但该戒指尚未登记到当前账号。\n\n后端提示：${reason}\n\n请联系管理员在后台登记设备 MAC：${mac}`
          : `蓝牙已连接，但该戒指尚未登记到当前账号，上报数据会失败。\n\n请联系管理员在后台登记设备 MAC：${mac}`,
      showCancel: false
    })
    return false
  }

  setCurrentDevice(bound)
  uni.showToast({ title: '设备已连接', icon: 'success' })
  return true
}

function onConnect(device: BleDevice) {
  connectingMac.value = device.mac
  // 传整个 device 而不是 device.mac：适配层要求原样回传扫描结果，
  // 否则 iOS 端缺少 uuid 会连不上（详见 utils/rwble.uts 的 connect 注释）。
  connect(device, (status) => {
    // 状态取值必须与适配层/SDK 对齐，否则会静默失效。
    // 这里原来判断的是 'error' / 'timeout'，而适配层从不发出这两个值。
    // 官方 ConnectState 是 'connecting'|'connected'|'disconnected'|'failed'，
    // 结果是连接失败时用户什么提示都看不到，只能干等。
    //
    // 另外「connected」并不等于「可用」：真实链路要等戒指上报功能菜单
    // （onFunctionMenu）才算就绪，适配层把它抽象成额外的 'ready' 状态。
    // 绑定动作放在 ready，避免在设备还没准备好时就去调业务接口。
    if (status === 'ready') {
      // 注意：connect 的回调要求返回 Unit，不能传 async 函数（error17），
      // 故用非 async 回调包裹，内部调用前置的 async 处理函数
      onConnected(device.mac)
    } else if (status === 'failed' || status === 'disconnected') {
      connectingMac.value = ''
      uni.showToast({ title: '连接失败', icon: 'none' })
    }
  })
}

async function onUnbind() {
  // 注意：reactive 对象是 getter 访问，Kotlin 无法智能转换为非空，
  // 必须先提取到局部 val，否则后续 .id 会报 "nullable receiver"
  const dev = deviceState.currentDevice
  if (dev == null || dev.id === 0) {
    setCurrentDevice(null)
    uni.showToast({ title: '已解绑', icon: 'success' })
    return
  }
  clearApiError()
  try {
    await deviceApi.unbind(dev.id)
    setCurrentDevice(null)
    uni.showToast({ title: '已解绑', icon: 'success' })
  } catch (e) {
    const msg = takeApiErrorText('')
    uni.showToast({ title: msg != '' ? msg : '解绑失败', icon: 'none' })
  }
}

onMounted(() => {
  restoreDevice()
  // 初始化失败在这一页要明确告知：这页的全部功能都依赖蓝牙，
  // 静默失败会让用户对着一个永远扫不出设备的页面反复点击。
  initSDK((ok: boolean, errMsg: string) => {
    if (!ok) {
      uni.showToast({
        title: errMsg != '' ? errMsg : '蓝牙初始化失败',
        icon: 'none'
      })
    }
  })
})

onUnmounted(() => {
  destroySDK()
})
</script>

<style scoped>
.device-page {
  padding: 32rpx;
  background: #f5f7fa;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.device-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.device-name {
  font-size: 30rpx;
  color: #1f2937;
}

.device-mac {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-badge.online {
  background: #d1fae5;
  color: #065f46;
}

.status-badge.offline {
  background: #fef3c7;
  color: #92400e;
}

.scan-btn {
  width: 100%;
  height: 88rpx;
  background: #3b82f6;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.connect-btn {
  padding: 12rpx 32rpx;
  background: #10b981;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.unbind-btn {
  width: 100%;
  height: 80rpx;
  background: #ffffff;
  color: #ef4444;
  border: 2rpx solid #ef4444;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.device-list {
  margin-top: 8rpx;
}

.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.empty {
  padding: 40rpx 0;
  align-items: center;
}
.empty-text {
  color: #9ca3af;
  font-size: 26rpx;
}
.tail {
  height: 48rpx;
}
</style>
