<template>
  <!-- 根节点必须是 scroll-view，不能是 view：
       官方明确「VDOM模式中，App平台的页面默认不可滚动，需要开发者在页面中
       显示使用scroll-view」（doc.dcloud.net.cn/uni-app-x/page.html）。
       用 view 的后果是超出首屏的内容用户永远触达不到，且不报任何错。 -->
  <scroll-view class="login-page" :scroll-y="true">
    <view class="logo-area" @click="onLogoClick">
      <!-- 品牌标记 = 哮喘行动计划卡（绿/关注/红三分区 + 位置标记）。
           原先是 emoji，emoji 随系统换脸、视觉重量不可控，且技能禁止把
           emoji 当图标用（preflight C21）。资产由 tools/icons 脚本生成。 -->
      <image class="logo-mark" src="/static/brand/mark.png" mode="aspectFit" />
      <text class="app-name">哮卫 AsthmaGuard</text>
      <text class="app-slogan">儿童哮喘可穿戴监测系统</text>
    </view>

    <view class="form-card">
      <view class="form-item">
        <text class="label">手机号</text>
        <!--
          关键修正（勿回退）：
          1. 必须用 v-model 双向绑定。手动受控(:value + @input)在
             uni-app x Android 上 state 不会随输入更新（14:02 实测
             输入框显示 11 位但 phone.value 为空，提示"请输入手机号"）
          2. type 用 "text" 而非 "number"。官方提示 type=number 在
             不同 ROM 行为不一致；inputmode=numeric 仍弹数字键盘
          3. 超 11 位由 validatePhone 在提交时拦截提示，不再依赖 maxlength
        -->
        <input
          class="input"
          type="text"
          inputmode="numeric"
          v-model="phone"
          placeholder="请输入 11 位手机号"
          :maxlength="11"
        />
      </view>

      <view class="form-item">
        <text class="label">密码</text>
        <input
          class="input"
          type="password"
          v-model="password"
          placeholder="请输入密码（至少 6 位）"
          :maxlength="32"
        />
      </view>

      <view class="mode-tabs">
        <text
          class="mode-tab"
          :class="{ active: mode === 'login' }"
          @click="mode = 'login'"
        >登录</text>
        <text
          class="mode-tab"
          :class="{ active: mode === 'register' }"
          @click="mode = 'register'"
        >注册</text>
      </view>

      <template v-if="mode === 'register'">
        <view class="form-item">
          <text class="label">姓名</text>
          <input class="input" v-model="name" placeholder="请输入姓名" />
        </view>
        <view class="form-item">
          <text class="label">年龄</text>
          <input class="input" type="text" inputmode="numeric" v-model="age" placeholder="请输入年龄" />
        </view>
      </template>

      <button class="submit-btn" :loading="loading" @click="onSubmit">
        {{ mode === 'login' ? '登录' : '注册' }}
      </button>

      <text v-if="errorMsg != ''" class="error-msg">{{ errorMsg }}</text>

      <view class="demo-tip">
        <text class="demo-title">演示账号</text>
        <text class="demo-line">监护人：13800138001 / 123456</text>
        <text class="demo-line">管理员：13800138002 / 123456</text>
      </view>
    </view>

    <view class="footer-wrap">
      <!-- 网络诊断降级为安静入口：它是排障工具，不是产品功能 -->
      <text class="footer-tip" @click="onDiagnose">网络诊断</text>
      <!-- 责任口径（§11.1，6 处之一）。文案取自 styles/tokens.uts 单一来源 -->
      <text class="disclaimer">{{ DISCLAIMER_SHORT }}</text>
    </view>
    <!-- 滚动到底部时的收尾留白，避免最后一行内容贴住屏幕边缘 -->
    <view class="tail"></view>
  </scroll-view>
</template>

<script setup lang="uts">
// 注意：uni-app x 会自动引入 vue 公开 API（ref 等），无需 import
import { login, register } from '../../store/user.uts'
import { takeApiErrorText, clearApiError, diagnose } from '../../common/request.uts'
import { DISCLAIMER_SHORT } from '../../styles/tokens.uts'
import type { RegisterPayload } from '../../api/index.uts'

const mode = ref<string>('login')
// 关键：显式标注为 string，不能省略让 UTS 推断为 any。
// 否则 ref<string>('') 推断成 number/double，访问 .length 时会抛
// Kotlin 的 Unresolved reference / NPE，导致 validatePhone 抛异常
// 进入 onSubmit 的 catch，最终走兜底文案（看起来像"请求失败"，
// 但其实是类型推断导致的本地异常被吞）。
const phone = ref<string>('')
const password = ref<string>('')
const name = ref<string>('')
const age = ref<string>('')
const loading = ref<boolean>(false)
const errorMsg = ref<string>('')

// 连续点击 logo 7 次可填入演示账号（省去手输，避免手滑多打一位）
const logoTapCount = ref(0)

function validatePhone(): string {
  const p = phone.value
  if (p == '') {
    return '请输入手机号'
  }
  if (p.length != 11) {
    return `手机号应为 11 位，当前已输入 ${p.length} 位`
  }
  if (p.charAt(0) != '1') {
    return '手机号需以 1 开头'
  }
  return ''
}

// 登录流程（前置 async 函数，供 onSubmit 调用）
// 注意：UTS 不存在函数声明提升，必须先定义、后使用
async function doLogin(): Promise<boolean> {
  clearApiError()
  await login(phone.value, password.value)
  return true
}

// 注册流程（前置 async 函数）
async function doRegister(): Promise<boolean> {
  if (name.value == '') {
    errorMsg.value = '请输入姓名'
    return false
  }
  clearApiError()
  // 不再传 role（C3）：旧版这里硬塞 'guardian' 是为了绕开旧 /api/alerts 的
  // 角色门禁。该门禁已改为按数据归属鉴权（自己 + 名下孩子），且后端 register
  // 端点不再接受 role。客户端能自报角色本身就是那个提权漏洞的成因。
  await register({
    phone: phone.value,
    name: name.value,
    password: password.value,
    age: age.value != '' ? parseInt(age.value) : null,
    gender: null
  } as RegisterPayload)
  // 注册成功后自动登录
  clearApiError()
  await login(phone.value, password.value)
  return true
}

async function onSubmit() {
  errorMsg.value = ''

  if (password.value == '') {
    errorMsg.value = '请输入密码'
    return
  }
  if (password.value.length < 6) {
    errorMsg.value = '密码至少 6 位'
    return
  }
  const phoneErr = validatePhone()
  if (phoneErr != '') {
    errorMsg.value = phoneErr
    return
  }

  loading.value = true
  let ok = false
  try {
    if (mode.value === 'login') {
      ok = await doLogin()
    } else {
      ok = await doRegister()
    }
  } catch (e) {
    // 关键：透传后端/网络层的真实原因，而不是笼统的「操作失败」
    const realMsg = takeApiErrorText('')
    if (realMsg != '') {
      errorMsg.value = realMsg
    } else {
      // request 层未留痕的漏网异常（理论上 15:15 版后不会再走到），
      // 把原始异常 toString 带出来，保证任何失败都有迹可查
      errorMsg.value = `操作失败：${e}`
    }
    console.log(`[login] 登录异常: ${e}`)
    ok = false
  } finally {
    loading.value = false
  }

  if (ok) {
    uni.reLaunch({ url: '/pages/home/home' })
  }
}

// 网络诊断：直接把结果弹窗展示，便于定位「连不上」类问题
function onDiagnose() {
  uni.showLoading({ title: '检测中...' })
  diagnose().then((result: string) => {
    uni.hideLoading()
    uni.showModal({
      title: '网络诊断',
      content: result,
      showCancel: false
    })
  })
}

// 连点 logo 填入演示账号
function onLogoClick() {
  logoTapCount.value = logoTapCount.value + 1
  if (logoTapCount.value >= 7) {
    logoTapCount.value = 0
    phone.value = '13800138001'
    password.value = '123456'
    mode.value = 'login'
    uni.showToast({ title: '已填入演示账号', icon: 'none' })
  }
}
</script>

<style scoped>
.login-page {
  /* 根节点改成 scroll-view 后，这里不能再写 align-items: center。
     该属性会作用在滚动容器自身而不是内容上，导致子元素宽度塌缩、
     不再撑满一行。居中改由内层 .logo-area / .form-area 自己负责。 */
  flex: 1;
  padding: 80rpx 40rpx 40rpx;
  background: #f5f7fa;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

/* 品牌标记直接作为图形出现，不再套一个蓝色圆底：
   圆底 + 居中字形是最常见的那种「随便找个图标塞进圆里」的做法。 */
.logo-mark {
  width: 168rpx;
  height: 112rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #1f2937;
}

.app-slogan {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.form-card {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.mode-tabs {
  display: flex;
  margin-bottom: 32rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #6b7280;
  padding: 16rpx 0;
  border-bottom: 4rpx solid transparent;
}

.mode-tab.active {
  color: #3b82f6;
  border-bottom-color: #3b82f6;
  font-weight: bold;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: #3b82f6;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 16rpx;
}

.error-msg {
  color: #ef4444;
  font-size: 24rpx;
  margin-top: 16rpx;
  text-align: center;
}

.demo-tip {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top-width: 2rpx;
  border-top-style: solid;
  border-top-color: #f0f1f3;
}

.demo-title {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 8rpx;
}

.demo-line {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 40rpx;
}

.footer-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
}

.footer-tip {
  font-size: 22rpx;
  color: #3b82f6;
  /* text-decoration 非 uni-app x 标准属性（编译警告），
     改用主题蓝色区分可点击性 */
}

.disclaimer {
  font-size: 22rpx;
  color: #5a6468;
  margin-top: 16rpx;
}
.tail {
  height: 48rpx;
}
</style>
