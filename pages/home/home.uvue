<template>
  <view class="home-page">
    <!-- 顶部问候 -->
    <view class="header">
      <view>
        <text class="greeting">你好，{{ userState.user?.name ?? '用户' }}</text>
        <text class="sub-greeting">实时监测中</text>
      </view>
      <view class="status-badge" :class="deviceState.connected ? 'online' : 'offline'">
        <text>{{ deviceState.connected ? '设备已连接' : '设备未连接' }}</text>
      </view>
    </view>

    <!-- 实时指标卡片 -->
    <view class="metrics">
      <view class="metric-card">
        <text class="metric-label">心率</text>
        <text class="metric-value">{{ hrDisplay }}</text>
        <text class="metric-unit">bpm</text>
      </view>
      <view class="metric-card metric-card-mid">
        <text class="metric-label">血氧</text>
        <text class="metric-value">{{ boDisplay }}</text>
        <text class="metric-unit">%</text>
      </view>
      <view class="metric-card">
        <text class="metric-label">HRV</text>
        <text class="metric-value">{{ hrvDisplay }}</text>
        <text class="metric-unit">ms</text>
      </view>
    </view>

    <!-- 预警提示 -->
    <view v-if="latestAlert != null" class="alert-banner" :class="latestAlertLevelClass">
      <text class="alert-title">⚠️ 预警提醒</text>
      <text class="alert-desc">{{ latestAlertLabel }}</text>
    </view>

    <!-- 手动检测按钮 -->
    <view class="action-area">
      <button class="measure-btn" @click="goMeasure">
        <text>🫁 开始手动检测</text>
      </button>
    </view>

    <!-- 最近记录 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">最近记录</text>
        <text class="section-more" @click="goHistory">查看全部 ›</text>
      </view>
      <view v-if="alertError != ''" class="empty">
        <text>加载失败：{{ alertError }}</text>
      </view>
      <view v-if="alertError == '' && recentAlerts.length === 0" class="empty">
        <text>暂无记录</text>
      </view>
      <view v-for="a in recentAlerts" :key="a.id" class="record-item">
        <text class="record-type">{{ a.label }}</text>
        <text class="record-time">{{ a.time }}</text>
        <text class="record-status">{{ a.status }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
// 注意：uni-app x 会自动引入 vue 公开 API（ref/computed/onMounted 等），无需 import
import { userState, restore as restoreUser } from '../../store/user.uts'
import { deviceState, restore as restoreDevice } from '../../store/device.uts'
import { alertApi, dataApi, type AlertInfo, type AlertDisplay, type HardwareResultPayload } from '../../api/index.uts'
import { takeApiErrorText, clearApiError } from '../../common/request.uts'
import {
  initSDK,
  destroySDK,
  startHealthData,
  stopHealthData,
  type HardwareResultValue
} from '../../utils/rwble.uts'

const hr = ref<number | null>(null)
const bo = ref<number | null>(null)
const hrv = ref<number | null>(null)
const recentAlerts = ref<AlertDisplay[]>([])
const latestAlert = ref<AlertInfo | null>(null)
const latestAlertLabel = ref('')
const latestAlertLevelClass = ref('')
// 预警加载失败原因（如 role=user 时 /api/alerts 返回 403）。
// 此前失败只打日志，列表为空，用户会误以为「暂无记录」。
const alertError = ref('')

// 注意：UTS 的 String() 不支持 number 参数（Kotlin 侧仅有 CharArray/StringBuffer/StringBuilder 重载），
// 数字转字符串统一使用模板字符串 `${}`。
const hrDisplay = computed(() => (hr.value !== null ? `${hr.value}` : '--'))
const boDisplay = computed(() => (bo.value !== null ? `${bo.value}` : '--'))
const hrvDisplay = computed(() => (hrv.value !== null ? `${hrv.value}` : '--'))

function alertTypeLabel(type: string): string {
  const map = new Map<string, string>()
  map.set('hr_high', '心率过高')
  map.set('hr_low', '心率过低')
  map.set('bo_low', '血氧过低')
  map.set('cv_hr', '心率互验告警')
  map.set('cv_bo', '血氧互验告警')
  map.set('cv_hrv', 'HRV互验告警')
  return map.get(type) ?? type
}

function formatTime(iso: string): string {
  try {
    const d = new Date(iso)
    const m = d.getMinutes()
    const mm = m < 10 ? `0${m}` : `${m}`
    return `${d.getMonth() + 1}/${d.getDate()} ${d.getHours()}:${mm}`
  } catch (e) {
    return iso
  }
}

function goMeasure() {
  uni.navigateTo({ url: '/pages/measure/measure' })
}

function goHistory() {
  uni.switchTab({ url: '/pages/history/history' })
}

// 拉取预警列表，并预计算展示字段
// 注意：UTS 不存在函数声明提升（必须先声明、后使用），
// 因此 loadAlerts 必须定义在调用它的 onResultValue 之前
async function loadAlerts() {
  alertError.value = ''
  clearApiError()
  try {
    const alerts = await alertApi.list()
    // 预计算显示字段（label/time），避免模板内调用函数
    const displayList: AlertDisplay[] = []
    const top = alerts.slice(0, 5)
    for (let i = 0; i < top.length; i++) {
      const a = top[i]
      displayList.push({
        id: a.id,
        status: a.status,
        label: alertTypeLabel(a.alert_type),
        valueText: '',
        time: formatTime(a.created_at),
        statusClass: ''
      } as AlertDisplay)
    }
    recentAlerts.value = displayList
    // 取最新的待处理预警
    const pending = alerts.find((a) => a.status === '待处理')
    latestAlert.value = pending ?? null
    latestAlertLabel.value = pending != null ? alertTypeLabel(pending.alert_type) : ''
    latestAlertLevelClass.value = pending != null ? `level-${pending.level}` : ''
  } catch (e) {
    // 透传真实原因（典型：role 为 user 时 /api/alerts 返回 403「权限不足」）
    alertError.value = takeApiErrorText('未知错误')
  }
}

// 结果值回调：更新实时指标 + 上传后端
async function onResultValue(r: HardwareResultValue) {
  if (r.type === 'hr') hr.value = r.value
  else if (r.type === 'bo') bo.value = r.value
  else if (r.type === 'hrv') hrv.value = r.value

  // 上传后端（实时预警链路）
  // 注意：reactive 对象是 getter 访问，Kotlin 无法智能转换为非空，
  // 必须先提取到局部 val，否则后续 .id 会报 "nullable receiver"
  const dev = deviceState.currentDevice
  if (dev != null) {
    try {
      const resp = await dataApi.uploadHardwareResult({
        device_id: dev.id,
        type: r.type,
        value: r.value,
        timestamp: new Date(r.timestamp).toISOString()
      } as HardwareResultPayload)
      // 若触发预警，刷新预警列表
      // 注意（勿回退）：resp.alert 是可变属性，Kotlin 无法对其智能转换为非空，
      // 直接写 `resp.alert != null && resp.alert.triggered` 会报
      // "smart cast impossible"，必须先提取到局部 const。
      const brief = resp.alert
      if (brief != null && brief.triggered) {
        await loadAlerts()
      }
    } catch (e) {
      // 透传真实原因（如 404 设备不存在 / 401 token 失效）
      console.error('结果值上传失败', takeApiErrorText(''))
    }
  }
}

onMounted(() => {
  // 恢复登录态与设备态
  if (!userState.loggedIn) restoreUser()
  restoreDevice()

  // 初始化蓝牙 SDK + 开始实时结果值接收
  initSDK()
  // 注意：UTS 中「函数声明」不支持作为值传递，故此处用箭头函数包裹一层
  startHealthData((r: HardwareResultValue) => {
    onResultValue(r)
  })

  loadAlerts()
})

onUnmounted(() => {
  stopHealthData()
  destroySDK()
})
</script>

<style scoped>
.home-page {
  padding: 40rpx 32rpx;
  background: #f5f7fa;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.greeting {
  font-size: 40rpx;
  font-weight: bold;
  color: #1f2937;
}

.sub-greeting {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-badge.online {
  background: #d1fae5;
  color: #065f46;
}

.status-badge.offline {
  background: #fef3c7;
  color: #92400e;
}

.metrics {
  display: flex;
  margin-bottom: 32rpx;
}

.metric-card {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.metric-card-mid {
  margin-left: 20rpx;
  margin-right: 20rpx;
}

.metric-label {
  font-size: 24rpx;
  color: #6b7280;
}

.metric-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #1f2937;
  margin: 8rpx 0;
}

.metric-unit {
  font-size: 22rpx;
  color: #9ca3af;
}

.alert-banner {
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.alert-banner.level-2 {
  background: #fef3c7;
}
.alert-banner.level-3 {
  background: #fee2e2;
}

.alert-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #b91c1c;
}

.alert-desc {
  font-size: 26rpx;
  color: #7f1d1d;
  margin-top: 8rpx;
}

.action-area {
  margin-bottom: 32rpx;
}

.measure-btn {
  width: 100%;
  height: 100rpx;
  background: #3b82f6;
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1f2937;
}

.section-more {
  font-size: 24rpx;
  color: #3b82f6;
}

.empty {
  padding: 40rpx 0;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.record-type {
  font-size: 26rpx;
  color: #1f2937;
}

.record-time {
  font-size: 24rpx;
  color: #6b7280;
}

.record-status {
  font-size: 24rpx;
  color: #f59e0b;
}
</style>
