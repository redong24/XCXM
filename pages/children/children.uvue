<template>
  <view class="children-page">
    <!-- 数据来自后端 B1（GET /api/users/my-children），
         读取路径已接后端 B1。新建/编辑表单属 C4：
         后端 POST/PUT /api/users/children 已就绪，只差表单。 -->

    <view class="intro">
      <text class="intro-title">看护对象</text>
      <text class="intro-desc">
        戒指佩戴在谁身上，就把它绑到这里的哪一位。一枚戒指同时只能属于一个人。
      </text>
    </view>

    <view v-if="loading" class="state">
      <text class="state-text">正在读取</text>
    </view>

    <view v-if="!loading && errText != ''" class="state">
      <text class="state-text">{{ errText }}</text>
      <text class="state-action" @click="reload">重试</text>
    </view>

    <!-- 理论上不应出现：后端总把「我自己」作为第一项返回。
         保留它是因为空白屏幕比一句话更难排查。 -->
    <view v-if="!loading && errText == '' && rows.length == 0" class="state">
      <text class="state-text">没有读到任何档案。可能需要重新登录。</text>
      <text class="state-action" @click="reload">重试</text>
    </view>

    <view v-for="r in rows" :key="r.id" class="row" @click="openChild(r.id)">
      <view class="row-main">
        <text class="row-name">{{ r.name }}</text>
        <text v-if="r.isSelf" class="row-tag">我自己</text>
      </view>
      <view class="row-meta">
        <!-- 状态同时用文字与颜色表达，不单靠颜色 -->
        <text class="row-ring" :style="'color:' + r.zoneColor">
          {{ r.hasRing ? r.zoneText : '未绑戒指' }}
        </text>
        <text class="row-time">{{ r.ageText }}</text>
        <text v-if="r.lastUploadText != ''" class="row-time">{{ r.lastUploadText }}</text>
      </view>
    </view>

    <view class="add" @click="addChild">
      <text class="add-text">添加看护对象</text>
    </view>

    <text class="disclaimer">{{ DISCLAIMER_SHORT }}</text>
  </view>
</template>

<script setup lang="uts">
// 注意：uni-app x 会自动引入 vue 公开 API（ref/computed/onMounted 等），无需 import
import { childApi, alertApi, type ChildResp, type AlertInfo } from '../../api/index.uts'
import { takeApiErrorText, clearApiError } from '../../common/request.uts'
import { DISCLAIMER_SHORT, zoneColor, zoneLabel, zoneFromLevel, type Zone } from '../../styles/tokens.uts'
import type { ChildDisplay } from '../../types/display.uts'

const loading = ref<boolean>(false)
const errText = ref<string>('')
const rows = ref<ChildDisplay[]>([])

/** 把「未处理预警的最高级别」折算成分区。
 *
 *  没有未处理预警时刻意显示「无预警」而不是「安全区」：
 *  我们只知道「没有触发阈值」，不知道这个人此刻是否安全，
 *  两者不是一回事，界面不该替医生下结论（§11.1 责任口径）。 */
function zoneTextOf(hasPending: boolean, z: Zone): string {
  if (!hasPending) { return '无预警' }
  return zoneLabel(z)
}

async function reload() {
  loading.value = true
  errText.value = ''
  clearApiError()
  try {
    const people = await childApi.mine()

    // 一次拉全量预警再按 user_id 归组，而不是每人一个请求（N+1）。
    // 后端已把可见范围限制为「自己 + 名下孩子」，所以这一把就够。
    const alerts = await alertApi.list()
    const pendingLevel = new Map<number, number>()
    for (let i = 0; i < alerts.length; i++) {
      const a = alerts[i]
      if (a.status != '待处理') { continue }
      const prev = pendingLevel.get(a.user_id)
      if (prev == null || a.level > prev!) {
        pendingLevel.set(a.user_id, a.level)
      }
    }

    const out: ChildDisplay[] = []
    for (let i = 0; i < people.length; i++) {
      const p = people[i]
      const lv = pendingLevel.get(p.id)
      const hasPending = lv != null
      const z = hasPending ? zoneFromLevel(lv!) : ('green' as Zone)
      const age = p.age
      out.push({
        id: p.id,
        name: p.name,
        isSelf: p.is_self,
        age: age,
        // 模板里不做字符串拼接，也不用 String(number)：一律在脚本里算完
        ageText: age == null ? '未填年龄' : `${age} 岁`,
        hasRing: p.has_ring,
        zone: z,
        zoneColor: zoneColor(z),
        zoneText: zoneTextOf(hasPending, z),
        // TODO(C4): 「最近一次上传」需要后端给每人的最新读数时间戳，
        // 现有接口没有这个字段。留空 = 界面不显示，不编造时间。
        lastUploadText: ''
      } as ChildDisplay)
    }
    rows.value = out
  } catch (e) {
    errText.value = takeApiErrorText('读取看护对象失败')
  }
  loading.value = false
}

function openChild(id: number) {
  // TODO(C4): 跳编辑页 / 弹出编辑面板（后端 PUT /api/users/children/{id} 已就绪）
  console.log('open child', id)
}

function addChild() {
  // TODO(C4): C-2 纯档案表单（姓名 / 年龄 / 性别），无手机号、无密码。
  // 后端 POST /api/users/children 已就绪，只差这张表单。
  uni.showToast({ title: '添加功能随孩子管理一并上线', icon: 'none' })
}

onMounted(() => {
  reload()
})
</script>

<style scoped lang="scss">
/* 不 import uni.scss：官方文档明示它是特殊文件，编译器已把它注入每个 scss 文件，
 * 无需 import 即可使用其中的变量。保留 lang="scss" 只是为了启用 scss 预处理。
 * 见 doc.dcloud.net.cn/uni-app-x/collocation/uni-scss.html */

.children-page {
  flex: 1;
  background-color: $paper;
  padding-left: $sp-4;
  padding-right: $sp-4;
}

.intro {
  padding-top: $sp-5;
  padding-bottom: $sp-4;
}

.intro-title {
  font-size: $fs-title;
  color: $ink;
  font-weight: 600;
}

.intro-desc {
  font-size: $fs-label;
  color: $ink-2;
  line-height: 20px;
  margin-top: $sp-2;
}

/* 发丝线分层，不用卡片堆叠 */
.row {
  border-top-width: $hair-w;
  border-top-style: solid;
  border-top-color: $hairline;
  padding-top: $sp-3;
  padding-bottom: $sp-3;
  min-height: $tap-min;
  justify-content: center;
}

.row-main {
  flex-direction: row;
  align-items: center;
}

.row-name {
  font-size: $fs-body;
  color: $ink;
}

.row-tag {
  font-size: $fs-utility;
  color: $ink-2;
  margin-left: $sp-2;
  border-width: $hair-w;
  border-style: solid;
  border-color: $hairline;
  border-radius: $r-sm;
  padding-left: $sp-1;
  padding-right: $sp-1;
}

.row-meta {
  flex-direction: row;
  align-items: center;
  margin-top: $sp-1;
}

.row-ring {
  font-size: $fs-label;
}

.row-time {
  font-size: $fs-utility;
  color: $ink-2;
  margin-left: $sp-2;
}

.add {
  border-top-width: $hair-w;
  border-top-style: solid;
  border-top-color: $hairline;
  min-height: $tap-min;
  justify-content: center;
}

.add-text {
  font-size: $fs-body;
  color: $accent;
}

.state {
  padding-top: $sp-4;
  padding-bottom: $sp-4;
}

.state-text {
  font-size: $fs-label;
  color: $ink-2;
  line-height: 20px;
}

.state-action {
  font-size: $fs-label;
  color: $accent;
  margin-top: $sp-2;
}

.disclaimer {
  font-size: $fs-utility;
  color: $ink-2;
  margin-top: $sp-6;
  margin-bottom: $sp-5;
}
</style>
