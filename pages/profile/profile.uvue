<template>
  <view class="profile-page">
    <!-- 用户信息 -->
    <view class="user-card">
      <view class="avatar">
        <text class="avatar-text">{{ initial }}</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{ userState.user?.name ?? '未登录' }}</text>
        <text class="user-phone">{{ userState.user?.phone ?? '' }}</text>
      </view>
    </view>

    <!-- 功能菜单 -->
    <view class="menu-card">
      <view class="menu-item" @click="onFeedback">
        <text class="menu-label">健康反馈</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" @click="onAbout">
        <text class="menu-label">关于哮卫</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 退出登录 -->
    <button class="logout-btn" @click="onLogout">退出登录</button>
  </view>
</template>

<script setup lang="uts">
// 注意：uni-app x 会自动引入 vue 公开 API（computed/onMounted 等），无需 import
import { userState, userId, logout, restore } from '../../store/user.uts'
import { feedbackApi, type FeedbackPayload } from '../../api/index.uts'
import { takeApiErrorText, clearApiError } from '../../common/request.uts'

const initial = computed(() => {
  const name = userState.user?.name ?? '?'
  return name.charAt(0)
})

// 提交健康反馈（async）
// 注意：UTS 不存在函数声明提升，必须先定义、后使用，故放在 onFeedback 之前
async function submitFeedback(level: number) {
  clearApiError()
  try {
    await feedbackApi.submit({
      user_id: userId() ?? 0,
      feedback_level: level
    } as FeedbackPayload)
    uni.showToast({ title: '反馈已提交', icon: 'success' })
  } catch (e) {
    // 透传真实原因（如 400 参数错误 / 401 token 失效）
    const msg = takeApiErrorText('')
    uni.showToast({ title: msg != '' ? msg : '提交失败', icon: 'none' })
  }
}

function onFeedback() {
  // 弹出反馈对话框（四级反馈）
  uni.showActionSheet({
    itemList: ['1级：无症状', '2级：轻微不适', '3级：明显喘息', '4级：严重发作'],
    // 注意：success 回调签名要求返回 Unit，不能传 async 函数（否则 error17），
    // 因此用非 async 回调包裹，内部调用 async 处理函数（不 await）
    success: (res) => {
      submitFeedback(res.tapIndex + 1)
    }
  })
}

function onAbout() {
  uni.showModal({
    title: '关于哮卫',
    content: '哮卫 AsthmaGuard\n儿童哮喘可穿戴监测系统\n版本 1.0.0',
    showCancel: false
  })
}

function onLogout() {
  uni.showModal({
    title: '退出登录',
    content: '确定要退出登录吗？',
    success: (res) => {
      if (res.confirm) {
        logout()
      }
    }
  })
}

onMounted(() => {
  if (!userState.loggedIn) restore()
})
</script>

<style scoped>
.profile-page {
  padding: 32rpx;
  background: #f5f7fa;
}

.user-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #3b82f6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-text {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: bold;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f2937;
}

.user-phone {
  font-size: 26rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.menu-card {
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #1f2937;
}

.menu-arrow {
  font-size: 36rpx;
  color: #9ca3af;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background: #ffffff;
  color: #ef4444;
  border-radius: 20rpx;
  font-size: 30rpx;
}
</style>
