<template>
  <!-- 根节点必须是 scroll-view，不能是 view：
       官方明确「VDOM模式中，App平台的页面默认不可滚动，需要开发者在页面中
       显示使用scroll-view」（doc.dcloud.net.cn/uni-app-x/page.html）。
       用 view 的后果是超出首屏的内容用户永远触达不到，且不报任何错。 -->
  <scroll-view class="measure-page" :scroll-y="true">
    <!-- 状态显示 -->
    <view class="status-area">
      <view class="ring-visual" :class="{ active: measuring }">
        <!-- 戒指图形：与 tabBar 的戒指图标同构（同一段开口弧的形状语言）。
             原先是 emoji，见 preflight C21。 -->
        <image
          class="ring-figure"
          :src="measuring ? '/static/icons/ring-lg.png' : '/static/icons/ring-lg-idle.png'"
          mode="aspectFit"
        />
        <text class="ring-status">{{ statusText }}</text>
      </view>
    </view>

    <!-- 采集结果 -->
    <view v-if="hasResult" class="result-card">
      <view class="result-item">
        <text class="result-label">心率</text>
        <text class="result-value">{{ hrResult }} bpm</text>
      </view>
      <view class="result-item">
        <text class="result-label">血氧</text>
        <text class="result-value">{{ boResult }}%</text>
      </view>
      <view class="result-item">
        <text class="result-label">{{ vitalsMode ? '上报条数' : '样本数' }}</text>
        <text class="result-value">{{ sampleCount }}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-area">
      <button
        v-if="!measuring"
        class="start-btn"
        :class="{ 'start-btn-disabled': !deviceState.connected }"
        :disabled="!deviceState.connected"
        @click="onStart"
      >
        {{ startBtnText }}
      </button>
      <button v-else class="stop-btn" @click="onStop">
        {{ probing ? '停止探测' : (vitalsMode ? '停止测量' : '停止采集') }}
      </button>
      <!-- 诊断入口：仅在空闲且设备已连接时出现。
           放在主按钮下方并用弱化样式，避免被误当成正常采集入口。 -->
      <button
        v-if="!measuring && deviceState.connected"
        class="probe-btn"
        @click="onProbeAcc"
      >ACC 通道探测（诊断用）</button>
    </view>

    <text class="tip">采集约 1 分钟原始 PPG 波形，上传后由算法服务重算生理参数</text>
    <!-- 滚动到底部时的收尾留白，避免最后一行内容贴住屏幕边缘 -->
    <view class="tail"></view>
  </scroll-view>
</template>

<script setup lang="uts">
// 注意：uni-app x 会自动引入 vue 公开 API（ref/onUnmounted 等），无需 import
import { deviceState } from '../../store/device.uts'
import {
  dataApi,
  type RawPPGPayload,
  type HardwareResultPayload
} from '../../api/index.uts'
import { takeApiErrorText, clearApiError } from '../../common/request.uts'
import {
  initSDK,
  isDeviceReady,
  isRawPpgSupported,
  isRawAccSupported,
  startRawPpgCapture,
  stopRawPpgCapture,
  startHealthData,
  stopHealthData,
  SENSOR_PPG_GREEN,
  SENSOR_ACC,
  type RawPpgResult,
  type HardwareResultValue
} from '../../utils/rwble.uts'

const measuring = ref(false)
const statusText = ref('待机')
const hasResult = ref(false)
const hrResult = ref('--')
const boResult = ref('--')
const sampleCount = ref('--')
// 是否处于 ACC 诊断探测（而非正常 PPG 采集）。
// 用来把按钮文案和状态文字区分开 —— 探测不产生业务数据，
// 如果沿用「采集中」会让用户以为拿到了 PPG。
const probing = ref(false)

// 是否处于「结果值测量」（HR/血氧/HRV），区别于原始波形采集。
//
// 【为什么要有这条路】
//   [CAP] 实测该固件 PPG/ACC 等原始通道全 false，但 HR/血氧/HRV 全 true。
//   原先本页只有原始波形一条路，能力位闸门弹完窗就 return，页面变成
//   只会拒绝用户的死页面 —— 而设备明明能出数。这是 APP 侧的设计漏洞。
const vitalsMode = ref(false)

// 本次结果值测量已收到的上报条数，用来给用户「在动」的反馈。
const vitalsCount = ref(0)

// 结果值测量窗口定时器（60 秒，与 Q22 锁定的窗口一致）。
// 0 表示未启动 —— UTS 里 setTimeout 返回 number，不能用 null 判空。
let vitalsTimer = 0
const VITALS_WINDOW_MS = 60000

// 主按钮文案：直说这一下会做什么，别让用户猜。
// 原始波形不可用时写「测量心率/血氧」而不是含糊的「开始采集」——
// 名不符实的按钮文案就是在骗用户。
const startBtnText = computed((): string => {
  if (!deviceState.connected) {
    return '请先连接设备'
  }
  return isRawPpgSupported() ? '开始采集（原始波形）' : '测量心率/血氧（60 秒）'
})

// 原始 PPG 采集结果处理（async）
// 注意：UTS 不存在函数声明提升，必须先定义、后使用，故放在 onStart 之前
async function handleRawPpgResult(raw: RawPpgResult) {
  // 提取到局部常量：reactive 属性是 getter 访问，判空后重复访问 Kotlin 无法 smart cast
  const dev = deviceState.currentDevice
  if (dev == null) {
    // 此前用 device_id: 0 兜底，后端必然返回 404「设备不存在」，
    // 且错误被 catch 吞掉表现为静默失败，故改为显式拦截
    measuring.value = false
    statusText.value = '待机'
    uni.showToast({ title: '请先连接设备', icon: 'none' })
    return
  }

  statusText.value = '上传中...'
  try {
    clearApiError()
    // 上传原始 PPG 到后端（device_id 必须是后端真实存在的设备 id）
    const resp = await dataApi.uploadRawPPG({
      device_id: dev.id,
      channel: raw.channel,
      seq: Math.floor(raw.capturedAt / 1000),
      data: raw.data,
      fs: raw.fs,
      captured_at: new Date(raw.capturedAt).toISOString()
    } as RawPPGPayload)
    // 注意：UTS 的 String() 不支持 number 参数，用模板字符串转换
    sampleCount.value = `${resp.sample_count}`
    hasResult.value = true
    uni.showToast({ title: '采集完成', icon: 'success' })
  } catch (e) {
    // 透传真实原因（如 404 设备不存在），便于定位
    const msg = takeApiErrorText('')
    uni.showToast({ title: msg != '' ? msg : '上传失败', icon: 'none' })
  } finally {
    measuring.value = false
    statusText.value = '待机'
  }
}

// 单条结果值上传。
//
// 与 home.uvue 的 onResultValue 走同一条后端链路
// （/api/data/hardware-result），不需要新接口 —— 后端和首页早就在用。
// 上传失败只记日志、不打断测量：测量本身的价值高于单条上传成败。
async function uploadVital(r: HardwareResultValue) {
  // reactive 属性是 getter，判空后必须先提到局部 const，
  // 否则 Kotlin 侧访问 .id 会报 nullable receiver。
  const dev = deviceState.currentDevice
  if (dev == null) {
    return
  }
  try {
    clearApiError()
    await dataApi.uploadHardwareResult({
      device_id: dev.id,
      type: r.type,
      value: r.value,
      timestamp: new Date(r.timestamp).toISOString()
    } as HardwareResultPayload)
  } catch (e) {
    console.error(`[measure] 结果值上传失败：${takeApiErrorText('')}`)
  }
}

// 结果值测量的订阅回调。
//
// 【为什么必须是命名函数】
//   rwble 用 indexOf 比对引用来退订。内联箭头函数每次都是新对象，
//   退订会失败并造成引用计数泄漏（设备永远停不下来）。
//   声明位置也有讲究：必须在 startVitals 之前，UTS 没有函数提升。
function onVitalValue(r: HardwareResultValue) {
  vitalsCount.value = vitalsCount.value + 1
  if (r.type == 'hr') {
    hrResult.value = `${r.value}`
  } else if (r.type == 'bo') {
    boResult.value = `${r.value}`
  }
  // HRV 不在本页展示（首页同样的取舍：界面上常年显示 -- 是在消耗信任），
  // 但照常上传，数据本身有价值。
  sampleCount.value = `${vitalsCount.value}`
  hasResult.value = true
  uploadVital(r)
}

// 结束结果值测量（正常到点或用户中止都走这里）。
// 必须声明在 startVitals 之前：UTS 没有函数提升。
function finishVitals(byUser: boolean) {
  if (vitalsTimer != 0) {
    clearTimeout(vitalsTimer)
    vitalsTimer = 0
  }
  stopHealthData(onVitalValue)
  measuring.value = false
  vitalsMode.value = false
  if (vitalsCount.value > 0) {
    hasResult.value = true
    statusText.value = byUser ? '已停止' : '测量完成'
  } else {
    // 一条都没收到必须说清楚，不能显示「完成」——
    // 那等于告诉用户成功了，而他手上什么都没有。
    statusText.value = byUser ? '已停止（未取到数据）' : '未取到数据'
    uni.showModal({
      title: '未取到测量数据',
      content: '60 秒内手环没有上报任何心率/血氧数据。\n\n'
        + '请确认：手环已戴稳贴合手腕、处于已连接状态。\n\n'
        + '若反复如此，请把日志发回排查。',
      showCancel: false
    })
  }
}

// 结果值测量：走设备开放的 HR/血氧/HRV 通道。
function startVitals() {
  if (!isDeviceReady()) {
    uni.showModal({
      title: '设备未就绪',
      content: '尚未连接手环，或连接后尚未收到设备功能菜单。\n\n'
        + '请先到「设备」页连接手环，看到「设备已连接」提示后再回来。',
      showCancel: false
    })
    return
  }
  vitalsMode.value = true
  measuring.value = true
  probing.value = false
  hasResult.value = false
  vitalsCount.value = 0
  hrResult.value = '--'
  boResult.value = '--'
  sampleCount.value = '--'
  statusText.value = '测量中...（60 秒）'

  // 回调不能是 async：会得到 UTSPromise<Unit> 触发 error17，
  // 故非 async 包一层，内部调 async 函数且不 await。
  startHealthData(
    onVitalValue,
    (errMsg: string) => {
      // 注意：rwble 在设备未就绪时会把请求暂存并从这里回一次提示
      // （v11 的 pendingRealtime），那不是终态失败，所以这里只更新
      // 状态文字、不退出测量态，等它自动重放。
      statusText.value = errMsg != '' ? errMsg : '测量未开始'
    }
  )

  vitalsTimer = setTimeout(() => {
    vitalsTimer = 0
    finishVitals(false)
  }, VITALS_WINDOW_MS)
}

// 启动采集的公共实现，通道由调用方给出。
//
// 【为什么要参数化通道】
//   19:40 真机日志里绿光 PPG（sensorType=2）下发后 15.091s 超时失败
//   9201099。反编译已确认原生层不校验参数、直接组包下发，所以不是参数问题，
//   是设备没应答。ACC 通道（sensorType=1）是最便宜的判别实验：
//     ACC 出数   -> 原始采集链路是通的，仅 PPG 通道被厂家锁了
//     ACC 也静默 -> 该型号固件整体不支持原始波形下发
//   两个结论的下一步完全不同，所以必须能分别试。
function startCapture(channel: number) {
  // 采集前先确认设备真的就绪。
  //
  // 【为什么不直接调下去让它失败】
  //   直接调的结果是 9201005「设备未就绪」，这个错误码对用户毫无意义，
  //   也不告诉他下一步该做什么。真机日志里用户连点了三次（19:23:55、
  //   19:24:02、19:24:14），每次都是同一个错误码 —— 说明失败提示没能
  //   让他明白问题在哪。这里改成明确指路。
  // 原始波形能力位为 false 时，直接给结论而不是让用户点了没反应。
  //
  // 20:45 真机实测：S07（固件 V2.3.3）上报
  //   PPG=false ACC=false PPGRed=false IR=false Sleep=false
  // 而 HR=true 血氧=true HRV=true —— 链路和鉴权都正常，是固件把
  // 原始数据整族关掉了（连 PPG监测 也是 false），属消费级固件。
  // 这不是 APP 能绕过的，jar 里也确认没有任何 unlock/授权命令。
  if (channel != SENSOR_ACC && !isRawPpgSupported()) {
    // 【这里以前是死路】v11 弹完这个窗就 return，页面对用户毫无用处。
    // 现在改成：说明清楚，然后**直接改走结果值测量** ——
    // 设备开放的 HR/血氧/HRV 本来就能用，没有理由让用户空手而归。
    uni.showModal({
      title: '该设备不支持原始波形',
      content: '手环固件上报：不支持原始 PPG 波形输出（哮喘预警模型需要它，'
        + '需厂家提供开启原始数据的固件，请把日志中 [CAP] 两行发给厂家）。\n\n'
        + '心率/血氧可以正常测量，现在改为测量这两项，用时 60 秒。',
      confirmText: '开始测量',
      cancelText: '取消',
      success: (res) => {
        if (res.confirm) {
          startVitals()
        }
      }
    })
    return
  }
  if (!isDeviceReady()) {
    uni.showModal({
      title: '设备未就绪',
      content: '尚未连接手环，或连接后尚未收到设备功能菜单。\n\n'
        + '请先到「设备」页连接手环，看到「设备已连接」提示后再回来采集。',
      showCancel: false
    })
    return
  }
  probing.value = channel == SENSOR_ACC
  measuring.value = true
  statusText.value = channel == SENSOR_ACC ? 'ACC 探测中...' : '采集中...'
  hasResult.value = false

  // 注意：startRawPpgCapture 的回调签名要求返回 Unit，
  // 传 async 函数会得到 UTSPromise<Unit> 导致 error17，
  // 因此用非 async 回调包裹，内部调用 async 处理函数（不 await）
  startRawPpgCapture(
    channel,
    (raw: RawPpgResult) => {
      handleRawPpgResult(raw)
    },
    (errMsg: string) => {
      // 采集失败必须让用户看见并退出「采集中」状态，
      // 否则页面会永远停在转圈上，用户只能杀进程。
      measuring.value = false
      probing.value = false
      statusText.value = errMsg != '' ? errMsg : '采集失败'
    }
  )
}

// 主按钮：按设备实际能力选路径。
//
// 【为什么要自适应而不是给两个按钮】
//   用户要的是「测一次」，不该由他判断固件支持什么。
//   原始波形可用就走科研链路（信息量最大），不可用就退到结果值测量 ——
//   点主按钮永远有事发生，不会撞墙。
function onStart() {
  if (isRawPpgSupported()) {
    startCapture(SENSOR_PPG_GREEN)
  } else {
    startVitals()
  }
}

// ACC 通道探测：诊断入口，不上传数据（ACC 包的 ppg 为空，
// rwble 内部会跳过上传并打印说明）。
//
// 20:08 实测 PPG 与 ACC 均在 15.10s 后失败（极差 6ms，正是 SDK
// 命令队列「重发 2 次 × 5s 超时」的固定耗时），说明不是单通道被锁。
// 现在改成先看设备自己上报的能力位 —— 那是权威答案。
function onProbeAcc() {
  const capPpg = isRawPpgSupported()
  const capAcc = isRawAccSupported()
  if (!capPpg && !capAcc) {
    uni.showModal({
      title: '设备不支持原始波形',
      content: '设备在功能菜单里明确上报：不支持 PPG、也不支持 ACC 原始波形采集。\n\n'
        + '这不是 APP 或参数问题，需要厂家开启权限或提供支持原始波形的固件。\n\n'
        + '请把日志里的 [CAP] 那两行发给厂家。',
      showCancel: false
    })
    return
  }
  uni.showModal({
    title: 'ACC 通道探测',
    content: '这是诊断功能，不上传数据。\n\n'
      + `设备上报能力：PPG=${capPpg ? '支持' : '不支持'}、`
      + `ACC=${capAcc ? '支持' : '不支持'}\n\n`
      + '请戴好手环后确认，然后把日志发回。',
    confirmText: '开始探测',
    success: (res) => {
      if (res.confirm) {
        startCapture(SENSOR_ACC)
      }
    }
  })
}

function onStop() {
  // 两条链路的停止方式不同，必须分流：
  // 结果值测量要停三个 metric 并清定时器，原始采集要下发停止命令。
  // 走错分支的后果是设备继续在发数据而界面已经退出测量态。
  if (vitalsMode.value) {
    finishVitals(true)
    return
  }
  stopRawPpgCapture()
  measuring.value = false
  probing.value = false
  statusText.value = '已停止'
}

// SDK 初始化是幂等的（已初始化则直接回调成功），这里补一次是为了
// 兜住「直接从其它入口跳进本页、从未经过设备页」的情况。
//
// 注意它只能恢复 sdkInitialized，**恢复不了 deviceReady** ——
// deviceReady 只由设备主动上报的 onFunctionMenu 置位，设备已连着时
// SDK 不会再补报一次。所以真正的修复是 destroySDK 不再挂在页面卸载上，
// 这里只是补齐初始化，不是那个问题的解药。
onMounted(() => {
  initSDK((ok: boolean, errMsg: string) => {
    if (!ok) {
      uni.showToast({
        title: errMsg != '' ? errMsg : '蓝牙初始化失败',
        icon: 'none'
      })
    }
  })
})

onUnmounted(() => {
  // 定时器必须无条件清，否则页面卸载后仍会触发 finishVitals，
  // 对着已销毁的页面 setState 并弹窗。
  if (vitalsTimer != 0) {
    clearTimeout(vitalsTimer)
    vitalsTimer = 0
  }
  if (measuring.value) {
    if (vitalsMode.value) {
      stopHealthData(onVitalValue)
    } else {
      stopRawPpgCapture()
    }
  }
})
</script>

<style scoped>
.measure-page {
  padding: 40rpx 32rpx;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
}

.status-area {
  display: flex;
  justify-content: center;
  margin: 60rpx 0;
}

.ring-visual {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ring-figure {
  width: 240rpx;
  height: 240rpx;
}

.ring-status {
  font-size: 28rpx;
  color: #6b7280;
  margin-top: 16rpx;
}

.result-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.result-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.result-label {
  font-size: 28rpx;
  color: #6b7280;
}

.result-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
}

.action-area {
  margin-top: auto;
}

.start-btn {
  width: 100%;
  height: 96rpx;
  background: #3b82f6;
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.start-btn-disabled {
  background: #d1d5db;
  color: #9ca3af;
}

.stop-btn {
  width: 100%;
  height: 96rpx;
  background: #ef4444;
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
}

/* 诊断按钮：故意做成弱化的描边样式。
   它不是正常功能入口，视觉权重必须低于「开始采集」，
   否则用户会分不清哪个才是真正要点的。 */
.probe-btn {
  margin-top: 24rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: transparent;
  border-width: 2rpx;
  border-style: solid;
