// HTTP 请求封装（统一鉴权 + 错误处理 + baseURL）
// uni-app x 环境用 uni.request
//
// 设计要点（血泪教训，勿回退）：
//   1. 【错误信息必须透传】后端 FastAPI 的 4xx/5xx 返回 {"detail": "..."}，
//      网络层失败则 fail 回调携带 errMsg/errCode。此前这两类信息被统一丢弃，
//      页面只显示「操作失败」，导致真实原因（手机号或密码错误 / 证书校验失败 /
//      网络不可达）完全无法定位。现在统一记录到 lastApiError，页面取用展示。
//   2. 【只用本工程已验证的 UTS 写法】UTS 的 any 不能直接点属性，取字段一律
//      用 `as` 转成具名 type 再访问成员。不要改用 UTSJSONObject 变量下标
//      （o[key]）或显式标注 `const h: UTSJSONObject = {...}`，
//      这两种写法未在本工程验证过，是此前编译失败回退缓存的嫌疑点。
//   3. 【method 必须大写】uni-app x 的 method 合法值为 "GET"/"POST" 等大写字符串。
//   4. 【不要再依赖 sslVerify:false】（09-02 17:30 定案，勿回退）
//      旧地址 https://39.183.171.185:9443 用的是自签证书，且该证书本身有缺陷
//      （Basic Constraints 为 CA:TRUE，是一张「自签 CA」而非服务器证书，
//      Android 的 X509 校验会直接拒绝）。实测在 uni-app x Android 调试基座中，
//      sslVerify:false 并不生效，uni.request 一律回调 fail 且
//      errCode=602001（request 系统错误）。表现就是「登录点了没反应/报错」。
//      解决办法不是继续和 sslVerify 缠斗，而是换用一条「公网可信证书」通道：
//      同一台服务器上的 saas.365bmd.com 已有 DigiCert 签发的正式证书，
//      nginx 8443 端口新增 /asthma-api/ 反代到同一个 FastAPI（127.0.0.1:8000）。
//      于是 APP 走标准 HTTPS 校验即可，无需任何跳过证书的开关。

// 后端基址（公网可信证书，DigiCert 签发，Android 默认信任）
export const BASE_URL = 'https://saas.365bmd.com:8443'

// API 前缀。
// 说明：saas.365bmd.com 的 /api/ 已被同域名的 PHP 应用占用，
// 故 AsthmaGuard 使用独立前缀 /asthma-api/，由 nginx 转发时补回 /api/。
// 业务代码（api/index.uts）仍统一写 '/api/xxx'，由 resolveUrl 自动改写，
// 这样后端换域名/换前缀时只需改本文件。
export const API_PREFIX = '/asthma-api'

// 旧地址（自签证书，仅内网/PC 排查用，APP 不要再指向它）
export const LEGACY_BASE_URL = 'https://39.183.171.185:9443'

/**
 * 把业务层的 '/api/xxx' 改写为实际请求 URL。
 * 例：'/api/auth/login' -> 'https://saas.365bmd.com:8443/asthma-api/auth/login'
 */
export function resolveUrl(path: string): string {
  if (path.indexOf('/api/') == 0) {
    // 去掉开头的 '/api'（4 个字符），补上实际前缀
    return `${BASE_URL}${API_PREFIX}${path.substring(4)}`
  }
  return `${BASE_URL}${path}`
}

// 请求超时（毫秒）
export const REQUEST_TIMEOUT = 15000

// 最近一次请求错误的详细上下文
export type ApiErrorInfo = {
  path: string
  statusCode: number
  detail: string
  errMsg: string
  errCode: number
}

// 错误存储容器（用对象包一层；UTS 对象字面量需 as type）
type ErrorStore = {
  info: ApiErrorInfo | null
}
const errorStore = {
  info: null as ApiErrorInfo | null
} as ErrorStore

/** 记录最近一次错误，并打印日志便于 HBuilderX 控制台排查 */
function recordError(info: ApiErrorInfo): void {
  errorStore.info = info
  console.log(
    `[api] 请求失败 path=${info.path} status=${info.statusCode} detail=${info.detail} errMsg=${info.errMsg} errCode=${info.errCode}`
  )
}

/** 清空错误记录 */
export function clearApiError(): void {
  errorStore.info = null
}

/**
 * 取出并清空最近一次错误，返回可直接展示给用户的中文文案。
 * 无错误记录时返回 fallback。
 */
export function takeApiErrorText(fallback: string): string {
  const info = errorStore.info
  if (info == null) {
    return fallback
  }
  errorStore.info = null

  const parts: string[] = []
  if (info.detail != '') {
    parts.push(info.detail)
  }
  if (info.errMsg != '') {
    parts.push(info.errMsg)
  }
  if (parts.length == 0) {
    if (info.statusCode > 0) {
      parts.push(`HTTP ${info.statusCode}`)
    }
  }
  if (parts.length == 0) {
    return fallback
  }

  // 手动拼接（避免依赖数组 join 的跨端差异）
  let text = ''
  for (let i = 0; i < parts.length; i++) {
    if (i > 0) {
      text = `${text} · `
    }
    text = `${text}${parts[i]}`
  }
  return text
}

// 从后端响应体中提取 detail 字段
//
// 注意（09-02 17:55，勿回退）：这里不能再 `data as ErrorBody`。
// 非 2xx 时 res.data 的运行时类型是 UTSJSONObject（或 nginx 返回的 String），
// 强转具名 type 会抛 Kotlin ClassCastException。
// 统一用 UTSJSONObject.getString(key) 取值，取不到返回 null。
function pickDetail(data: any | null): string {
  if (data == null) {
    return ''
  }
  try {
    const obj = data as UTSJSONObject
    const d = obj.getString('detail')
    if (d == null) {
      return ''
    }
    return d!
  } catch (e) {
    // 响应体不是 JSON 对象（如 nginx 返回 HTML 字符串），忽略
    return ''
  }
}

// 统一请求方法
//
// 【关键设计变更（09-02 17:55，勿回退）】不再使用泛型，返回原始 any。
//
// 原因：官方文档明确写着：
//   「request 接口内部通过特殊方式读取了泛型类型，不支持传入动态的泛型：
//     比如将外层方法的普通泛型参数传入 request。所以目前尽量直接使用
//     uni.request 而不是封装。如确需封装，可不使用 type，改用 UTSJSONObject。」
//
// 旧代码正是被点名的反例：request<T>() 把动态泛型 T 转发给 uni.request，
// 泛型在编译期被擦除，uni.request 拿不到真实类型，于是原样返回
// UTSJSONObject；随后 `res.data as T` 触发
//   java.lang.ClassCastException:
//   io.dcloud.uts.UTSJSONObject cannot be cast to uni.UNIASTHMAGUARD.TokenResp
//
// 现在底层原样传出 res.data，由 api/index.uts 用 asObject / asObjectArray
// 取出 UTSJSONObject，再由手写 mapper 逐字段 get 出来构造具名 type。
// 全程没有跨类型强转，从原理上不可能再出 ClassCastException。
// 把请求体归一化成 uni.request 在 app-android 端唯一接受的类型。
//
// 【为什么必须有这一步（22:07 真机实证）】
//   官方文档 api/request.html 明写：
//     data —— 「在 app-android 端，参数类型只能为 UTSJSONObject
//              或者 string 类型」
//   错误码表：600008 = data参数类型不合法。
//
//   而 api/index.uts 里有 6 处 post/put 传的是具名 type（
//   HardwareResultPayload / RegisterPayload / FeedbackPayload /
//   ChildCreatePayload / RawPPGPayload）。具名 type 是编译期产物，
//   跨到原生层不成立，于是 uni.request 在发送前同步拒收 ——
//   表现就是 status=0（根本没上网）+ errCode=600008。
//
//   对照：登录传的是对象字面量 { phone, password }，被推导为
//   UTSJSONObject，所以一直能用。这也解释了为什么此前只有登录
//   这条路走得通。
//
// 【为什么在底层收口，而不是逐个调用点改成字面量】
//   6 处重复、日后新增端点必漏。上次修 TokenResp 的 CCE 时只改了
//   「响应」方向，没管「请求」方向，就是「只改一半」的代价 ——
//   同一个错误不能犯第二次。
//
// 【为什么用 stringify + parse】
//   JSON.parse 在 Android 侧返回的正是 UTSJSONObject —— 这一点由
//   本项目的历史 bug 反证：当初 `JSON.parse(x) as UserInfo` 抛
//   ClassCastException，就是因为它给的是 UTSJSONObject。
//   那个坑在这里正好是解法。
function normalizeBody(data: any | null): any | null {
  if (data == null) {
    return null
  }
  // string 是官方允许的另一种类型，原样放过（也避免被二次转义）。
  if (typeof data === 'string') {
    return data
  }
  // 已经是 UTSJSONObject 的（对象字面量走这条），不做无谓的绕行。
  if (data instanceof UTSJSONObject) {
    return data
  }
  try {
    const text = JSON.stringify(data)
    if (text == null) {
      return null
    }
    return JSON.parse(text!)
  } catch (e) {
    // 转换失败也要留痕：静默返回 null 会让请求体凭空消失，
    // 那比报错更难查（后端会收到空 body 报 422）。
    console.error(`[api] 请求体归一化失败，已按原样发送: ${e}`)
    return data
  }
}

export function request(
  path: string,
  method: string,
  data: any | null = null,
  needAuth: boolean = true
): Promise<any> {
  return new Promise<any>((resolve, reject) => {
    // 全部同步代码包进 try：uni.request 同步抛异常、header 构建异常等
    // 此前发生在 recordError 之前，异常被吞、页面只剩兜底文案（15:05 实测）
    try {
      // 组装请求头（对象字面量会被推导为 UTSJSONObject，支持下标赋值）
      const header = {
        'Content-Type': 'application/json'
      }

      // 鉴权：附带 JWT
      if (needAuth) {
        const token = uni.getStorageSync('token') as string
        if (token != '') {
          header['Authorization'] = `Bearer ${token}`
        }
      }

      uni.request({
        url: resolveUrl(path),
        method: method,
        // 归一化：具名 type 直传会被原生层拒收（600008），详见 normalizeBody
        data: normalizeBody(data),
        header: header,
        timeout: REQUEST_TIMEOUT,
        // 不再设置 sslVerify：现在走 DigiCert 可信证书通道，标准校验即可通过。
        // 旧代码在此处写 sslVerify:false 试图跳过自签证书校验，但该开关在
        // Android 调试基座中不生效，最终一律 fail + errCode=602001。
        success: (res) => {
          const statusCode = res.statusCode ?? 0
          if (statusCode >= 200 && statusCode < 300) {
            // 【必须先提取到局部 const】（09-02 18:25，勿回退）
            // Promise<any> 的 resolve 在 Kotlin 侧签名是 (Any) -> Unit（非空），
            // 而 res.data 的类型是 Any?。直接写 resolve(res.data) 会编译失败：
            //   error: 参数类型不匹配：实际类型为 'Any?'，预期类型为 'Any'
            // 而且 res.data 是属性访问，即使在外面判过空，Kotlin 也不会对它
            // 做智能转换。必须提取为局部 const，再判空 + `!` 断言。
            const body = res.data
            // 2xx 但 body 为空：调用方访问字段必然 NPE，提前拦截留痕
            if (body == null) {
              recordError({
                path: path,
                statusCode: statusCode,
                detail: '',
                errMsg: `HTTP ${statusCode} 但响应体为空`,
                errCode: 0
              } as ApiErrorInfo)
              reject(new Error('响应体为空'))
              return
            }
            // 原样传出，不做任何 as 转换。
            // 类型解析统一交给 api/index.uts 的手写 mapper
            // （asObject / asObjectArray + 逐字段 get）。
            resolve(body!)
            return
          }
          // 非 2xx：提取后端 detail（FastAPI 约定字段）
          const detail = pickDetail(res.data)
          if (statusCode === 401) {
            // 登录接口自身的 401 属于「手机号或密码错误」的正常业务分支，
            // 不能清 token 跳登录页，否则登录页会自己跳自己，掩盖真实错误。
            if (path != '/api/auth/login') {
              uni.removeStorageSync('token')
              uni.reLaunch({ url: '/pages/login/login' })
            }
          }
          recordError({
            path: path,
            statusCode: statusCode,
            detail: detail,
            errMsg: '',
            errCode: 0
          } as ApiErrorInfo)
          reject(new Error(`请求失败（HTTP ${statusCode}）`))
        },
        fail: (err) => {
          // err 不标类型，让 UTS 自动推导为官方 RequestFail，
          // 直接访问 errCode/errMsg。
          // 血泪教训（17:02 实证）：此前标注 any|null 再 as 自定义 type，
          // 运行时字段全部丢失。真实 errCode=602001（证书校验失败）
          // 被读成 0，errMsg 被读成空，导致错误信息完全失真。
          try {
            console.log(`[api] fail 原始对象: ${JSON.stringify(err)}`)
          } catch (e) {
            console.log('[api] fail 对象序列化失败')
          }
          recordError({
            path: path,
            statusCode: 0,
            detail: '',
            errMsg: `${err.errMsg}（code=${err.errCode}）`,
            errCode: err.errCode
          } as ApiErrorInfo)
          reject(new Error('网络请求失败'))
        }
      })
    } catch (e) {
      // uni.request 同步抛异常（参数类型/平台兼容），留痕后 reject
      recordError({
        path: path,
        statusCode: 0,
        detail: '',
        errMsg: `请求发送异常: ${e}`,
        errCode: 0
      } as ApiErrorInfo)
      reject(new Error('请求发送异常'))
    }
  })
}

// 便捷方法（用 function 声明，UTS 箭头函数不支持默认参数）
// 注意：这里同样不能带泛型（见 request 上方注释），一律返回 any。
export function get(path: string, needAuth: boolean = true): Promise<any> {
  return request(path, 'GET', null, needAuth)
}

export function post(path: string, data: any | null = null, needAuth: boolean = true): Promise<any> {
  return request(path, 'POST', data, needAuth)
}

export function put(path: string, data: any | null = null, needAuth: boolean = true): Promise<any> {
  return request(path, 'PUT', data, needAuth)
}

export function del(path: string, needAuth: boolean = true): Promise<any> {
  return request(path, 'DELETE', null, needAuth)
}

// ---------------------------------------------------------------------------
// 响应体转换辅助（供 api/index.uts 使用）
// ---------------------------------------------------------------------------
// 背景：uni.request 在 Android 上返回的 res.data 运行时类型是
// UTSJSONObject（对象）或 Array<any>（数组）。直接 `as 具名type` 会抛
// ClassCastException，必须先转成 UTSJSONObject，再逐字段取值。
// 这里只提供「安全取出 UTSJSONObject / 数组」的两个工具，
// 真正的字段映射在 api/index.uts 的 toXxx() mapper 里完成。

/** 把响应体安全转为 UTSJSONObject；失败返回 null */
export function asObject(data: any | null): UTSJSONObject | null {
  if (data == null) {
    return null
  }
  try {
    return data as UTSJSONObject
  } catch (e) {
    console.log(`[api] 响应体不是 JSON 对象: ${e}`)
    return null
  }
}

/** 把响应体安全转为 UTSJSONObject 数组；失败返回空数组 */
export function asObjectArray(data: any | null): Array<UTSJSONObject> {
  const out: Array<UTSJSONObject> = []
  if (data == null) {
    return out
  }
  try {
    const arr = data as Array<any>
    for (let i = 0; i < arr.length; i++) {
      const item = asObject(arr[i])
      if (item != null) {
        out.push(item!)
      }
    }
  } catch (e) {
    console.log(`[api] 响应体不是数组: ${e}`)
  }
  return out
}

// 单目标探测结果
type ProbeResult = {
  ok: boolean
  text: string
}

/**
 * 探测单个 URL 的连通性（内部工具）。
 * skipSsl=false 走系统证书校验，=true 跳过校验（对应自签名证书场景）。
 * 永远 resolve，不 reject。
 */
function probe(
  label: string,
  url: string,
  method: string,
  data: any | null,
  skipSsl: boolean
): Promise<ProbeResult> {
  return new Promise<ProbeResult>((resolve) => {
    try {
      uni.request({
        url: url,
        method: method,
        // 同上：统一走归一化，否则该路径同样 600008
        data: normalizeBody(data),
        header: { 'Content-Type': 'application/json' },
        timeout: 8000,
        sslVerify: !skipSsl,
        success: (res) => {
          const sc = res.statusCode ?? 0
          resolve({
            ok: true,
            text: `${label}：可达 (HTTP ${sc})`
          } as ProbeResult)
        },
        fail: (err) => {
          // 同 request() 的 fail：自动推导 RequestFail，直接访问字段
          try {
            console.log(`[diag] ${label} fail: ${JSON.stringify(err)}`)
          } catch (e) {
            console.log(`[diag] ${label} fail 序列化失败`)
          }
          resolve({
            ok: false,
            text: `${label}：不可达 ${err.errMsg}（code=${err.errCode}）`
          } as ProbeResult)
        }
      })
    } catch (e) {
      resolve({ ok: false, text: `${label}：不可达 同步异常 ${e}` } as ProbeResult)
    }
  })
}

/**
 * 网络连通性三目标对比自检（09-02 17:35 重写，适配可信证书通道）。
 * ① 公网受信 HTTPS（百度）：不通 = 模拟器整体断网
 * ② 新通道（可信证书，登录同款配置）：这条通了登录就该通
 * ③ 旧自签地址（对照组）：预期失败(602001)，用于确认问题已绕开
 * 一次点击出三个结果 + 自动结论。
 *
 * 注意：resolve 而非 reject，调用方无需 try/catch。
 */
export async function diagnose(): Promise<string> {
  const l1 = await probe('①公网HTTPS(百度)', 'https://www.baidu.com', 'GET', null, false)
  const l2 = await probe(
    '②新通道(可信证书)',
    resolveUrl('/api/auth/login'),
    'POST',
    { phone: '__diag__', password: '__diag__' },
    false
  )
  const l3 = await probe(
    '③旧自签地址(对照)',
    `${LEGACY_BASE_URL}/api/auth/login`,
    'POST',
    { phone: '__diag__', password: '__diag__' },
    false
  )

  let verdict = ''
  if (!l1.ok) {
    verdict = '结论：模拟器无法访问公网\n→ 与 App 无关，检查模拟器网络（重启或切换网络模式）'
  } else if (l2.ok) {
    verdict = '结论：新通道正常，登录应可用\n（第 3 项失败属预期：旧自签证书被 Android 拒绝，已不再使用）'
  } else {
    verdict = '结论：新通道不通\n→ 若 errMsg 含 8443/timeout：模拟器到 8443 端口受阻\n→ 请把本结果与控制台日志发给开发者'
  }

  return `BASE_URL：${BASE_URL}${API_PREFIX}

${l1.text}
${l2.text}
${l3.text}

${verdict}`
}
