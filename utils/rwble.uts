// RWFit 戒指蓝牙适配层
//
// 职责：封装官方 UTS 插件 rwfit-ble 的蓝牙调用，向上层提供统一的
// 设备扫描 / 连接 / 就绪等待 / 实时测量 / 原始波形采集接口。
//
// 上游依据（已核实，非推测）：
//   仓库 https://github.com/RWFitSDK/rw-uniapp-uts-plugin
//   模块 uni_modules/rwfit-ble，package.json id = "rwfit-ble"，version 0.0.1
//   契约文件 utssdk/interface.uts（约 130 个 API）
//
// 【为什么这个文件被整体重写过一次】
//   本文件第一版是在硬件到位之前凭插件市场信息推测写的，模块名写作
//   hl-rwble-ring，函数名写作 initSDK / controlHealthDataJL /
//   ringControlSensorRaw。核对官方 interface.uts 后确认**全部不存在**。
//   真实契约是 uni 风格的 options 对象（{ success, fail, complete }）
//   加上独立的 onXxx 事件订阅，例如：
//       initialize({ success, fail })
//       startScan({}) + onScanResult(cb)
//       startRealtimeMeasure({ metric }) + onRealtimeData(cb)
//   所以这里不是「把 USE_MOCK 改成 false」那么简单，是按真实契约重做。
//
// 【设计要点】
//   1. 接口抽象：上层页面只依赖本文件，不直接 import 插件。插件升级或
//      平台差异只改这一处。
//   2. USE_MOCK 保留：带原生 AAR 的 UTS 插件必须用自定义基座才能跑，
//      标准真机基座里 import 会直接失败。保留开关可以在基座就绪前
//      继续联调页面与后端，也便于出问题时一键退回、隔离变量。

// ---------------------------------------------------------------------------
// 运行模式
// ---------------------------------------------------------------------------
//
// true  = 不接触插件，返回模拟数据（无需自定义基座）
// false = 走真实 rwfit-ble 插件（必须已打自定义调试基座）
//
// 切成 false 前的前置条件，缺一个都会失败：
//   1. uni_modules/rwfit-ble 已放进工程
//   2. HBuilderX >= 5.15.0（插件 engines 要求）
//   3. 已提交云端打包「自定义调试基座」并安装到手机
//   4. manifest.json 里蓝牙权限齐备（本项目已具备，已核对）
export const USE_MOCK = false

// ---------------------------------------------------------------------------
// 对外类型
// ---------------------------------------------------------------------------

// 连接状态。SDK 侧是联合类型 'connecting'|'connected'|'disconnected'|'failed'，
// 但本项目既有约定是「UTS 里联合类型退化为 string」（见本文件历史与
// styles/tokens.uts 的 Zone 处理），这里保持一致，避免三元赋值时
// 推断成 string 而与联合类型冲突（U03 类问题）。
export type DeviceStatus = string

export type BleDevice = {
  name: string
  mac: string
  rssi: number
  // 平台设备标识。Android 用不到（connectNative 只认 mac），
  // 但 readme 明确要求「连接时原样传回扫描得到的完整设备对象，
  // iOS 和微信小程序需要其中的平台设备标识」，
  // app-ios/index.uts:462 就是取 device.uuid。
  // 设为可选：Android 扫描结果里没有这两个字段。
  uuid?: string
  deviceId?: string
}

// 实时测量结果值
export type HardwareResultValue = {
  type: string // 'hr' | 'bo' | 'hrv'
  value: number
  timestamp: number
}

// 原始波形采集结果。
// 注意：SDK 的 SensorRawPacket 一个包里同时带 ppg / ppgRed / ir / acc，
// 即 PPG 与加速度是**同时到达**的，不需要分两次采集。
export type RawPpgResult = {
  channel: number // 1绿光 / 2红光 / 3红外
  data: number[]
  fs: number
  capturedAt: number
}

export type ConnectionCallback = (status: DeviceStatus, device: BleDevice | null) => void
export type ResultValueCallback = (result: HardwareResultValue) => void
export type RawPpgCallback = (result: RawPpgResult) => void

// ---------------------------------------------------------------------------
// 采集通道常量（对应 SDK 的 RWFIT_SENSOR_RAW_SELECTION）
// ---------------------------------------------------------------------------
// 取自 interface.uts:482。这里只列本项目会用到的三个；
// 数值不可自行更改，必须与固件一致。
export const SENSOR_ACC = 1
export const SENSOR_PPG_GREEN = 2
export const SENSOR_PPG_GREEN_AND_ACC = 3

// ---------------------------------------------------------------------------
// 原始 PPG 采样率
// ---------------------------------------------------------------------------
// 【这个值目前是假设，尚未被实测证实】
//   代码历史上写死 125，而 SDK 文档写 100Hz。两者矛盾且从未验证。
//   fs 是 RR（呼吸率）提取的分母，直接决定 0.1-0.75Hz 带通对应的 bpm 区间，
//   若真值是 100 而按 125 算，全部 RR 结果会有 25% 系统性偏差，
//   已完成的 CapnoBase 定标参数也要重做。
//   本次自定义基座上线后，onSensorRawData 里的 PROBE 日志会直接算出
//   fs = ppg点数 / 相邻包 timestampSec 差值，据此改这一个常量即可。
export const RAW_PPG_FS = 125

// ---------------------------------------------------------------------------
// 插件引用
// ---------------------------------------------------------------------------
// 放开下面这行的同时必须把 USE_MOCK 置为 false。
// 注意：只要这行 import 存在，即使 USE_MOCK 为 true，标准真机基座
// 也会因为找不到原生库而启动失败，所以两者必须同时切换。
// 已核对 uni_modules/rwfit-ble/utssdk/interface.uts 与 app-android/index.uts，
// 下列每个名字都确认存在且签名一致（SDK 用 `export const xxx: Type = function`
// 形式导出，import 写法不变）。
import { initialize, startScan as sdkStartScan, stopScan as sdkStopScan,
         connect as sdkConnect, disconnect as sdkDisconnect,
         startRealtimeMeasure, stopRealtimeMeasure,
         controlSensorRaw, getSensorRawHistory,
         onScanResult, offScanResult, onConnectState, offConnectState,
         onFunctionMenu, offFunctionMenu,
         onRealtimeData, offRealtimeData,
         onSensorRawData, offSensorRawData,
         onSensorRawStopped, offSensorRawStopped } from '@/uni_modules/rwfit-ble'
// 类型单独引入。这些名字全部来自 utssdk/interface.uts，行号已核对：
//   BleDevice:59  FunctionMenu:78  RealtimeData:113  ConnectStateEvent:70
//   SensorRawPacket:190  SensorRawStoppedEvent:201  RwfitFail:18
// 注意 BleDevice 与本文件对外导出的同名类型是两回事：
//   SDK 的多 3 个可选字段(uuid/deviceId/systemConnected)，
//   本文件的是精简后的对外契约。这里 import 的是 SDK 版，
//   用于给回调参数标注类型；对外仍返回本文件自己的 BleDevice。
import type { BleDevice as SdkBleDevice, ConnectStateEvent, FunctionMenu,
              RealtimeData, SensorRawPacket, SensorRawStoppedEvent,
              RwfitFail } from '@/uni_modules/rwfit-ble'

// 【为什么 startScan / stopScan / connect / disconnect 要起别名】
//   本文件对外导出的函数同名。UTS 编译到 Kotlin 后，同名符号会互相遮蔽，
//   本文件里的 startScan() 会递归调用自己而不是插件的 —— 表现为栈溢出，
//   且报错位置与真因无关。加 sdk 前缀彻底避开。

// ---------------------------------------------------------------------------
// 内部状态
// ---------------------------------------------------------------------------
//
// 【connected 与 ready 是两个不同的状态，务必不要合并】
// 这是照 API 列表绝对看不出来、只有读官方封装 common/rwfit.js 才知道的约定：
//   onConnectState -> 'connected' 只代表 BLE 链路建立
//   真正能调业务 API，要等戒指主动上报 onFunctionMenu（功能菜单），
//   官方封装里对应 state.ready = true，并提供 ensureDeviceReady(15000)
// README 也明确写着「调用设备业务 API 前，请先等待 onFunctionMenu 回调」。
// 如果按「连上就测量」写，真机上会随机失败且报错与真因无关，
// 属于硬件联调里最难定位的一类问题。

let sdkInitialized = false
let deviceConnected = false
let deviceReady = false

// 上层注册的回调。真实模式下事件是全局订阅（onXxx 只能有一个监听者），
// 所以必须把上层回调存起来，由本文件的单一监听者转发。
// 类型带 | null 是 UTS 空安全的要求，调用处必须用 ?.() 或判空。
let connCb: ConnectionCallback | null = null
let scanFoundCb: ((device: BleDevice) => void) | null = null
let resultCb: ResultValueCallback | null = null
let rawCb: RawPpgCallback | null = null

// 监听者是否已注册。onXxx 重复调用会覆盖，不会叠加，
// 但仍用一个标志避免在 initialize 之外的地方误注册。
let listenersBound = false

// --- 采样率自测（PROBE）状态 ---------------------------------------------
// 存在的唯一目的：把「一个包多少个点」「相邻包间隔多少秒」「sequence 是否连续」
// 这三个数直接算出来打到日志里，不让人肉眼数日志。
// 这三个数决定 fs 的真值。当前代码里 fs=125 是**我们的假设**，
// SDK 文档写 100Hz。若真值是 100，RR 定标参数全部要重做，所以必须实测。
let probeCount = 0
let probeLastTs = 0.0
let probeLastSeq = -1
let probeSumPoints = 0
const PROBE_MAX = 12

// mock 模式下的定时器句柄。0 表示未启动。
// 用 number 而非 any：UTS 严格空安全下 any|null 会在清理时逼出强转。
let mockRealtimeTimer = 0

// 把 SDK 的 dataType(number) 映射成本项目的 type 字符串。
//
// 数值不是猜的，逐条取自 uni_modules/rwfit-ble/utssdk/app-android/index.uts
// 的 bindRealtimeCallback()（757-786 行）里的分支判断：
//   type == 1  -> Constants.RingHealthType.HR        心率
//   type == 13 -> HRV（SDK 同样存在 HrPartData 里）
//   type == 3  -> 血氧
//   type == 4  -> 血压（本项目暂不用）
//   type == 8  -> 压力（本项目暂不用）
//   type == 9  -> 血糖（本项目暂不用）
//   type == 10 -> 计数（本项目暂不用）
// 返回空串表示「本项目不消费」，调用方据此丢弃，不要伪造成 hr。
function mapDataType(dataType: number): string {
  if (dataType == 1) {
    return 'hr'
  }
  if (dataType == 13) {
    return 'hrv'
  }
  if (dataType == 3) {
    return 'bo'
  }
  return ''
}

// 统一的错误文案。RwfitFail 继承 IUniError，有 errCode + errMsg。
// errCode 取值见 interface.uts 的 RwfitErrorCode：
//   9201002 蓝牙不可用 / 9201003 权限被拒 / 9201004 参数非法
//   9201005 设备未就绪 / 9201006 超时 / 9201007 平台不支持 / 9201099 原生错误
function failText(code: number, msg: string): string {
  let hint = ''
  if (code == 9201002) {
    hint = '蓝牙不可用（请检查手机蓝牙是否打开）'
  } else if (code == 9201003) {
    hint = '蓝牙/定位权限被拒绝'
  } else if (code == 9201005) {
    hint = '设备未就绪（未连接或未收到功能菜单）'
  } else if (code == 9201006) {
    hint = '操作超时'
  } else if (code == 9201099) {
    hint = '原生 SDK 错误'
  }
  if (hint == '') {
    return `${code}: ${msg}`
  }
  return `${code} ${hint}: ${msg}`
}

export function isReady(): boolean {
  return deviceReady
}

export function isConnected(): boolean {
  return deviceConnected
}

// ---------------------------------------------------------------------------
// SDK 生命周期
// ---------------------------------------------------------------------------

// 停止实时测量。
//
// 声明位置有讲究：它被 destroySDK 和 startHealthData 调用，而 UTS/Kotlin
// 没有函数提升，被调用者必须先声明，否则编译直接失败。
// 这不是风格问题，是硬约束（utscheck 的 U05 检查项就抓到过这里）。
export function stopHealthData(): void {
  if (mockRealtimeTimer != 0) {
    clearInterval(mockRealtimeTimer)
    mockRealtimeTimer = 0
  }
  if (USE_MOCK) {
    return
  }
  // 三个 metric 是分别启停的（index.uts 的 controlHealth 按 metric 换
  // healthKey 下发指令），所以停的时候也要逐个停，不能只停 hr。
  stopRealtimeMeasure({ metric: 'hr' })
  stopRealtimeMeasure({ metric: 'bloodOxy' })
  stopRealtimeMeasure({ metric: 'hrv' })
  resultCb = null
}

// 注册全部全局事件监听。
//
// 【为什么集中在一处注册，而不是各函数各自注册】
//   SDK 的 onXxx 是「单监听者」语义（index.uts 里就是给
//   xxxListener 变量赋值），后注册的会覆盖前一个。若 startScan 和
//   connect 各自注册 onConnectState，后者会把前者顶掉。
//   集中注册 + 转发到可空回调槽，是唯一不会互相踩的写法。
function registerListeners(): void {
  if (listenersBound) {
    return
  }
  listenersBound = true

  onScanResult((d: SdkBleDevice) => {
    console.log(`[RwBle] 扫到设备 name=${d.name} mac=${d.mac} rssi=${d.rssi} uuid=${d.uuid ?? '-'}`)
    // 平台标识必须原样带出去，否则 connect 时无法回传（iOS/微信要用）。
    scanFoundCb?.({
      name: d.name, mac: d.mac, rssi: d.rssi,
      uuid: d.uuid, deviceId: d.deviceId
    } as BleDevice)
  })

  // 只代表 BLE 链路状态，不代表可以调业务 API（见上文 connected/ready 说明）。
  onConnectState((e: ConnectStateEvent) => {
    const st = e.state
    console.log(`[RwBle] 连接状态 -> ${st}`)
    const dev = { name: e.name ?? '', mac: e.mac ?? '', rssi: 0 } as BleDevice
    if (st == 'connected') {
      deviceConnected = true
      // 注意：此处**不能**置 deviceReady = true。
      connCb?.('connected', dev)
    } else if (st == 'disconnected' || st == 'failed') {
      deviceConnected = false
      deviceReady = false
      connCb?.(st, dev)
    } else {
      connCb?.(st, dev)
    }
  })

  // 戒指主动上报功能菜单 = 真正可用。业务 API 的闸门就靠这个事件打开。
  onFunctionMenu((menu: FunctionMenu) => {
    deviceReady = true
    console.log(`[RwBle] 功能菜单已上报，设备就绪 mac=${menu.mac}`)
    connCb?.('ready', { name: menu.name, mac: menu.mac, rssi: 0 } as BleDevice)
  })

  onRealtimeData((d: RealtimeData) => {
    const t = mapDataType(d.dataType)
    if (t == '') {
      // 本项目不消费的指标（血压/压力/血糖/计数）直接丢，不伪造成 hr。
      return
    }
    resultCb?.({ type: t, value: d.dataValue, timestamp: d.time } as HardwareResultValue)
  })

  // ---- 原始波形实时流 ----
  onSensorRawData((p: SensorRawPacket) => {
    // ================= 采样率自测日志 =================
    // 这段是本次自定义基座的核心目的，读到数就能定 fs 真值。
    //
    // 【已核实的关键事实，决定了这里为什么只用 timestampSec】
    //   index.uts 里有两个不同的封装函数：
    //     sensorPacket()        <- onSensorRawData 走这条，有 timestampSec，**无 sequence**
    //     sensorHistoryPacket() <- getSensorRawHistory 走这条，有 sequence，**无 timestampSec**
    //   两条通路的可用字段是互斥的，所以实时流只能按 timestampSec 判连续，
    //   历史补齐只能按 sequence 判连续。二者都要判空（可选字段）。
    if (probeCount < PROBE_MAX) {
      const n = p.ppg.length
      const ts = p.timestampSec ?? 0.0
      const seq = p.sequence ?? -1
      probeSumPoints += n
      let dt = -1.0
      if (probeLastTs > 0.0 && ts > 0.0) {
        dt = ts - probeLastTs
      }
      let fsGuess = -1.0
      if (dt > 0.0) {
        // 保留两位小数，避免 Kotlin 打出 124.99999999999999
        fsGuess = Math.round((n / dt) * 100) / 100
      }
      let seqStep = -1
      if (probeLastSeq >= 0 && seq >= 0) {
        seqStep = seq - probeLastSeq
      }
      console.log(
        `[RwBle][PROBE ${probeCount + 1}/${PROBE_MAX}] ` +
        `type=${p.type} ppg点数=${n} acc点数=${p.acc.length} ` +
        `ir点数=${p.ir.length} red点数=${p.ppgRed.length} ` +
        `timestampSec=${ts} 距上包=${dt}s 推算fs=${fsGuess}Hz ` +
        `sequence=${seq} seq步长=${seqStep}`
      )
      probeLastTs = ts
      probeLastSeq = seq
      probeCount += 1
      if (probeCount == PROBE_MAX) {
        console.log(
          `[RwBle][PROBE 汇总] 共 ${PROBE_MAX} 包，ppg 总点数=${probeSumPoints}，` +
          `平均每包=${Math.round((probeSumPoints / PROBE_MAX) * 100) / 100} 点。` +
          `请把上面 PROBE 全部日志发回，用于确定 fs 真值（当前代码假设 125Hz）。`
        )
      }
    }
    // ================= 自测日志结束 =================

    // 一个包里同时带 ppg / ppgRed / ir / acc，按当前通道取对应数组。
    // 本项目当前只用绿光（后端 PPG_CHANNEL_GREEN 链路），
    // 红光/红外先不落库，避免上传无人消费的数据。
    if (p.ppg.length == 0) {
      return
    }
    rawCb?.({
      channel: SENSOR_PPG_GREEN,
      data: p.ppg,
      fs: RAW_PPG_FS,
      capturedAt: Date.now()
    } as RawPpgResult)
  })

  onSensorRawStopped((e: SensorRawStoppedEvent) => {
    console.log(`[RwBle] 原始采集已停止 reason=${e.reason}，开始拉历史补齐`)
    // 停止后拉历史，补齐 BLE 丢包造成的空洞。
    // 历史包只有 sequence 没有 timestampSec，所以这里不参与 fs 自测。
    getSensorRawHistory({
      success: (list: Array<any>) => {
        console.log(`[RwBle] 历史补齐 ${list.length} 包`)
        for (let i = 0; i < list.length; i++) {
          const pk = list[i] as SensorRawPacket
          if (pk.ppg.length == 0) {
            continue
          }
          console.log(`[RwBle][HIST ${i + 1}] sequence=${pk.sequence ?? -1} ppg点数=${pk.ppg.length}`)
          rawCb?.({
            channel: SENSOR_PPG_GREEN,
            data: pk.ppg,
            fs: RAW_PPG_FS,
            capturedAt: Date.now()
          } as RawPpgResult)
        }
      },
      fail: (e2: RwfitFail) => {
        console.error(`[RwBle] 历史补齐失败 ${failText(e2.errCode, e2.errMsg)}`)
      }
    })
  })
}

export function initSDK(onDone: (ok: boolean, errMsg: string) => void): void {
  if (USE_MOCK) {
    sdkInitialized = true
    console.log('[RwBle] mock 初始化完成')
    onDone(true, '')
    return
  }
  if (sdkInitialized) {
    onDone(true, '')
    return
  }
  console.log('[RwBle] 真实模式：开始初始化 rwfit-ble')
  // initialize 内部会自己申请蓝牙权限（index.uts:418 requestBluetoothPermissions），
  // 所以这里不需要再手动申请一遍，权限弹窗由 SDK 触发。
  initialize({
    success: () => {
      sdkInitialized = true
      registerListeners()
      console.log('[RwBle] 初始化成功，监听已注册')
      onDone(true, '')
    },
    fail: (e: RwfitFail) => {
      const msg = failText(e.errCode, e.errMsg)
      console.error(`[RwBle] 初始化失败 ${msg}`)
      onDone(false, msg)
    }
  })
}

export function destroySDK(): void {
  stopHealthData()
  if (USE_MOCK) {
    sdkInitialized = false
    deviceConnected = false
    deviceReady = false
    console.log('[RwBle] mock 销毁完成')
    return
  }
  offScanResult()
  offConnectState()
  offFunctionMenu()
  offRealtimeData()
  offSensorRawData()
  offSensorRawStopped()
  listenersBound = false
  connCb = null
  scanFoundCb = null
  resultCb = null
  rawCb = null
  sdkInitialized = false
  deviceConnected = false
  deviceReady = false
}

// ---------------------------------------------------------------------------
// 设备扫描
// ---------------------------------------------------------------------------

export function startScan(
  onFound: (device: BleDevice) => void,
  onError: (errMsg: string) => void
): void {
  if (!sdkInitialized) {
    onError('SDK 未初始化')
    return
  }
  if (USE_MOCK) {
    console.log('[RwBle] mock 开始扫描')
    setTimeout(() => {
      onFound({ name: 'RWFit Ring', mac: 'AA:BB:CC:DD:EE:FF', rssi: -65 } as BleDevice)
    }, 1500)
    return
  }
  // 真实用法：onScanResult 订阅结果（已在 registerListeners 里统一注册），
  // sdkStartScan 只负责开始扫描 —— 它的 success 只表示「扫描已启动」，不带设备。
  scanFoundCb = onFound
  console.log('[RwBle] 开始扫描')
  sdkStartScan({
    fail: (e: RwfitFail) => {
      const msg = failText(e.errCode, e.errMsg)
      console.error(`[RwBle] 扫描失败 ${msg}`)
      onError(msg)
    }
  })
}

export function stopScan(): void {
  if (USE_MOCK) {
    console.log('[RwBle] mock 停止扫描')
    return
  }
  console.log('[RwBle] 停止扫描')
  sdkStopScan({})
  // 不 offScanResult：监听是全局单例，注销后下次扫描会静默无回调。
  // 只清回调槽即可停止向上层转发。
  scanFoundCb = null
}

// ---------------------------------------------------------------------------
// 设备连接 / 就绪
// ---------------------------------------------------------------------------

// 连接设备。
//
// 【为什么参数是完整对象而不是 mac 字符串】
//   readme 原文：「连接时必须原样传回扫描得到的完整设备对象；
//   iOS 和微信小程序需要其中的平台设备标识。」
//   本函数早先只收 mac，在 Android 上能跑（connectNative:399 只校验 mac），
//   但 app-ios/index.uts:462 取的是 device.uuid —— 只传 mac 在 iOS
//   必然连不上，且不会报错，属于最难查的一类平台差异问题。
//   所以签名改为整个 BleDevice，由调用方原样回传扫描结果。
export function connect(device: BleDevice, onStatus: ConnectionCallback): void {
  const mac = device.mac
  if (USE_MOCK) {
    const dev = { name: 'RWFit Ring', mac, rssi: -65 } as BleDevice
    console.log(`[RwBle] mock 连接 ${mac}`)
    onStatus('connecting', dev)
    setTimeout(() => {
      deviceConnected = true
      onStatus('connected', dev)
      // 模拟 onFunctionMenu：连上之后还要一小段才真正可用。
      // 刻意保留这个延迟，让上层被迫正确处理「connected 但未 ready」，
      // 否则真机上才会第一次暴露这个时序问题。
      setTimeout(() => {
        deviceReady = true
        onStatus('ready', dev)
      }, 800)
    }, 1000)
    return
  }
  // 真实链路是三段式，不能省中间一段：
  //   sdkConnect() -> onConnectState('connected') -> onFunctionMenu() -> 才可用
  // 后两段由 registerListeners 里的监听转发，所以这里只存回调 + 发起连接。
  connCb = onStatus
  console.log(`[RwBle] 发起连接 mac=${mac} uuid=${device.uuid ?? '-'}`)
  onStatus('connecting', device)
  // 原样回传扫描得到的对象，平台标识不丢。
  sdkConnect({
    device: {
      name: device.name, mac: device.mac, rssi: device.rssi,
      uuid: device.uuid, deviceId: device.deviceId
    } as SdkBleDevice,
    fail: (e: RwfitFail) => {
      const msg = failText(e.errCode, e.errMsg)
      console.error(`[RwBle] 连接失败 ${msg}`)
      deviceConnected = false
      deviceReady = false
      onStatus('failed', null)
    }
  })
}

export function disconnect(): void {
  deviceConnected = false
  deviceReady = false
  if (USE_MOCK) {
    console.log('[RwBle] mock 断开')
    return
  }
  console.log('[RwBle] 主动断开')
  sdkDisconnect({})
}

// ---------------------------------------------------------------------------
// 实时测量
// ---------------------------------------------------------------------------

export function startHealthData(
  callback: ResultValueCallback,
  onError: (errMsg: string) => void
): void {
  // 这道闸门是必须的，理由见上文 connected/ready 说明。
  if (!deviceReady) {
    onError('设备尚未就绪（等待功能菜单上报）')
    return
  }
  if (USE_MOCK) {
    console.log('[RwBle] mock 开始实时测量')
    stopHealthData()
    mockRealtimeTimer = setInterval(() => {
      const now = Date.now()
      const hr = 68 + Math.round(Math.random() * 10)
      // 血氧保留一位小数：Math.round(x*10)/10。
      // 不要直接内插浮点，Kotlin 侧会渲染成 97.30000000000001 这类值，
      // 这与 C4「3.5166 分钟前」、history.uvue 阈值渲染是同一类问题。
      const bo = Math.round((97 + Math.random() * 2) * 10) / 10
      callback({ type: 'hr', value: hr, timestamp: now } as HardwareResultValue)
      callback({ type: 'bo', value: bo, timestamp: now } as HardwareResultValue)
    }, 2000)
    return
  }
  // 真实用法：onRealtimeData 已在 registerListeners 里统一订阅，
  // 这里按 metric 逐个启动测量。
  // metric 合法值见 interface.uts:110 RealtimeMetric：
  //   'hr' | 'bloodOxy' | 'hrv' | 'pressure' | 'bloodSugar' | 'bloodPressure'
  // 本项目只用前三个；回调里是 dataType(number)，由 mapDataType 映射。
  resultCb = callback
  console.log('[RwBle] 启动实时测量 hr/bloodOxy/hrv')
  // 只对第一个 metric 上报错误，避免三条失败弹三次同样的提示。
  startRealtimeMeasure({
    metric: 'hr',
    fail: (e: RwfitFail) => {
      const msg = failText(e.errCode, e.errMsg)
      console.error(`[RwBle] 启动实时测量失败 ${msg}`)
      onError(msg)
    }
  })
  startRealtimeMeasure({ metric: 'bloodOxy' })
  startRealtimeMeasure({ metric: 'hrv' })
}

// ---------------------------------------------------------------------------
// 原始波形采集（科研链路）
// ---------------------------------------------------------------------------

export function startRawPpgCapture(
  channel: number,
  callback: RawPpgCallback,
  onError: (errMsg: string) => void
): void {
  if (!deviceReady) {
    onError('设备尚未就绪（等待功能菜单上报）')
    return
  }
  if (USE_MOCK) {
    console.log(`[RwBle] mock 开始原始波形采集（通道 ${channel}）`)
    setTimeout(() => {
      const fs = RAW_PPG_FS
      const n = fs * 60
      const data: number[] = []
      for (let i = 0; i < n; i++) {
        const t = i / fs
        // 合成 72bpm（1.2Hz）PPG + 噪声，仅用于链路联调，不具生理意义
        const base = 1000 + 100 * Math.sin(2 * Math.PI * 1.2 * t)
        const noise = Math.round((Math.random() - 0.5) * 30)
        data.push(Math.round(base) + noise)
      }
      callback({ channel, data, fs, capturedAt: Date.now() } as RawPpgResult)
    }, 3000) // mock 缩短为 3s，避免真等 60s
    return
  }
  // 真实链路是「启动采集 -> 收流 -> 收到停止事件 -> 再取历史补齐」。
  // 收流与停止事件都由 registerListeners 里的监听处理，这里只负责启动。
  rawCb = callback
  // 每次启动重置自测计数，保证一开采就能拿到 PROBE 日志。
  probeCount = 0
  probeLastTs = 0.0
  probeLastSeq = -1
  probeSumPoints = 0
  console.log(`[RwBle] 启动原始波形采集 sensorType=${channel}（自测日志将打印前 ${PROBE_MAX} 包）`)
  controlSensorRaw({
    enabled: true,
    sensorType: channel,
    fail: (e: RwfitFail) => {
      const msg = failText(e.errCode, e.errMsg)
      console.error(`[RwBle] 启动原始采集失败 ${msg}`)
      onError(msg)
    }
  })
}

export function stopRawPpgCapture(): void {
  if (USE_MOCK) {
    console.log('[RwBle] mock 停止原始波形采集')
    return
  }
  console.log('[RwBle] 停止原始波形采集')
  // 停止时 sensorType 必须传，index.uts 会做 validSensorType 校验。
  controlSensorRaw({ enabled: false, sensorType: SENSOR_PPG_GREEN })
  // 同 stopScan：不注销全局监听，只清回调槽。
  // onSensorRawStopped 还需要留着接固件的停止上报并拉历史补齐。
  rawCb = null
}
