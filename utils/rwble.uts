// ---------------------------------------------------------------------------
// 硬件结果值实时接收
// ---------------------------------------------------------------------------

export function startHealthData(callback: ResultValueCallback): void {
  if (USE_MOCK) {
    // 模拟实时结果值：每 2s 推送一次
    console.log('[RwBle] mock 开始实时结果值接收')
    setInterval(() => {
      const hr = 68 + Math.round(Math.random() * 10)
      const bo = 97 + Math.random() * 2
      callback({ type: 'hr', value: hr, timestamp: Date.now() } as HardwareResultValue)
      callback({ type: 'bo', value: Math.round(bo * 10) / 10, timestamp: Date.now() } as HardwareResultValue)
    }, 2000)
    return
  }
  // TODO: 真实调用（controlHealthDataJL 实时测量）
  // RwBleRing.controlHealthDataJL((result) => {
  //   // 解析 result.data 得到 hr/bo/hrv
  //   callback(...)
  // })
}

export function stopHealthData(): void {
  if (USE_MOCK) {
    console.log('[RwBle] mock 停止实时结果值接收')
    return
  }
  // TODO: RwBleRing.stopHealthData()
}

// ---------------------------------------------------------------------------
// 原始 PPG 采集（近实时，深度算法链路）
// ---------------------------------------------------------------------------

export function startRawPpgCapture(
  channel: number,
  callback: RawPpgCallback
): void {
  if (USE_MOCK) {
    // 模拟：采集 1 分钟后返回合成 PPG
    console.log(`[RwBle] mock 开始原始PPG采集（通道 ${channel}）`)
    setTimeout(() => {
      const fs = 125
      const seconds = 60
      const n = fs * seconds
      const data: number[] = []
      for (let i = 0; i < n; i++) {
        // 合成 72bpm PPG + 噪声
        const t = i / fs
        const base = 1000 + 100 * Math.sin(2 * Math.PI * 1.2 * t)
        const noise = Math.round((Math.random() - 0.5) * 30)
        data.push(Math.round(base) + noise)
      }
      callback({ channel, data, fs, capturedAt: Date.now() } as RawPpgResult)
    }, 3000) // mock 缩短为 3s，避免等待 1 分钟
    return
  }
  // TODO: 真实调用（ringControlSensorRaw 启动采集）
  // RwBleRing.ringControlSensorRaw(channel, ...)
  // 收到 onResult 停止通知后，调用 ringGetHistorySensorRaw 同步
}

export function stopRawPpgCapture(): void {
  if (USE_MOCK) {
    console.log('[RwBle] mock 停止原始PPG采集')
    return
  }
  // TODO: RwBleRing.stopSensorRaw()
}
