// ---------------------------------------------------------------------------
// 设备扫描
// ---------------------------------------------------------------------------

export function startScan(onFound: (device: BleDevice) => void): Promise<void> {
  return new Promise((resolve, reject) => {
    if (USE_MOCK) {
      // 模拟扫描：1.5s 后返回一个 mock 设备
      console.log('[RwBle] mock 开始扫描')
      setTimeout(() => {
        onFound({ name: 'RWFit Ring', mac: 'AA:BB:CC:DD:EE:FF', rssi: -65 } as BleDevice)
      }, 1500)
      resolve()
      return
    }
    // TODO: 真实扫描
    // RwBleRing.startScan((device) => {
    //   onFound({ name: device.name, mac: device.mac, rssi: device.rssi })
    // })
    // resolve()
    reject(new Error('真实扫描待接入插件'))
  })
}

export function stopScan(): void {
  if (USE_MOCK) {
    console.log('[RwBle] mock 停止扫描')
    return
  }
  // TODO: RwBleRing.stopScan()
}

// ---------------------------------------------------------------------------
// 设备连接
// ---------------------------------------------------------------------------

export function connect(mac: string, onStatus: ConnectionCallback): void {
  if (USE_MOCK) {
    console.log(`[RwBle] mock 连接设备 ${mac}`)
    onStatus('connecting', { name: 'RWFit Ring', mac, rssi: -65 } as BleDevice)
    setTimeout(() => {
      onStatus('connected', { name: 'RWFit Ring', mac, rssi: -65 } as BleDevice)
    }, 1000)
    return
  }
  // TODO: 真实连接
  // RwBleRing.connect(mac, (event) => {
