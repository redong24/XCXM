// RWFit 戒指蓝牙适配层
//
// 职责：封装 rw-uniapp-uts-plugin（插件市场 id 27471，模块名 hl-rwble-ring）的
// 蓝牙调用，向上层提供统一的设备扫描/连接/结果值/原始PPG采集接口。
//
// 设计要点：
//   1. 接口抽象：上层页面只依赖本适配层的接口，不直接 import 插件，
//      便于硬件未到位时切换 mock 实现、便于后续插件 API 变更时只改这一处。
//   2. Mock 回退：USE_MOCK = true 时（硬件未到位），返回模拟数据，保证
//      页面联调与后端链路可独立跑通。
//
// 硬件到位后：将 USE_MOCK 置为 false，并把下方 TODO 标记处补上真实插件调用。

// 是否使用 mock（硬件未到位时为 true）
export const USE_MOCK = true

// 设备连接状态（字符串联合类型在 UTS 中不受支持，退化为 string）
export type DeviceStatus = string

// 蓝牙设备（用 type，UTS 对象字面量需 as type 而非 interface）
export type BleDevice = {
  name: string
  mac: string
  rssi: number
}

// 硬件结果值（实时回调）
export type HardwareResultValue = {
  type: string // 'hr' | 'bo' | 'hrv'
  value: number
  timestamp: number
}

// 原始 PPG 采集结果
export type RawPpgResult = {
  channel: number // 1绿光/2红光/3红外
  data: number[] // 原始样本（int32）
  fs: number // 采样率
  capturedAt: number // 采集时间戳
}

// 连接事件回调
export type ConnectionCallback = (status: DeviceStatus, device: BleDevice | null) => void
// 结果值回调
export type ResultValueCallback = (result: HardwareResultValue) => void
// 原始PPG回调
export type RawPpgCallback = (result: RawPpgResult) => void

