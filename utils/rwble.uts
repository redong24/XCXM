  //   onStatus(status, event.device ? { name: event.device.name, mac: event.device.mac, rssi: event.device.rssi } : null)
  // })
}

export function disconnect(mac: string): void {
  if (USE_MOCK) {
    console.log(`[RwBle] mock 断开设备 ${mac}`)
    return
