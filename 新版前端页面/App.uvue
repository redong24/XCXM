<script lang="uts">
/**
 * AsthmaGuard · Root Component
 *
 * 职责：
 * 1. 应用启动时初始化主题（明色 / 暗色 / 跟随系统）
 * 2. 挂载全局服务（Ring Bluetooth 桩、通知、后台服务）
 * 3. 首次启动时判断跳登录 or 首页
 */

export default {
  onLaunch() {
    console.log('[AsthmaGuard] App Launch');

    // 判断是否已登录（真实场景查 uni.getStorageSync('token')）
    const token = uni.getStorageSync('ag_token') as string | null;
    if (token == null || token == '') {
      // 未登录 → 跳登录页
      uni.reLaunch({ url: '/pages/login/login' });
      return;
    }

    // 判断是否首次启动引导过（真实场景查 storage）
    const onboarded = uni.getStorageSync('ag_onboarded') as boolean | null;
    if (onboarded != true) {
      uni.reLaunch({ url: '/pages/onboarding/onboarding' });
      return;
    }

    // 已登录且已引导 → 进主页
    uni.reLaunch({ url: '/pages/home/home' });
  },
  onShow() {
    console.log('[AsthmaGuard] App Show');
  },
  onHide() {
    console.log('[AsthmaGuard] App Hide · 哨兵后台运行中');
  },
};
</script>

<style lang="scss">
/* 全局样式 · 页面无需引入 uni.scss（HBuilderX 会自动注入）*/

/* 全局重置 */
page {
  background: $paper;
  color: $ink;
  font-family: $font-body;
  font-size: $fs-body;
  line-height: 1.5;
}
</style>
