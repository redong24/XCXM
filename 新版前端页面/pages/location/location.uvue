<template>
  <view class="page">
    <!-- 全屏 map -->
    <map
      class="map"
      :latitude="latitude"
      :longitude="longitude"
      :scale="scale"
      :markers="markers"
      :show-location="false"
    ></map>

    <!-- 顶部浮动头 -->
    <view class="float-header" :style="{ top: `${statusBarHeight + 12}px` }">
      <view class="kid-mini" @tap="openChildrenList">
        <view class="kid-av" :style="{ backgroundColor: kid.avatarColor }">
          <text class="kid-av-text">{{ kid.name.charAt(0) }}</text>
        </view>
        <view class="kid-info">
          <text class="kid-n">{{ kid.name }} · {{ kid.age }} 岁</text>
          <view class="live-row">
            <view class="live-dot"></view>
            <text class="live-text">实时位置 · 12 秒前更新</text>
          </view>
        </view>
      </view>
      <view class="icon-btn" @tap="openSafeZones" hover-class="icon-btn-active">
        <text class="icon-btn-glyph">☰</text>
      </view>
    </view>

    <!-- 右侧地图控制 -->
    <view class="map-controls" :style="{ top: `${statusBarHeight + 100}px` }">
      <view class="ctl-btn" @tap="zoomIn" hover-class="ctl-btn-active">
        <text class="ctl-btn-glyph">+</text>
      </view>
      <view class="ctl-btn" @tap="zoomOut" hover-class="ctl-btn-active">
        <text class="ctl-btn-glyph">−</text>
      </view>
      <view class="ctl-btn ctl-btn-locate" @tap="locate" hover-class="ctl-btn-active">
        <text class="ctl-btn-glyph ctl-btn-glyph-locate">◉</text>
      </view>
    </view>

    <!-- 底部信息面板 -->
    <view class="bottom-sheet">
      <view class="location-row">
        <view class="loc-icon">
          <text class="loc-icon-glyph">◉</text>
        </view>
        <view class="loc-info">
          <text class="loc-place">向阳花幼儿园</text>
          <text class="loc-addr">杭州市西湖区文二西路 88 号 · 教室 3</text>
        </view>
        <view class="loc-time">
          <view class="loc-live-tag">
            <view class="loc-live-dot"></view>
            <text class="loc-live-text">实时</text>
          </view>
          <text class="loc-stay">停留 2h 14m</text>
        </view>
      </view>

      <view class="stats">
        <view class="stat">
          <text class="stat-l">今日活动</text>
          <view class="stat-v-row">
            <text class="stat-v">1.2</text>
            <text class="stat-u">km</text>
          </view>
        </view>
        <view class="stat">
          <text class="stat-l">环境空气</text>
          <view class="stat-v-row">
            <text class="stat-v">38</text>
            <text class="stat-u">AQI</text>
          </view>
        </view>
        <view class="stat">
          <text class="stat-l">安全区</text>
          <text class="stat-v stat-v-safe">在区域内</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
import { getCurrentKid } from '@/composables/useKid';

type Marker = {
  id: number;
  latitude: number;
  longitude: number;
  title: string;
  iconPath: string;
  width: number;
  height: number;
};

export default {
  data() {
    return {
      statusBarHeight: 44 as number,
      kid: getCurrentKid(),
      // 杭州西湖区中心坐标 (mock)
      latitude: 30.2741 as number,
      longitude: 120.1551 as number,
      scale: 15 as number,
      markers: [
        {
          id: 1,
          latitude: 30.2741,
          longitude: 120.1551,
          title: '朵朵',
          iconPath: '/static/brand/mark-64.png',
          width: 44,
          height: 44,
        },
        {
          id: 2,
          latitude: 30.2721,
          longitude: 120.1521,
          title: '家',
          iconPath: '/static/brand/mark-64.png',
          width: 32,
          height: 32,
        },
      ] as Marker[],
    };
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
  },
  methods: {
    zoomIn() { this.scale = Math.min(this.scale + 1, 20); },
    zoomOut() { this.scale = Math.max(this.scale - 1, 5); },
    locate() { uni.showToast({ title: '定位中', icon: 'loading' }); },
    openSafeZones() { uni.showToast({ title: '安全区域管理', icon: 'none' }); },
    openChildrenList() { uni.navigateTo({ url: '/pages/children/children' }); },
  },
};
</script>

