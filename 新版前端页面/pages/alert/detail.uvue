<template>
  <!-- 整屏 reskin 到深红色 · 是全应用唯一的深色页面 -->
  <scroll-view class="page" scroll-y="true">
    <view class="status-bar" :style="{ height: `${statusBarHeight}px` }"></view>

    <!-- 头部 · 返回 + 关注等级标题 -->
    <view class="header">
      <view class="back-btn" @tap="handleBack" hover-class="back-btn-active">
        <text class="back-icon">‹</text>
      </view>
      <text class="header-title">关注等级 · 提升</text>
      <view class="placeholder-40"></view>
    </view>

    <!-- 警示图 + 呼吸波纹 -->
    <view class="alert-hero">
      <view class="alert-icon-wrap">
        <view class="alert-ripple alert-ripple-1"></view>
        <view class="alert-ripple alert-ripple-2"></view>
        <view class="alert-icon">
          <text class="alert-icon-glyph">!</text>
        </view>
      </view>

      <view class="alert-zone-tag">
        <view class="zone-dot"></view>
        <text class="zone-tag-text">红色关注区</text>
      </view>

      <text class="alert-title">
        {{ kid.name }}的呼吸数值超出参考区间
      </text>
      <text class="alert-subtitle">
        触发于 <text class="alert-time">{{ triggerTime }}</text> · 已持续 {{ duration }}
      </text>
    </view>

    <!-- 触发时的监测数值 -->
    <view class="trigger-card">
      <text class="trigger-label">当前监测数值</text>
      <view class="trigger-row">
        <view class="metric-block">
          <text class="m-name">呼吸频率</text>
          <view class="m-val-row">
            <text class="m-val">36</text>
            <text class="m-unit">次/分</text>
          </view>
          <text class="m-cmp m-cmp-warn">↑ 参考区间 20-30</text>
        </view>
        <view class="metric-block metric-block-divider">
          <text class="m-name">血氧</text>
          <view class="m-val-row">
            <text class="m-val">92</text>
            <text class="m-unit">%</text>
          </view>
          <text class="m-cmp m-cmp-warn">↓ 参考区间 ≥ 95</text>
        </view>
        <view class="metric-block metric-block-divider">
          <text class="m-name">心率</text>
          <view class="m-val-row">
            <text class="m-val">128</text>
            <text class="m-unit">bpm</text>
          </view>
          <text class="m-cmp m-cmp-ok">— 参考区间</text>
        </view>
      </view>
    </view>

    <!-- 现在要做的（三步骤）-->
    <text class="steps-title">现在要做的</text>

    <view class="step step-done">
      <view class="step-num step-num-done">
        <text class="step-num-glyph">✓</text>
      </view>
      <view class="step-body">
        <text class="step-action step-action-done">检查{{ kid.name }}是否清醒 · 观察呼吸</text>
        <text class="step-detail">你已在 03:13 完成</text>
      </view>
      <text class="step-status step-status-done">已完成</text>
    </view>

    <view class="step step-active">
      <view class="step-num step-num-active">
        <text class="step-num-text">2</text>
      </view>
      <view class="step-body">
        <text class="step-action">按行动计划服用缓解药物</text>
        <text class="step-detail">沙丁胺醇气雾剂 · 2 喷 · 间隔 20 分钟可再次使用</text>
      </view>
      <text class="step-status step-status-active">进行中</text>
    </view>

    <view class="step">
      <view class="step-num">
        <text class="step-num-text">3</text>
      </view>
      <view class="step-body">
        <text class="step-action">10 分钟后重新测量</text>
        <text class="step-detail">{{ disclaimerStep3 }}</text>
      </view>
    </view>

    <!-- 合规声明 -->
    <view class="disclosure-card">
      <text class="disclosure-text">{{ disclaimerTop }}</text>
    </view>

    <view style="height: 120px;"></view>
  </scroll-view>

  <!-- 底部固定 CTA -->
  <view class="bottom-actions" :style="{ paddingBottom: `${safeBottom}px` }">
    <view class="cta-secondary" @tap="logMedication" hover-class="cta-secondary-active">
      <text class="cta-secondary-text">记录用药</text>
    </view>
    <view class="cta-primary" @tap="handleAcknowledge" hover-class="cta-primary-active">
      <text class="cta-primary-text">我知道了 · 已处理</text>
    </view>
  </view>
</template>

<script lang="uts">
import { getCurrentKid } from '@/composables/useKid';
import { DISCLAIMER_ALERT_TOP, DISCLAIMER_ALERT_STEP3 } from '@/utils/copy';

export default {
  data() {
    return {
      statusBarHeight: 44 as number,
      safeBottom: 30 as number,
      kid: getCurrentKid(),
      triggerTime: '03:12:47' as string,
      duration: '2 分 13 秒' as string,
      disclaimerTop: DISCLAIMER_ALERT_TOP,
      disclaimerStep3: DISCLAIMER_ALERT_STEP3,
    };
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
    this.safeBottom = (info.safeAreaInsets?.bottom ?? 20) + 10;
  },
  methods: {
    handleBack() {
      uni.navigateBack({});
    },
    logMedication() {
      uni.navigateTo({ url: '/pages/symptom/symptom' });
    },
    handleAcknowledge() {
      uni.showModal({
        title: '确认已处理',
        content: '标记为已处理后，此提醒将进入历史记录。',
        confirmText: '已处理',
        success: (res) => {
          if (res.confirm) {
            uni.showToast({ title: '已标记处理', icon: 'success' });
            setTimeout(() => uni.navigateBack({}), 800);
          }
        },
      });
    },
  },
};
</script>

