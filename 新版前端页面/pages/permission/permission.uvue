  padding: 30px 24px 0;
  align-items: center;
  display: flex;
  flex-direction: column;
}
.hero-icon {
  width: 80px;
  height: 80px;
  border-radius: 24px;
  background-image: linear-gradient(135deg, $sun-3, $sun-2);
  align-items: center;
  justify-content: center;
  display: flex;
  flex-direction: row;
  box-shadow: 0 12px 24px -6px rgba(245, 143, 50, 0.4);
}
.hero-icon-glyph {
  color: #FFFFFF;
  font-size: 40px;
  font-weight: 700;
  line-height: 40px;
}
.hero-title {
  font-size: 24px;
  font-weight: 700;
  color: $ink;
  letter-spacing: -0.02em;
  margin-top: 20px;
  text-align: center;
}
.hero-desc {
  font-size: 13px;
  color: $ink-2;
  line-height: 20px;
  margin-top: 10px;
  text-align: center;
  padding: 0 12px;
}

/* Perm list */
.perm-list {
  margin: 24px $sp-6 0;
  background: $card;
  border-width: 1px;
  border-style: solid;
  border-color: $hairline;
  border-radius: $r-md;
  overflow: hidden;
}
.perm-item {
  padding: 16px 18px;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: $hairline;
}
.perm-item:last-child { border-bottom-width: 0; }
.perm-icon {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  align-items: center;
  justify-content: center;
  display: flex;
  flex-direction: row;
  margin-right: 12px;
}
.perm-icon-bt { background: linear-gradient(135deg, #6A9BF0, #3D6BFF); }
.perm-icon-noti { background: linear-gradient(135deg, #FFB98A, $coral); }
.perm-icon-loc { background: linear-gradient(135deg, #A2CCE8, $sky); }
.perm-icon-bg { background: linear-gradient(135deg, $sun-3, $sun-2); }
.perm-icon-glyph {
  color: #FFFFFF;
  font-size: 18px;
  font-weight: 700;
}
.perm-body { flex: 1; }
.perm-name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.perm-name {
  font-size: 14px;
  font-weight: 700;
  color: $ink;
  letter-spacing: -0.01em;
  margin-right: 6px;
}
.required-tag {
  padding: 1px 6px;
  background: $coral-wash;
  border-radius: 6px;
}
.required-text {
  color: $zone-red;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.06em;
}
.perm-desc {
  font-size: 11px;
  color: $ink-2;
  margin-top: 4px;
  line-height: 17px;
}
.status-tag {
  padding: 4px 8px;
  border-radius: 8px;
  align-self: center;
}
.status-tag-granted { background: $leaf-wash; }
.status-tag-pending { background: $sun-wash; }
.status-tag-denied { background: $coral-wash; }
.status-tag-text {
  font-size: 11px;
  font-weight: 700;
}
.status-tag-text-granted { color: $leaf; }
.status-tag-text-pending { color: $sun-2; }
.status-tag-text-denied { color: $zone-red; }

/* Privacy */
.privacy-card {
  margin: 16px $sp-6 0;
  padding: 12px 16px;
  background: rgba(255, 143, 50, 0.08);
  border-width: 1px;
  border-style: solid;
  border-color: rgba(255, 143, 50, 0.2);
  border-radius: 12px;
}
