<template>
  <scroll-view class="page" scroll-y="true">
    <view class="status-bar" :style="{ height: `${statusBarHeight}px` }"></view>

    <!-- Hero -->
    <view class="perm-hero">
      <view class="hero-icon">
        <text class="hero-icon-glyph">◐</text>
      </view>
      <text class="hero-title">让哨兵保持在岗</text>
      <text class="hero-desc">AsthmaGuard 需要以下权限才能 24 小时守护孩子的呼吸</text>
    </view>

    <!-- 权限列表 -->
    <view class="perm-list">
      <view v-for="p in perms" :key="p.key" class="perm-item">
        <view class="perm-icon" :class="`perm-icon-${p.key}`">
          <text class="perm-icon-glyph">{{ p.icon }}</text>
        </view>
        <view class="perm-body">
          <view class="perm-name-row">
            <text class="perm-name">{{ p.name }}</text>
            <view v-if="p.required" class="required-tag">
              <text class="required-text">必需</text>
            </view>
          </view>
          <text class="perm-desc">{{ p.desc }}</text>
        </view>
        <view class="status-tag" :class="`status-tag-${p.status}`">
          <text class="status-tag-text" :class="`status-tag-text-${p.status}`">{{ statusLabels[p.status] }}</text>
        </view>
      </view>
    </view>

    <!-- 隐私声明 -->
    <view class="privacy-card">
      <text class="privacy-text">
        <text class="privacy-bold">你的隐私很重要</text>：所有健康数据本地加密存储 · 未经你允许不会上传或分享。可以在系统设置中随时撤销权限。
      </text>
    </view>

    <view style="height: 140px;"></view>
  </scroll-view>

  <view class="bottom-actions" :style="{ paddingBottom: `${safeBottom}px` }">
    <ag-button label="一键授予" type="primary" @tap="handleGrantAll" />
    <view class="skip-btn" @tap="handleSkip" hover-class="skip-btn-active">
      <text class="skip-text">稍后设置</text>
    </view>
  </view>
</template>

<script lang="uts">
import AgButton from '@/components/ag-button/ag-button.uvue';

type PermItem = {
  key: string;
  icon: string;
  name: string;
  desc: string;
  required: boolean;
  status: 'granted' | 'pending' | 'denied';
};

export default {
  components: { AgButton },
  data() {
    return {
      statusBarHeight: 44 as number,
      safeBottom: 30 as number,
      statusLabels: {
        granted: '已授权',
        pending: '待授权',
        denied: '未授权',
      },
      perms: [
        { key: 'bt',   icon: '⋱', name: '蓝牙',       desc: '连接 RWFit 戒指，实时读取呼吸、心率、血氧数据', required: true,  status: 'granted' },
        { key: 'noti', icon: '◐', name: '通知',       desc: '关注等级提升时立即提醒你 · 免打扰模式下仍会强制响铃', required: true,  status: 'granted' },
        { key: 'bg',   icon: '⏱', name: '后台运行',   desc: 'App 关闭后哨兵仍在岗，持续接收戒指数据', required: true,  status: 'pending' },
        { key: 'loc',  icon: '◉', name: '位置',       desc: '追踪孩子实时位置 · 环境空气质量 · 关注记录 · 可选', required: false, status: 'denied' },
      ] as PermItem[],
    };
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
    this.safeBottom = (info.safeAreaInsets?.bottom ?? 20) + 10;
  },
  methods: {
    handleGrantAll() {
      uni.showLoading({ title: '请求权限中...' });
      setTimeout(() => {
        uni.hideLoading();
        this.perms.forEach((p): void => {
          if (p.required) p.status = 'granted';
        });
        uni.showToast({ title: '权限已授予', icon: 'success' });
        setTimeout(() => this.goHome(), 800);
      }, 1200);
    },
    handleSkip() {
      this.goHome();
    },
    goHome() {
      uni.reLaunch({ url: '/pages/home/home' });
    },
  },
};
</script>

<style lang="scss">
