    </view>

    <view class="reset-hint">
      <text class="reset-text">恢复默认参考值 · 咨询医生调整个性化阈值</text>
    </view>

    <text class="disclaimer">— {{ disclaimerShort }} —</text>
    <view style="height: 40px;"></view>
  </scroll-view>
</template>

<script lang="uts">
import { getCurrentKid } from '@/composables/useKid';
import { DEFAULT_THRESHOLDS } from '@/utils/zone';
import { DISCLAIMER_THRESHOLD, DISCLAIMER_SHORT } from '@/utils/copy';

export default {
  data() {
    return {
      statusBarHeight: 44 as number,
      kid: getCurrentKid(),
      breathThreshold: DEFAULT_THRESHOLDS.breath,
      spo2Threshold: DEFAULT_THRESHOLDS.spo2,
      hrThreshold: DEFAULT_THRESHOLDS.hr.max,
      disclaimerThreshold: DISCLAIMER_THRESHOLD,
      disclaimerShort: DISCLAIMER_SHORT,
    };
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
  },
  methods: {
    handleBack() { uni.navigateBack({}); },
  },
};
</script>

