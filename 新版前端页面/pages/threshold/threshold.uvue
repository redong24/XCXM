          </text>
          <text class="zone-edit">调整</text>
        </view>
        <view class="zone-row">
          <view class="zone-tag zone-tag-r"><text class="zone-tag-text zone-tag-text-r">红色</text></view>
          <text class="zone-range">
            &gt; <text class="zone-num">{{ breathThreshold.amberMax }}</text> 次/分 · 触发报警
          </text>
          <text class="zone-edit">调整</text>
        </view>
      </view>
    </view>

    <!-- 血氧 -->
    <view class="metric-block">
      <view class="metric-head">
        <view class="metric-icon metric-icon-spo2">
          <text class="metric-icon-glyph">◐</text>
        </view>
        <view class="metric-titles">
          <text class="metric-name">血氧饱和度</text>
          <text class="metric-desc">当前设置 · ≥ {{ spo2Threshold.greenMin }}% 为绿色区</text>
        </view>
      </view>

      <view class="range-viz">
        <view class="range-track"></view>
        <view class="range-fill" style="left: 0%; right: 25%; background-image: linear-gradient(90deg, #E5574A 0%, #FFB547 30%, #6BB280 60%);"></view>
      </view>
      <view class="range-labels">
        <text class="range-label">85</text>
        <text class="range-label">90</text>
        <text class="range-label">95</text>
        <text class="range-label">100</text>
      </view>

      <view class="zone-rows">
        <view class="zone-row">
          <view class="zone-tag zone-tag-g"><text class="zone-tag-text zone-tag-text-g">绿色</text></view>
          <text class="zone-range">≥ <text class="zone-num">{{ spo2Threshold.greenMin }}</text> % · 正常</text>
          <text class="zone-edit">调整</text>
        </view>
        <view class="zone-row">
          <view class="zone-tag zone-tag-y"><text class="zone-tag-text zone-tag-text-y">黄色</text></view>
          <text class="zone-range">
            <text class="zone-num">{{ spo2Threshold.amberMin }} – {{ spo2Threshold.greenMin - 1 }}</text> % · 需关注
          </text>
          <text class="zone-edit">调整</text>
        </view>
        <view class="zone-row">
          <view class="zone-tag zone-tag-r"><text class="zone-tag-text zone-tag-text-r">红色</text></view>
          <text class="zone-range">
            &lt; <text class="zone-num">{{ spo2Threshold.amberMin }}</text> % · 触发报警
          </text>
          <text class="zone-edit">调整</text>
        </view>
      </view>
    </view>

    <!-- 心率上限 -->
    <view class="metric-block">
      <view class="metric-head">
        <view class="metric-icon metric-icon-hr">
          <text class="metric-icon-glyph">♥</text>
        </view>
        <view class="metric-titles">
          <text class="metric-name">心率上限</text>
          <text class="metric-desc">安静状态下的心率上限</text>
        </view>
      </view>

      <view class="range-viz">
        <view class="range-track"></view>
        <view class="range-fill" style="left: 0%; right: 20%;"></view>
