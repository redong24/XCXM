    <view class="disclosure">
      <text class="disclosure-text">
        <text class="disclosure-bold">提示</text>：{{ disclaimerThreshold }}当前使用<text class="disclosure-bold">{{ kid.name }}</text>的档案。
      </text>
    </view>

    <!-- 呼吸频率 -->
    <view class="metric-block">
      <view class="metric-head">
        <view class="metric-icon metric-icon-br">
          <text class="metric-icon-glyph">≋</text>
        </view>
        <view class="metric-titles">
          <text class="metric-name">呼吸频率</text>
          <text class="metric-desc">当前设置 · {{ breathThreshold.greenMin }} – {{ breathThreshold.greenMax }} 次/分为绿色区</text>
        </view>
      </view>

      <!-- Range viz -->
      <view class="range-viz">
        <view class="range-track"></view>
        <view class="range-fill" style="left: 30%; right: 15%;"></view>
      </view>
      <view class="range-labels">
        <text class="range-label">10</text>
        <text class="range-label">20</text>
        <text class="range-label">30</text>
        <text class="range-label">40</text>
        <text class="range-label">50</text>
      </view>

      <view class="zone-rows">
        <view class="zone-row">
          <view class="zone-tag zone-tag-g"><text class="zone-tag-text zone-tag-text-g">绿色</text></view>
          <text class="zone-range">
            <text class="zone-num">{{ breathThreshold.greenMin }} – {{ breathThreshold.greenMax }}</text> 次/分 · 正常
          </text>
          <text class="zone-edit">调整</text>
        </view>
        <view class="zone-row">
          <view class="zone-tag zone-tag-y"><text class="zone-tag-text zone-tag-text-y">黄色</text></view>
