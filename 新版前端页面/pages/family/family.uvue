.member-item { padding: 14px 16px; display: flex; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: $hairline; }
.member-item:last-child { border-bottom-width: 0; }
.member-avatar { width: 40px; height: 40px; border-radius: 14px; align-items: center; justify-content: center; display: flex; flex-direction: row; margin-right: 12px; }
.member-avatar-text { color: #FFFFFF; font-weight: 700; font-size: 16px; }
.member-body { flex: 1; }
