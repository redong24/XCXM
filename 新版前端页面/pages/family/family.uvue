.invite-active { opacity: 0.85; }
.invite-icon { width: 40px; height: 40px; border-radius: 14px; background: $sun-wash; align-items: center; justify-content: center; display: flex; flex-direction: row; margin-right: 12px; }
.invite-icon-glyph { color: $sun-2; font-size: 20px; font-weight: 700; }
.invite-body { flex: 1; }
.invite-title { font-size: 14px; font-weight: 700; color: $sun-2; letter-spacing: -0.01em; }
