<template>
  <scroll-view class="page" scroll-y="true">
    <view class="status-bar" :style="{ height: `${statusBarHeight}px` }"></view>

    <view class="header">
      <view class="back-btn" @tap="handleBack" hover-class="btn-active"><text class="back-icon">‹</text></view>
      <text class="header-title">家庭成员</text>
      <view class="placeholder-40"></view>
    </view>

    <!-- 家庭 hero -->
    <view class="family-hero">
      <view class="family-icon"><text class="family-icon-glyph">⌂</text></view>
      <text class="family-name">{{ familyName }}</text>
      <text class="family-meta">{{ members.length }} 位成员 · 共同守护 {{ kidsCount }} 个孩子</text>
    </view>

    <!-- 成员列表 -->
    <text class="sec-title">成员</text>
    <view class="member-list">
      <view v-for="m in members" :key="m.id" class="member-item">
        <view class="member-avatar" :style="{ backgroundColor: m.color }">
          <text class="member-avatar-text">{{ m.name.charAt(0) }}</text>
        </view>
        <view class="member-body">
          <view class="member-name-row">
            <text class="member-name">{{ m.name }}</text>
            <view v-if="m.isOwner" class="owner-tag"><text class="owner-text">管理员</text></view>
            <view v-if="m.isMe" class="me-tag"><text class="me-text">我</text></view>
          </view>
          <text class="member-role">{{ m.role }} · {{ m.phone }}</text>
        </view>
        <text class="member-perm">{{ m.permission }}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 邀请卡 -->
    <view class="invite-card" @tap="handleInvite" hover-class="invite-active">
      <view class="invite-icon"><text class="invite-icon-glyph">+</text></view>
      <view class="invite-body">
        <text class="invite-title">邀请家人</text>
        <text class="invite-desc">生成一次性邀请码 · 24 小时有效</text>
      </view>
      <text class="arrow">›</text>
    </view>

    <!-- 权限说明 -->
    <view class="perm-explain">
      <text class="explain-title">关于权限</text>
      <view class="explain-row"><text class="explain-tag">管理员</text><text class="explain-desc">邀请/移除成员 · 修改档案 · 处理报警</text></view>
      <view class="explain-row"><text class="explain-tag">照护人</text><text class="explain-desc">查看数据 · 接收报警 · 记录症状</text></view>
      <view class="explain-row"><text class="explain-tag">仅查看</text><text class="explain-desc">仅可查看数据 · 无法修改</text></view>
    </view>

    <view style="height: 40px;"></view>
  </scroll-view>
</template>

<script lang="uts">
type Member = { id: string; name: string; role: string; phone: string; color: string;
  permission: string; isOwner: boolean; isMe: boolean };

export default {
  data() {
    return {
      statusBarHeight: 44 as number,
      familyName: '陈家',
      kidsCount: 2,
      members: [
        { id: 'm1', name: '妈妈', role: '陈静', phone: '138 XXXX 8623', color: '#F58F32',
          permission: '管理员', isOwner: true, isMe: true },
        { id: 'm2', name: '爸爸', role: '陈永康', phone: '139 XXXX 1122', color: '#5A94BF',
          permission: '照护人', isOwner: false, isMe: false },
        { id: 'm3', name: '奶奶', role: '王秀兰', phone: '135 XXXX 0088', color: '#6BB280',
          permission: '仅查看', isOwner: false, isMe: false },
      ] as Member[],
    };
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
  },
  methods: {
    handleBack() { uni.navigateBack({}); },
    handleInvite() {
      uni.showModal({
        title: '生成邀请码',
        content: '将生成一次性 6 位数邀请码 · 24 小时内有效',
        confirmText: '生成',
        confirmColor: '#F58F32',
        success: (res) => {
          if (res.confirm) uni.showToast({ title: '邀请码：138-624', icon: 'none' });
        },
      });
    },
  },
};
</script>

<style lang="scss">
