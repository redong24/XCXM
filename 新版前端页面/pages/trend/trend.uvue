  border-top-style: solid;
  border-top-color: $hairline;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: $hairline;
}
.chart-bars {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
