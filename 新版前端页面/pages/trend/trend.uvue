<template>
  <scroll-view class="page" scroll-y="true">
    <view class="status-bar" :style="{ height: `${statusBarHeight}px` }"></view>

    <!-- 头部 -->
    <view class="page-h">
      <view class="titles">
        <text class="page-title">趋势</text>
        <text class="page-sub">
          最近 7 天 · <text class="sub-hl">1 次关注等级提升</text>
        </text>
      </view>
      <view class="kid-mini" @tap="openChildrenList">
        <view class="kid-av" :style="{ backgroundColor: kid.avatarColor }">
          <text class="kid-av-text">{{ kid.name.charAt(0) }}</text>
        </view>
        <text class="kid-n">{{ kid.name }}</text>
      </view>
    </view>

    <!-- 时间段 tabs -->
    <view class="period-tabs">
      <view
        v-for="p in periods"
        :key="p"
        class="period-seg"
        :class="{ 'period-seg-active': period == p }"
        @tap="period = p"
      >
        <text class="period-text" :class="{ 'period-text-active': period == p }">{{ p }}</text>
      </view>
    </view>

    <!-- 日期导航 -->
    <view class="date-nav">
      <view class="date-btn" @tap="prevPeriod">
        <text class="date-btn-icon">‹</text>
      </view>
      <view class="date-center">
        <text class="date-main">{{ dateRange }}</text>
        <text class="date-year">2026 · 本周</text>
      </view>
      <view class="date-btn" @tap="nextPeriod">
        <text class="date-btn-icon">›</text>
      </view>
    </view>

    <!-- 周报卡 -->
    <view class="summary-card">
      <view class="summary-top">
        <!-- 评分环 -->
        <view class="score-circ">
          <view class="score-ring">
            <view class="score-fill" :style="{ transform: `rotate(${scoreDeg}deg)` }"></view>
          </view>
          <view class="score-inner">
            <text class="score-num">{{ weekScore }}</text>
            <text class="score-label">SCORE</text>
          </view>
        </view>
        <view class="summary-body">
          <text class="summary-kicker">WEEKLY REPORT</text>
          <text class="summary-headline">
            <text class="summary-name">{{ kid.name }}</text>本周<text class="summary-hl">整体平稳</text>
          </text>
          <text class="summary-detail">相比上周得分提升 6 分 · 呼吸频率更规律 · 出现 1 次关注等级提升</text>
        </view>
      </view>

      <view class="summary-stats">
        <view class="stat">
          <view class="stat-val-row">
            <text class="stat-val">6</text>
            <text class="stat-unit"> 天</text>
          </view>
          <text class="stat-lbl">绿色区</text>
        </view>
        <view class="stat">
          <view class="stat-val-row">
            <text class="stat-val">1</text>
            <text class="stat-unit"> 次</text>
          </view>
          <text class="stat-lbl">黄色关注</text>
        </view>
        <view class="stat">
          <view class="stat-val-row">
            <text class="stat-val">0</text>
            <text class="stat-unit"> 次</text>
          </view>
          <text class="stat-lbl">红色关注</text>
        </view>
      </view>
    </view>

    <!-- 图表卡 -->
    <view class="chart-card">
      <view class="chart-h">
        <text class="chart-t">呼吸频率趋势</text>
        <text class="chart-rng">20 – 30 参考区间</text>
      </view>

      <!-- Metric tabs -->
      <view class="metric-tabs">
        <view
          v-for="(m, idx) in metricTypes"
          :key="m.key"
          class="mt"
          :class="{ 'mt-active': activeMetric == m.key }"
          @tap="activeMetric = m.key"
        >
          <view class="mt-dot" :style="{ backgroundColor: m.color }"></view>
          <text class="mt-text" :class="{ 'mt-text-active': activeMetric == m.key }">{{ m.label }}</text>
        </view>
      </view>

      <!-- Chart · 用 view 拼的柱状图 -->
      <view class="chart-body">
        <view class="chart-ref-band"></view>
        <view class="chart-bars">
          <view v-for="(pt, idx) in chartData" :key="idx" class="bar-col">
            <view class="bar-space"></view>
            <view
              class="bar"
              :class="{ 'bar-warn': pt.value > 30 }"
              :style="{ height: `${(pt.value / 40) * 100}%` }"
            >
              <text v-if="pt.value > 30" class="bar-peak-label">{{ pt.value }}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="chart-x-labels">
        <text v-for="l in dayLabels" :key="l" class="x-label">{{ l }}</text>
      </view>
    </view>

    <!-- 最近事件 -->
    <view class="sec-title-row">
      <text class="sec-title">最近事件</text>
      <text class="sec-more" @tap="openHistory">全部记录 →</text>
    </view>

    <view class="events-list">
      <view v-for="e in recentEvents" :key="e.id" class="event-row" @tap="openHistory">
        <view class="event-icn" :class="`event-icn-${e.type}`">
          <text class="event-icn-glyph">{{ e.icon }}</text>
        </view>
        <view class="event-body">
          <text class="event-action">{{ e.action }}</text>
          <text class="event-meta">{{ e.meta }}</text>
        </view>
        <view class="event-val">
          <view class="event-val-row">
            <text class="event-val-num">{{ e.value }}</text>
            <text class="event-val-unit">{{ e.unit }}</text>
          </view>
          <text class="event-val-tag" :class="`event-val-tag-${e.tagType}`">{{ e.tag }}</text>
        </view>
      </view>
    </view>

    <text class="disclaimer">— {{ disclaimerShort }} —</text>
    <view style="height: 90px;"></view>
  </scroll-view>
</template>

<script lang="uts">
import { getCurrentKid } from '@/composables/useKid';
import { DISCLAIMER_SHORT } from '@/utils/copy';

type MetricType = {
  key: string;
  label: string;
  color: string;
};

type ChartPoint = {
  day: string;
  value: number;
};

type EventItem = {
  id: string;
  type: 'warn' | 'ok' | 'med';
  icon: string;
  action: string;
  meta: string;
  value: string;
  unit: string;
  tag: string;
  tagType: 'warn' | 'ok';
};

export default {
  data() {
    return {
      statusBarHeight: 44 as number,
      kid: getCurrentKid(),
      periods: ['日', '周', '月', '年'] as string[],
      period: '周' as string,
      weekScore: 82 as number,
      activeMetric: 'breath' as string,
      dateRange: '8/28 – 9/3' as string,
      metricTypes: [
        { key: 'breath', label: '呼吸频率', color: '#F58F32' },
        { key: 'hr',     label: '心率',     color: '#FF8367' },
        { key: 'spo2',   label: '血氧',     color: '#6BB280' },
      ] as MetricType[],
      chartData: [
        { day: '周四', value: 22 },
        { day: '周五', value: 21 },
        { day: '周六', value: 23 },
        { day: '周日', value: 32 },  // Warning peak
        { day: '周一', value: 24 },
        { day: '周二', value: 22 },
        { day: '今天', value: 22 },
      ] as ChartPoint[],
      recentEvents: [
        {
          id: 'e1', type: 'warn', icon: '!',
          action: '关注等级 · 提升',
          meta: '周日 03:12 · 已处理',
          value: '32', unit: '次/分',
          tag: '超参考区间', tagType: 'warn',
        },
        {
          id: 'e2', type: 'med', icon: '💊',
          action: '缓解药物 · 沙丁胺醇',
          meta: '周日 03:15 · 2 喷',
          value: '按方案', unit: '',
          tag: '', tagType: 'ok',
        },
        {
          id: 'e3', type: 'ok', icon: '✓',
          action: '手动测量 · 完成',
          meta: '周日 03:25 · 数值回落',
          value: '24', unit: '次/分',
          tag: '已恢复', tagType: 'ok',
        },
      ] as EventItem[],
      disclaimerShort: DISCLAIMER_SHORT,
    };
  },
  computed: {
    scoreDeg(): number {
      return (this.weekScore / 100) * 360;
    },
    dayLabels(): string[] {
      return this.chartData.map((c): string => c.day);
    },
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
  },
  methods: {
    prevPeriod() { uni.showToast({ title: '上一周', icon: 'none' }); },
    nextPeriod() { uni.showToast({ title: '下一周', icon: 'none' }); },
    openHistory() { uni.navigateTo({ url: '/pages/history/history' }); },
    openChildrenList() { uni.navigateTo({ url: '/pages/children/children' }); },
  },
};
</script>

<style lang="scss">
