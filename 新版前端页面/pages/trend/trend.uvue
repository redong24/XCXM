}

.metric-tabs {
  display: flex;
  flex-direction: row;
  margin-bottom: 14px;
}
.mt {
  padding: 6px 12px;
  background: $card-2;
  border-width: 1px;
  border-style: solid;
  border-color: $hairline;
  border-radius: 20px;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 6px;
}
.mt-active {
  background: $sun-1;
  border-color: $sun-1;
}
.mt-dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  margin-right: 6px;
}
.mt-text {
  font-size: 11px;
  color: $ink-2;
}
.mt-text-active {
  color: #FFFFFF;
  font-weight: 600;
}

/* Chart body */
.chart-body {
  height: 140px;
  position: relative;
}
.chart-ref-band {
  position: absolute;
  left: 0;
  right: 0;
  top: 30%;
  height: 40%;
  background: rgba(245, 143, 50, 0.05);
