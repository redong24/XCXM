  flex-direction: row;
  justify-content: center;
}
.period-seg-active {
  background: $card;
  box-shadow: 0 2px 6px rgba(60, 40, 20, 0.08);
}
.period-text {
  font-size: 12px;
  color: $ink-2;
  font-weight: 500;
}
.period-text-active {
  color: $sun-2;
  font-weight: 700;
}

/* Date nav */
.date-nav {
  margin: 14px $sp-6 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.date-btn {
  width: 32px;
  height: 32px;
  border-radius: 16px;
  background: $card-2;
  border-width: 1px;
  border-style: solid;
