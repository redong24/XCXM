<template>
  <view class="page">
    <view class="status-bar" :style="{ height: `${statusBarHeight}px` }"></view>

    <!-- 搜索栏 -->
    <view class="search-bar">
      <view class="back-btn" @tap="handleBack" hover-class="btn-active"><text class="back-icon">‹</text></view>
      <view class="search-input-wrap">
        <text class="search-icon">◐</text>
        <input class="search-input" v-model="query" placeholder="搜索症状、事件、药品..." confirm-type="search"/>
        <view v-if="query != ''" class="clear-btn" @tap="query = ''"><text class="clear-text">×</text></view>
      </view>
      <view class="cancel-btn" @tap="handleBack" hover-class="btn-active"><text class="cancel-text">取消</text></view>
    </view>

    <scroll-view class="scroll-body" scroll-y="true">
      <!-- 空态 / 历史 / 结果 -->
      <view v-if="query == ''" class="empty-state">
        <text class="sec-title">最近搜索</text>
        <view class="chip-group">
          <view v-for="q in history" :key="q" class="chip" @tap="query = q">
            <text class="chip-text">{{ q }}</text>
          </view>
        </view>

        <text class="sec-title">热门话题</text>
        <view class="topic-list">
          <view v-for="(t, i) in hotTopics" :key="i" class="topic-item">
            <text class="topic-n">{{ i + 1 }}</text>
            <text class="topic-title">{{ t }}</text>
          </view>
        </view>
      </view>

      <!-- 结果 -->
      <view v-else class="results">
        <text class="result-count">找到 {{ results.length }} 条结果</text>
        <view v-for="r in results" :key="r.id" class="result-item">
          <view class="result-icon" :class="`result-icon-${r.type}`"><text class="result-icon-glyph">{{ r.icon }}</text></view>
          <view class="result-body">
            <text class="result-title">{{ r.title }}</text>
            <text class="result-desc">{{ r.desc }}</text>
          </view>
          <text class="arrow">›</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script lang="uts">
type Result = { id: string; type: string; icon: string; title: string; desc: string };
export default {
  data() {
    return {
      statusBarHeight: 44 as number,
      query: '' as string,
      history: ['呼吸频率', '沙丁胺醇', '花粉过敏', '夜间咳嗽'] as string[],
      hotTopics: [
        '如何看懂关注等级 · 绿黄红三区',
        '正确使用吸入器的 6 个步骤',
        '如何区分感冒和哮喘发作',
        '儿童哮喘常见的 8 种诱因',
        '如何和学校老师沟通哮喘情况',
      ] as string[],
      results: [
        { id: '1', type: 'record', icon: '≣', title: '关注记录 · 呼吸 36 次/分', desc: '9月3日 03:12 · 已缓解' },
        { id: '2', type: 'med',    icon: '◐', title: '沙丁胺醇气雾剂', desc: '药品库 · 缓解药 · 剩余 156 喷' },
        { id: '3', type: 'know',   icon: 'i', title: '沙丁胺醇的正确使用方法', desc: '知识科普 · 5 分钟阅读' },
        { id: '4', type: 'sym',    icon: '✎', title: '症状记录 · 咳嗽 · 喘息', desc: '9月3日 03:08 · 用药后缓解' },
      ] as Result[],
    };
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
  },
  methods: {
    handleBack() { uni.navigateBack({}); },
  },
};
</script>

<style lang="scss">
