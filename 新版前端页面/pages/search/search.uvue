.back-btn { width: 40px; height: 40px; border-radius: 20px; background: $card-2; border-width: 1px; border-style: solid; border-color: $hairline; align-items: center; justify-content: center; display: flex; flex-direction: row; margin-right: 8px; }
.back-icon { color: $ink; font-size: 24px; line-height: 24px; margin-top: -4px; }
.btn-active { opacity: 0.7; }
.search-input-wrap { flex: 1; height: 40px; padding: 0 12px; background: $card; border-width: 1px; border-style: solid; border-color: $hairline; border-radius: 20px; display: flex; flex-direction: row; align-items: center; }
.search-icon { color: $ink-3; font-size: 14px; margin-right: 6px; }
.search-input { flex: 1; font-size: 13px; color: $ink; }
.clear-btn { width: 20px; height: 20px; border-radius: 10px; background: $card-3; align-items: center; justify-content: center; display: flex; flex-direction: row; }
.clear-text { color: $ink-2; font-size: 14px; line-height: 14px; }
.cancel-btn { padding: 8px 4px 8px 10px; }
.cancel-text { color: $sun-2; font-size: 13px; font-weight: 600; }

.scroll-body { flex: 1; }
.sec-title { padding: 20px $sp-6 10px; font-size: 11px; color: $sun-2; letter-spacing: 0.14em; font-weight: 700; }
.chip-group { padding: 0 $sp-6; display: flex; flex-direction: row; flex-wrap: wrap; }
.chip { padding: 8px 14px; background: $card; border-width: 1px; border-style: solid; border-color: $hairline; border-radius: 20px; margin-right: 8px; margin-bottom: 8px; }
.chip-text { font-size: 12px; color: $ink; }

.topic-list { margin: 0 $sp-6; background: $card; border-width: 1px; border-style: solid; border-color: $hairline; border-radius: $r-md; overflow: hidden; }
.topic-item { padding: 14px 16px; display: flex; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: $hairline; }
.topic-item:last-child { border-bottom-width: 0; }
.topic-n { width: 22px; height: 22px; border-radius: 11px; background: $sun-wash; color: $sun-2; font-size: 11px; font-weight: 700; font-family: $font-num; align-items: center; justify-content: center; text-align: center; line-height: 22px; margin-right: 12px; }
.topic-title { flex: 1; font-size: 13px; color: $ink; }

.results { padding: 8px $sp-6 40px; }
.result-count { font-size: 11px; color: $ink-3; padding: 8px 0 12px; letter-spacing: 0.04em; }
.result-item { padding: 12px 14px; background: $card; border-width: 1px; border-style: solid; border-color: $hairline; border-radius: $r-md; display: flex; flex-direction: row; align-items: center; margin-bottom: 8px; }
.result-icon { width: 34px; height: 34px; border-radius: 10px; align-items: center; justify-content: center; display: flex; flex-direction: row; margin-right: 12px; }
.result-icon-record { background: linear-gradient(135deg, $sun-3, $sun-2); }
.result-icon-med { background: linear-gradient(135deg, #A2CCE8, $sky); }
.result-icon-know { background: linear-gradient(135deg, #B9DFC7, $leaf); }
.result-icon-sym { background: linear-gradient(135deg, $sun-3, $coral); }
.result-icon-glyph { color: #FFFFFF; font-size: 14px; font-weight: 700; }
.result-body { flex: 1; }
.result-title { font-size: 13px; font-weight: 600; color: $ink; letter-spacing: -0.01em; }
.result-desc { font-size: 11px; color: $ink-2; margin-top: 2px; }
.arrow { color: $ink-3; font-size: 18px; }
</style>
