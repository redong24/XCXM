<template>
  <scroll-view class="page" scroll-y="true">
    <view class="status-bar" :style="{ height: `${statusBarHeight}px` }"></view>

    <view class="page-h">
      <text class="page-title">我的</text>
    </view>

    <!-- 用户档案卡 -->
    <view class="profile-card">
      <view class="profile-halo"></view>
      <view class="profile-top">
        <view class="profile-avatar">
          <text class="profile-avatar-text">妈</text>
        </view>
        <view class="profile-info">
          <text class="profile-name">李妈妈</text>
          <text class="profile-meta">138 ···· 4926 · 已实名</text>
        </view>
        <view class="profile-arrow">
          <text class="profile-arrow-glyph">›</text>
        </view>
      </view>
      <view class="profile-stats">
        <view class="p-stat">
          <text class="p-stat-n">2</text>
          <text class="p-stat-l">照护中儿童</text>
        </view>
        <view class="p-stat p-stat-divider">
          <text class="p-stat-n">142</text>
          <text class="p-stat-l">守护天数</text>
        </view>
        <view class="p-stat p-stat-divider">
          <text class="p-stat-n">3</text>
          <text class="p-stat-l">处理关注</text>
        </view>
      </view>
    </view>

    <!-- 照护的孩子 -->
    <view class="sec-title-row">
      <text class="sec-title">照护的孩子</text>
      <text class="sec-more" @tap="openChildren">管理 →</text>
    </view>

    <view class="kids-row">
      <view
        v-for="k in kids"
        :key="k.id"
        class="kid-card"
        @tap="switchKid(k.id)"
        hover-class="kid-card-active"
      >
        <view class="kid-card-avatar" :style="{ backgroundColor: k.avatarColor }">
          <text class="kid-card-avatar-text">{{ k.name.charAt(0) }}</text>
        </view>
        <text class="kid-card-name">{{ k.name }} · {{ k.age }} 岁</text>
        <view v-if="k.id == currentKidId" class="kid-card-online">
          <view class="kid-card-online-dot"></view>
          <text class="kid-card-online-text">在线</text>
        </view>
        <text v-else class="kid-card-offline">未佩戴</text>
      </view>
      <view class="kid-card-add" @tap="addKid" hover-class="kid-card-add-active">
        <text class="kid-card-add-glyph">+</text>
        <text class="kid-card-add-text">添加</text>
      </view>
    </view>

    <!-- 监测与守护 -->
    <text class="sec-title-plain">监测与守护</text>

    <view class="list">
      <view class="list-item" @tap="nav('threshold')" hover-class="list-item-active">
        <view class="list-icon"><text class="list-icon-glyph">⚡</text></view>
        <view class="list-body">
          <text class="list-name">关注等级阈值</text>
          <text class="list-desc">心率、血氧、呼吸频率的报警区间</text>
        </view>
        <text class="list-arrow">›</text>
      </view>
      <view class="list-item" @tap="nav('plan')" hover-class="list-item-active">
        <view class="list-icon"><text class="list-icon-glyph">✓</text></view>
        <view class="list-body">
          <text class="list-name">哮喘行动计划</text>
          <text class="list-desc">绿黄红三区应对方案</text>
        </view>
        <text class="list-arrow">›</text>
      </view>
      <view class="list-item" @tap="nav('notification')" hover-class="list-item-active">
        <view class="list-icon"><text class="list-icon-glyph">◐</text></view>
        <view class="list-body">
          <text class="list-name">通知与提醒</text>
          <text class="list-desc">震动、声音、免打扰时段</text>
        </view>
        <text class="list-arrow">›</text>
      </view>
    </view>

    <!-- 账户 -->
    <text class="sec-title-plain">账户</text>

    <view class="list">
      <view class="list-item" @tap="nav('family')" hover-class="list-item-active">
        <view class="list-icon"><text class="list-icon-glyph">☺</text></view>
        <view class="list-body">
          <text class="list-name">家庭成员</text>
          <text class="list-desc">邀请爸爸、奶奶共同照护</text>
        </view>
        <text class="list-val">2 人</text>
        <text class="list-arrow">›</text>
      </view>
      <view class="list-item" @tap="nav('export')" hover-class="list-item-active">
        <view class="list-icon"><text class="list-icon-glyph">↓</text></view>
        <view class="list-body">
          <text class="list-name">数据导出</text>
          <text class="list-desc">导出监测数据 · 就诊时提供给医生</text>
        </view>
        <text class="list-arrow">›</text>
      </view>
      <view class="list-item" @tap="openPrivacy" hover-class="list-item-active">
        <view class="list-icon"><text class="list-icon-glyph">🔒</text></view>
        <view class="list-body">
          <text class="list-name">隐私与数据</text>
          <text class="list-desc">本地加密存储 · 授权管理</text>
        </view>
        <text class="list-arrow">›</text>
      </view>
      <view class="list-item" @tap="nav('about')" hover-class="list-item-active">
        <view class="list-icon"><text class="list-icon-glyph">?</text></view>
        <view class="list-body">
          <text class="list-name">帮助与关于</text>
          <text class="list-desc">使用指南 · 版本 v4.0.1</text>
        </view>
        <text class="list-arrow">›</text>
      </view>
    </view>

    <text class="disclaimer">— {{ disclaimerShort }} —</text>
    <view style="height: 90px;"></view>
  </scroll-view>
</template>

<script lang="uts">
import { getAllKids, getCurrentKid, setCurrentKid, type Kid } from '@/composables/useKid';
import { DISCLAIMER_SHORT } from '@/utils/copy';

export default {
  data() {
    return {
      statusBarHeight: 44 as number,
      kids: getAllKids() as Kid[],
      currentKidId: getCurrentKid().id as string,
      disclaimerShort: DISCLAIMER_SHORT,
    };
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
  },
  onShow() {
    this.currentKidId = getCurrentKid().id;
  },
  methods: {
    switchKid(id: string) {
      setCurrentKid(id);
      this.currentKidId = id;
      uni.showToast({ title: '已切换', icon: 'success' });
    },
    addKid() {
      uni.navigateTo({ url: '/pages/children/form' });
    },
    openChildren() {
      uni.navigateTo({ url: '/pages/children/children' });
    },
    nav(page: string) {
      const routes: Map<string, string> = new Map([
        ['threshold',    '/pages/threshold/threshold'],
        ['plan',         '/pages/plan/plan'],
        ['notification', '/pages/notification/notification'],
        ['family',       '/pages/family/family'],
        ['export',       '/pages/export/export'],
        ['about',        '/pages/about/about'],
      ]);
      const url = routes.get(page);
      if (url != null) uni.navigateTo({ url: url });
    },
    openPrivacy() {
      uni.showToast({ title: '隐私设置', icon: 'none' });
    },
  },
};
</script>

