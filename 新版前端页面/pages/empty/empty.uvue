<template>
  <view class="page">
    <view class="status-bar" :style="{ height: `${statusBarHeight}px` }"></view>

    <view class="content">
      <view class="illus">
        <view class="halo"></view>
        <view class="halo-ring"></view>
        <view class="icon-box">
          <text class="icon-glyph">○</text>
        </view>
      </view>

      <text class="title">哨兵尚未上岗</text>
      <text class="desc">给 RWFit 智能戒指通电，佩戴到孩子手上{{ '\n' }}然后回到这里开始配对</text>

      <view class="steps">
        <view class="step">
          <view class="step-n"><text class="step-n-text">1</text></view>
          <text class="step-text">给戒指充电（大约 40 分钟）</text>
        </view>
        <view class="step">
          <view class="step-n"><text class="step-n-text">2</text></view>
          <text class="step-text">打开手机蓝牙</text>
        </view>
        <view class="step">
          <view class="step-n"><text class="step-n-text">3</text></view>
          <text class="step-text">戒指戴在孩子拇指或食指</text>
        </view>
      </view>
    </view>

    <view class="bottom-area" :style="{ paddingBottom: `${safeBottom}px` }">
      <ag-button label="开始配对戒指" type="primary" @tap="handlePair"/>
      <view class="skip-btn" @tap="handleLater" hover-class="btn-active">
        <text class="skip-text">稍后再说</text>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
import AgButton from '@/components/ag-button/ag-button.uvue';
export default {
  components: { AgButton },
  data() { return { statusBarHeight: 44 as number, safeBottom: 30 as number }; },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
    this.safeBottom = (info.safeAreaInsets?.bottom ?? 20) + 20;
  },
  methods: {
    handlePair() { uni.navigateTo({ url: '/pages/pair/pair' }); },
    handleLater() { uni.reLaunch({ url: '/pages/home/home' }); },
  },
};
</script>

