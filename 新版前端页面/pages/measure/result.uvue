<template>
  <scroll-view class="page" scroll-y="true">
    <view class="status-bar" :style="{ height: `${statusBarHeight}px` }"></view>

    <view class="header">
      <view class="back-btn" @tap="handleBack" hover-class="back-btn-active">
        <text class="back-icon">‹</text>
      </view>
      <text class="header-title">测量结果</text>
      <view class="placeholder-40"></view>
    </view>

    <!-- 完成 icon + 标题 -->
    <view class="success-hero">
      <view class="success-icon">
        <text class="success-icon-glyph">✓</text>
      </view>
      <text class="success-title">测量完成</text>
      <text class="success-time">{{ kid.name }} · {{ measureTime }}</text>
    </view>

    <!-- Zone tag -->
    <view class="zone-tag-wrap">
      <view class="zone-tag">
        <view class="zone-dot"></view>
        <text class="zone-tag-text">绿色区 · 全部数值正常</text>
      </view>
    </view>

    <!-- 4 项指标 grid -->
    <view class="metrics-grid">
      <view class="metric-card">
        <view class="metric-top">
          <view class="metric-icon metric-icon-br">
            <text class="metric-icon-glyph">≋</text>
          </view>
          <text class="metric-label">呼吸频率</text>
        </view>
        <view class="metric-val-row">
          <text class="metric-val">{{ reading.breath }}</text>
          <text class="metric-unit">次/分</text>
        </view>
        <text class="metric-cmp">↗ 参考区间 20-30</text>
      </view>

      <view class="metric-card">
        <view class="metric-top">
          <view class="metric-icon metric-icon-hr">
            <text class="metric-icon-glyph">♥</text>
          </view>
          <text class="metric-label">心率</text>
        </view>
        <view class="metric-val-row">
          <text class="metric-val">{{ reading.hr }}</text>
          <text class="metric-unit">bpm</text>
        </view>
        <text class="metric-cmp">↗ 平稳 · 窦性</text>
      </view>

      <view class="metric-card">
        <view class="metric-top">
          <view class="metric-icon metric-icon-spo2">
            <text class="metric-icon-glyph">◐</text>
          </view>
          <text class="metric-label">血氧</text>
        </view>
        <view class="metric-val-row">
          <text class="metric-val">{{ reading.spo2 }}</text>
          <text class="metric-unit">%</text>
        </view>
        <text class="metric-cmp">↗ ≥ 95 · 正常</text>
      </view>

      <view class="metric-card">
        <view class="metric-top">
          <view class="metric-icon metric-icon-hrv">
            <text class="metric-icon-glyph">≡</text>
          </view>
          <text class="metric-label">HRV</text>
        </view>
        <view class="metric-val-row">
          <text class="metric-val">{{ reading.hrv }}</text>
          <text class="metric-unit">ms</text>
        </view>
        <text class="metric-cmp">↗ 良好</text>
      </view>
    </view>

    <!-- 观察建议卡 -->
    <view class="insight-card">
      <view class="insight-icon">
        <text class="insight-icon-glyph">i</text>
      </view>
      <view class="insight-body">
        <text class="insight-title">今日观察</text>
        <text class="insight-desc">
          所有数值均在参考区间内。呼吸频率相比 3 天前的平均值（24 次/分）略有下降，属于正常波动。
        </text>
      </view>
    </view>

    <text class="disclaimer">健康参考，非医疗建议 · 如症状持续请及时就医</text>

    <view style="height: 130px;"></view>
  </scroll-view>

  <!-- 底部按钮 -->
  <view class="bottom-actions" :style="{ paddingBottom: `${safeBottom}px` }">
    <view class="btn-secondary" @tap="logSymptom" hover-class="btn-active">
      <text class="btn-secondary-text">记录症状</text>
    </view>
    <view class="btn-primary" @tap="handleDone" hover-class="btn-active">
      <text class="btn-primary-text">完成</text>
    </view>
  </view>
</template>

<script lang="uts">
import { getCurrentKid } from '@/composables/useKid';
import { getLatestReading, type RingReading } from '@/composables/useRing';
import { fmtDateTime } from '@/utils/format';

export default {
  data() {
    return {
      statusBarHeight: 44 as number,
      safeBottom: 30 as number,
      kid: getCurrentKid(),
      reading: getLatestReading() as RingReading,
      measureTime: fmtDateTime(Date.now()) as string,
    };
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
    this.safeBottom = (info.safeAreaInsets?.bottom ?? 20) + 10;
  },
  methods: {
    handleBack() { uni.navigateBack({}); },
    logSymptom() {
      uni.navigateTo({ url: '/pages/symptom/symptom' });
    },
    handleDone() {
      uni.reLaunch({ url: '/pages/home/home' });
    },
  },
};
</script>

