  width: 100%;
  height: 100vh;
  background: $paper;
  background-image:
    radial-gradient(70% 45% at 50% 15%, rgba(255, 181, 71, 0.28) 0%, transparent 65%),
    radial-gradient(50% 40% at 20% 30%, rgba(255, 131, 103, 0.10) 0%, transparent 55%);
  display: flex;
  flex-direction: column;
}
