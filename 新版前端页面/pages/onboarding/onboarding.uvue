  position: absolute;
  top: 60px;
  right: 22px;
  padding: 6px 12px;
  z-index: 10;
}
.skip-btn-active { opacity: 0.7; }
.skip-text {
  color: $ink-3;
  font-size: 12px;
}

.step-dots {
  padding: 20px 0;
  display: flex;
  flex-direction: row;
  justify-content: center;
}
.dot {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  background: $card-3;
  margin: 0 3px;
}
.dot-active {
  width: 26px;
  background-image: linear-gradient(90deg, $sun-1, $sun-2);
  border-radius: 4px;
}

.content {
  flex: 1;
  padding: 30px 32px 0;
  align-items: center;
  display: flex;
  flex-direction: column;
}

.illustration {
  width: 240px;
  height: 240px;
  align-items: center;
  justify-content: center;
  display: flex;
  flex-direction: row;
  position: relative;
  margin-bottom: 40px;
}
.halo {
  position: absolute;
  width: 240px;
  height: 240px;
  border-radius: 120px;
  background: radial-gradient(circle,
    rgba(255, 143, 50, 0.28) 0%,
    rgba(255, 131, 103, 0.12) 45%,
    transparent 70%);
}
.halo-ring {
  position: absolute;
  border-radius: 100px;
  border-width: 1.5px;
  border-style: solid;
  border-color: $sun-1;
  opacity: 0.4;
}
.halo-ring-1 { width: 200px; height: 200px; opacity: 0.5; }
.halo-ring-2 { width: 170px; height: 170px; opacity: 0.35; }
.halo-ring-3 { width: 140px; height: 140px; opacity: 0.2; }

.illus-icon {
  width: 110px;
  height: 110px;
  border-radius: 55px;
  background-image: linear-gradient(135deg, $sun-1, $sun-2);
  align-items: center;
  justify-content: center;
  display: flex;
  flex-direction: row;
  box-shadow: 0 12px 30px rgba(245, 143, 50, 0.4);
  z-index: 5;
}
.illus-glyph {
  color: #FFFFFF;
  font-size: 52px;
  font-weight: 700;
  line-height: 52px;
}

.onboard-title {
  font-size: 26px;
  font-weight: 700;
  color: $ink;
  letter-spacing: -0.02em;
  line-height: 34px;
  text-align: center;
}
.onboard-desc {
  font-size: 14px;
  color: $ink-2;
  line-height: 22px;
  margin-top: 14px;
  text-align: center;
}

.bottom-area {
  padding: 20px 24px 0;
}
</style>
