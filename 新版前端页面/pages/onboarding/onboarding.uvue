<template>
  <view class="page">
    <view class="status-bar" :style="{ height: `${statusBarHeight}px` }"></view>

    <!-- 跳过 -->
    <view class="skip-btn" @tap="handleSkip" hover-class="skip-btn-active">
      <text class="skip-text">跳过</text>
    </view>

    <!-- 步骤指示 dots -->
    <view class="step-dots">
      <view v-for="i in 3" :key="i" class="dot" :class="{ 'dot-active': currentStep == i }"></view>
    </view>

    <!-- 内容区（根据 step 切换）-->
    <view class="content">
      <!-- Illustration -->
      <view class="illustration">
        <view class="halo"></view>
        <view class="halo-ring halo-ring-1"></view>
        <view class="halo-ring halo-ring-2"></view>
        <view class="halo-ring halo-ring-3"></view>
        <view class="illus-icon" :class="`illus-icon-${currentStep}`">
          <text class="illus-glyph">{{ steps[currentStep - 1].icon }}</text>
        </view>
      </view>

      <text class="onboard-title">
        {{ steps[currentStep - 1].title }}
      </text>
      <text class="onboard-desc">
        {{ steps[currentStep - 1].desc }}
      </text>
    </view>

    <!-- 底部按钮 -->
    <view class="bottom-area" :style="{ paddingBottom: `${safeBottom}px` }">
      <ag-button
        :label="currentStep < 3 ? '继续' : '开始使用'"
        type="primary"
        @tap="handleNext"
      />
    </view>
  </view>
</template>

<script lang="uts">
import AgButton from '@/components/ag-button/ag-button.uvue';

type StepContent = {
  icon: string;
  title: string;
  desc: string;
};

export default {
  components: { AgButton },
  data() {
    return {
      statusBarHeight: 44 as number,
      safeBottom: 30 as number,
      currentStep: 1 as number,
      steps: [
        {
          icon: '◐',
          title: '这个 App\n是你的哨兵',
          desc: '它替你守护孩子的呼吸\n你只在真正需要时被叫醒',
        },
        {
          icon: '≋',
          title: '实时监测\n呼吸、心率、血氧',
          desc: 'RWFit 智能戒指 24 小时采集\n数据本地加密存储',
        },
        {
          icon: '!',
          title: '关注等级\n绿黄红三区',
          desc: '按医生定制的行动计划应对\n免打扰时段红色仍强制响铃',
        },
      ] as StepContent[],
    };
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
    this.safeBottom = (info.safeAreaInsets?.bottom ?? 20) + 20;
  },
  methods: {
    handleNext() {
      if (this.currentStep < 3) {
        this.currentStep += 1;
      } else {
        // 完成引导 → 进入权限授予
        uni.setStorageSync('ag_onboarded', true);
        uni.reLaunch({ url: '/pages/permission/permission' });
      }
    },
    handleSkip() {
      uni.setStorageSync('ag_onboarded', true);
      uni.reLaunch({ url: '/pages/permission/permission' });
    },
  },
};
</script>

<style lang="scss">
