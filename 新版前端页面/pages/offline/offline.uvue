<template>
  <scroll-view class="page" scroll-y="true">
    <view class="status-bar" :style="{ height: `${statusBarHeight}px` }"></view>

    <view class="header">
      <view class="back-btn" @tap="handleBack" hover-class="back-btn-active">
        <text class="back-icon">‹</text>
      </view>
      <text class="header-title">戒指离线</text>
      <view class="placeholder-40"></view>
    </view>

    <!-- 警示 icon + 呼吸波纹 -->
    <view class="warn-hero">
      <view class="warn-icon-wrap">
        <view class="warn-ripple warn-ripple-1"></view>
        <view class="warn-ripple warn-ripple-2"></view>
        <view class="warn-icon">
          <text class="warn-icon-glyph">◐</text>
        </view>
      </view>

      <view class="warn-tag">
        <view class="warn-tag-dot"></view>
        <text class="warn-tag-text">哨兵已离岗</text>
      </view>

      <text class="warn-title">戒指已断开连接</text>
      <text class="warn-desc">
        {{ kid.name }}的 RWFit R2 已<text class="warn-highlight">离线 {{ offlineDuration }}</text>{{ '\n' }}重新连接以恢复守护
      </text>
    </view>

    <!-- 状态详情卡 -->
    <view class="status-card">
      <view class="status-row">
        <text class="status-label">设备</text>
        <text class="status-value">RWFit R2 · {{ kid.name }}</text>
      </view>
      <view class="status-row status-row-divider">
        <text class="status-label">最后信号</text>
        <text class="status-value status-value-mono">{{ lastSignalTime }} · {{ offlineDuration }}前</text>
      </view>
      <view class="status-row status-row-divider">
        <text class="status-label">最后位置</text>
        <text class="status-value">向阳花幼儿园附近</text>
      </view>
      <view class="status-row status-row-divider">
        <text class="status-label">最后电量</text>
        <view class="status-value-row">
          <view class="status-dot"></view>
          <text class="status-value-warn">18% · 电量不足</text>
        </view>
      </view>
    </view>

    <!-- 可能原因 -->
    <view class="tips-card">
      <text class="tips-head">可能原因</text>
      <view class="tip-item">
        <view class="tip-dot"></view>
        <text class="tip-text">戒指电量耗尽，需要充电</text>
      </view>
      <view class="tip-item">
        <view class="tip-dot"></view>
        <text class="tip-text">与手机距离超过 10 米</text>
      </view>
      <view class="tip-item">
        <view class="tip-dot"></view>
        <text class="tip-text">戒指被摘下或脱落</text>
      </view>
    </view>

    <view style="height: 130px;"></view>
  </scroll-view>

  <!-- 底部按钮 -->
  <view class="bottom-actions" :style="{ paddingBottom: `${safeBottom}px` }">
    <ag-button label="重新连接" type="primary" @tap="handleReconnect" />
    <view class="cancel-btn" @tap="handleBack" hover-class="cancel-btn-active">
      <text class="cancel-text">我知道了 · 稍后再连</text>
    </view>
  </view>
</template>

<script lang="uts">
import { getCurrentKid } from '@/composables/useKid';
import AgButton from '@/components/ag-button/ag-button.uvue';

export default {
  components: { AgButton },
  data() {
    return {
      statusBarHeight: 44 as number,
      safeBottom: 30 as number,
      kid: getCurrentKid(),
      lastSignalTime: '09:29' as string,
      offlineDuration: '12 分钟' as string,
    };
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
    this.safeBottom = (info.safeAreaInsets?.bottom ?? 20) + 10;
  },
  methods: {
    handleBack() { uni.navigateBack({}); },
    handleReconnect() {
      uni.showLoading({ title: '连接中...' });
      setTimeout(() => {
        uni.hideLoading();
        uni.showToast({ title: '已重新连接', icon: 'success' });
        setTimeout(() => uni.navigateBack({}), 800);
      }, 2000);
    },
  },
};
</script>

