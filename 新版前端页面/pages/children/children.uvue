  width: 40px;
  height: 40px;
  border-radius: 20px;
  background: $card-2;
  border-width: 1px;
  border-style: solid;
  border-color: $hairline;
  align-items: center;
  justify-content: center;
  display: flex;
  flex-direction: row;
}
.back-btn-active { opacity: 0.7; }
.back-icon {
  color: $ink;
  font-size: 24px;
  line-height: 24px;
  margin-top: -4px;
}
.header-title {
  color: $ink;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: -0.01em;
}
.placeholder-40 { width: 40px; }

