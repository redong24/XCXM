  border-width: 1px;
  border-style: solid;
  border-color: $sun-wash;
  align-items: center;
  justify-content: center;
  display: flex;
  flex-direction: row;
  margin-bottom: 10px;
  box-shadow: 0 3px 10px rgba(245, 143, 50, 0.15);
}
.add-plus-text {
  color: $sun-2;
