  display: flex;
  flex-direction: row;
  align-items: center;
}
.name {
  font-size: 18px;
  font-weight: 700;
  color: $ink;
  letter-spacing: -0.01em;
  margin-right: 8px;
}
.active-tag {
  padding: 3px 8px;
  background: $sun-wash;
  border-radius: 10px;
}
.active-tag-text {
  color: $sun-2;
  font-size: 9px;
  font-weight: 700;
