<template>
  <scroll-view class="page" scroll-y="true">
    <view class="status-bar" :style="{ height: `${statusBarHeight}px` }"></view>

    <view class="header">
      <view class="back-btn" @tap="handleBack" hover-class="back-btn-active">
        <text class="back-icon">‹</text>
      </view>
      <text class="header-title">照护的孩子</text>
      <view class="placeholder-40"></view>
    </view>

    <!-- 儿童卡列表 -->
    <view
      v-for="k in kids"
      :key="k.id"
      class="kid-card"
      :class="{ 'kid-card-active': k.id == currentKidId }"
    >
      <view class="card-top">
        <view class="avatar" :style="{ backgroundColor: k.avatarColor }">
          <text class="avatar-text">{{ k.name.charAt(0) }}</text>
        </view>
        <view class="info">
          <view class="name-row">
            <text class="name">{{ k.name }}</text>
            <view v-if="k.id == currentKidId" class="active-tag">
              <text class="active-tag-text">当前守护</text>
            </view>
          </view>
          <text class="meta">{{ k.age }} 岁 · {{ k.gender == 'F' ? '女' : '男' }} · {{ k.asthmaType }}</text>
        </view>
      </view>

      <view class="status-line">
        <view class="stat">
          <text class="stat-l">RWFit 状态</text>
          <view class="stat-v-row">
            <view class="stat-dot stat-dot-ok"></view>
            <text class="stat-v stat-v-ok">已连接</text>
          </view>
        </view>
        <view class="stat">
          <text class="stat-l">当前区间</text>
          <text class="stat-v stat-v-ok">绿色区</text>
        </view>
        <view class="stat">
          <text class="stat-l">电量</text>
          <text class="stat-v stat-v-num">76%</text>
        </view>
      </view>

      <view class="actions">
        <view class="btn-ghost" @tap="editKid(k.id)" hover-class="btn-active">
          <text class="btn-ghost-text">编辑档案</text>
        </view>
        <view class="btn-primary" @tap="switchKid(k.id)" hover-class="btn-active">
          <text class="btn-primary-text">{{ k.id == currentKidId ? '查看哨兵' : '切换守护' }}</text>
        </view>
      </view>
    </view>

    <!-- 添加卡 -->
    <view class="add-card" @tap="addKid" hover-class="add-card-active">
      <view class="add-plus">
        <text class="add-plus-text">+</text>
      </view>
      <text class="add-name">添加孩子</text>
      <text class="add-desc">最多可添加 5 个照护对象</text>
    </view>

    <text class="disclaimer">— {{ disclaimerShort }} —</text>
    <view style="height: 40px;"></view>
  </scroll-view>
</template>

<script lang="uts">
import { getAllKids, getCurrentKid, setCurrentKid, type Kid } from '@/composables/useKid';
import { DISCLAIMER_SHORT } from '@/utils/copy';

export default {
  data() {
    return {
      statusBarHeight: 44 as number,
      kids: getAllKids() as Kid[],
      currentKidId: getCurrentKid().id as string,
      disclaimerShort: DISCLAIMER_SHORT,
    };
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
  },
  methods: {
    handleBack() { uni.navigateBack({}); },
    switchKid(id: string) {
      if (id == this.currentKidId) {
        uni.reLaunch({ url: '/pages/home/home' });
      } else {
        setCurrentKid(id);
        this.currentKidId = id;
        uni.showToast({ title: '已切换守护', icon: 'success' });
      }
    },
    editKid(id: string) {
      uni.navigateTo({ url: '/pages/children/form' });
    },
    addKid() {
      uni.navigateTo({ url: '/pages/children/form' });
    },
  },
};
</script>

<style lang="scss">
