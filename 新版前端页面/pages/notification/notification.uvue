<script lang="uts">
import { DISCLAIMER_SHORT } from '@/utils/copy';

export default {
  data() {
    return {
      statusBarHeight: 44 as number,
      alertRed: true as boolean,       // 不可关闭
      alertYellow: true as boolean,
      medReminder: true as boolean,
      ringStatus: true as boolean,
      locationAlert: false as boolean,
      weeklyReport: true as boolean,
      dndEnabled: true as boolean,
      dndStart: '22:30' as string,
      dndEnd: '07:00' as string,
      disclaimerShort: DISCLAIMER_SHORT,
    };
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
  },
  methods: {
    handleBack() { uni.navigateBack({}); },
  },
};
</script>

