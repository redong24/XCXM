<template>
  <scroll-view class="page" scroll-y="true">
    <view class="status-bar" :style="{ height: `${statusBarHeight}px` }"></view>

    <view class="header">
      <view class="back-btn" @tap="handleBack" hover-class="btn-active"><text class="back-icon">‹</text></view>
      <text class="header-title">知识科普</text>
      <view class="placeholder-40"></view>
    </view>

    <!-- Featured 卡 -->
    <view class="featured">
      <view class="featured-halo"></view>
      <view class="featured-body">
        <text class="featured-tag">编辑推荐</text>
        <text class="featured-title">看懂关注等级{{ '\n' }}绿黄红三区如何工作</text>
        <text class="featured-meta">5 分钟阅读 · 张医生 审核</text>
        <view class="featured-cta">
          <text class="featured-cta-text">开始阅读 →</text>
        </view>
      </view>
    </view>

    <!-- 分类 -->
    <view class="cat-tabs">
      <view v-for="c in categories" :key="c" class="cat-tab" :class="{ 'cat-tab-active': cat == c }" @tap="cat = c">
        <text class="cat-text" :class="{ 'cat-text-active': cat == c }">{{ c }}</text>
      </view>
    </view>

    <!-- 文章列表 -->
    <view v-for="a in articles" :key="a.id" class="article-item" @tap="openArticle(a.id)" hover-class="article-active">
      <view class="article-thumb" :class="`article-thumb-${a.color}`">
        <text class="article-thumb-glyph">{{ a.icon }}</text>
      </view>
      <view class="article-body">
        <text class="article-title">{{ a.title }}</text>
        <text class="article-preview">{{ a.preview }}</text>
        <view class="article-meta">
          <text class="article-tag" :class="`article-tag-${a.color}`">{{ a.category }}</text>
          <text class="article-time">{{ a.readTime }} · {{ a.author }}</text>
        </view>
      </view>
    </view>

    <view style="height: 40px;"></view>
  </scroll-view>
</template>

<script lang="uts">
type Article = { id: string; title: string; preview: string; icon: string; color: string;
  category: string; readTime: string; author: string };
export default {
  data() {
    return {
      statusBarHeight: 44 as number,
      categories: ['全部', '基础知识', '用药指南', '生活护理', '急救'] as string[],
      cat: '全部' as string,
      articles: [
        { id: '1', title: '正确使用吸入器的 6 个步骤',
          preview: '大约 30% 的孩子会误用吸入器 · 掌握这几步大幅提升用药效果...',
          icon: '◐', color: 'sky', category: '用药指南', readTime: '4 分钟', author: '李药师' },
        { id: '2', title: '如何区分感冒和哮喘发作',
          preview: '两者症状相似但处理完全不同 · 5 个关键差异帮你快速判断...',
          icon: '?', color: 'sun', category: '基础知识', readTime: '6 分钟', author: '张医生' },
        { id: '3', title: '春季花粉季 · 8 个防护技巧',
          preview: '花粉浓度早晨最高 · 出门戴口罩、及时洗鼻...',
          icon: '≋', color: 'leaf', category: '生活护理', readTime: '5 分钟', author: '陈护士' },
        { id: '4', title: '孩子哮喘发作时 · 家长该怎么做',
          preview: '保持镇定 · 让孩子端坐 · 立即使用缓解药 · 观察 15 分钟...',
          icon: '!', color: 'red', category: '急救', readTime: '3 分钟', author: '急诊科' },
      ] as Article[],
    };
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
  },
  methods: {
    handleBack() { uni.navigateBack({}); },
    openArticle(id: string) { uni.showToast({ title: '打开文章 ' + id, icon: 'none' }); },
  },
};
</script>

