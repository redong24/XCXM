.article-active { opacity: 0.9; }
.article-thumb { width: 60px; height: 60px; border-radius: 12px; align-items: center; justify-content: center; display: flex; flex-direction: row; margin-right: 12px; }
.article-thumb-sun { background: linear-gradient(135deg, $sun-3, $sun-2); }
.article-thumb-sky { background: linear-gradient(135deg, #A2CCE8, $sky); }
