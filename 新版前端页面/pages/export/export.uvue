<template>
  <scroll-view class="page" scroll-y="true">
    <view class="status-bar" :style="{ height: `${statusBarHeight}px` }"></view>

    <view class="header">
      <view class="back-btn" @tap="handleBack" hover-class="back-btn-active">
        <text class="back-icon">‹</text>
      </view>
      <text class="header-title">导出就诊报告</text>
      <view class="placeholder-40"></view>
    </view>

    <!-- 报告预览卡（模拟 PDF 封面）-->
    <view class="report-card">
      <view class="report-halo"></view>
      <view class="report-head">
        <text class="report-lbl">AsthmaGuard · Medical Report</text>
        <text class="report-title">{{ kid.name }} · 哮喘监测报告</text>
        <text class="report-range">2026 年 6 月 1 日 – 2026 年 9 月 3 日 · 共 94 天</text>
      </view>
      <view class="report-info-grid">
        <view class="info-cell">
          <text class="info-l">姓名 · 性别 · 年龄</text>
          <text class="info-v">{{ kid.name }} · {{ kid.gender == 'F' ? '女' : '男' }} · {{ kid.age }} 岁</text>
        </view>
        <view class="info-cell">
          <text class="info-l">哮喘类型</text>
          <text class="info-v">{{ kid.asthmaType }}</text>
        </view>
        <view class="info-cell">
          <text class="info-l">监测总天数</text>
          <text class="info-v info-v-mono">94 天</text>
        </view>
        <view class="info-cell">
          <text class="info-l">关注事件</text>
          <view class="info-v-row">
            <text class="info-v-red">1</text>
            <text class="info-v-text"> 红 · </text>
            <text class="info-v-warn">3</text>
            <text class="info-v-text"> 黄</text>
          </view>
        </view>
      </view>
      <view class="report-metrics">
        <text class="report-metrics-title">数值摘要</text>
        <view class="report-metrics-row">
          <view class="metric-mini">
            <text class="metric-mini-n">24</text>
            <text class="metric-mini-l">呼吸均值 · 次/分</text>
          </view>
          <view class="metric-mini">
            <text class="metric-mini-n">97.8</text>
            <text class="metric-mini-l">血氧均值 · %</text>
          </view>
          <view class="metric-mini">
            <text class="metric-mini-n">98</text>
            <text class="metric-mini-l">心率均值 · bpm</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 包含内容 -->
    <text class="sec-title">包含内容</text>
    <view class="list">
      <view class="list-item" v-for="(opt, idx) in includeOpts" :key="opt.key">
        <view class="list-icon"><text class="list-icon-glyph">{{ opt.icon }}</text></view>
        <view class="list-body">
          <text class="list-name">{{ opt.name }}</text>
          <text class="list-desc">{{ opt.desc }}</text>
        </view>
        <view class="toggle" :class="{ 'toggle-off': !opt.on }" @tap="opt.on = !opt.on">
          <view class="toggle-thumb"></view>
        </view>
      </view>
    </view>

    <!-- 时间范围 + 格式 -->
    <text class="sec-title">时间范围</text>
    <view class="list">
      <view class="list-item">
        <view class="list-body">
          <text class="list-name">最近</text>
        </view>
        <text class="list-val">3 个月</text>
        <text class="list-arrow">›</text>
      </view>
      <view class="list-item">
        <view class="list-body">
          <text class="list-name">格式</text>
        </view>
        <text class="list-val">PDF · 打印友好</text>
        <text class="list-arrow">›</text>
      </view>
    </view>

    <!-- 建议 -->
    <view class="tip-card">
      <text class="tip-text">
        <text class="tip-bold">建议</text>：就诊时打印 PDF 或 AirDrop 给医生 · 帮助医生了解居家监测情况
      </text>
    </view>

    <view style="height: 120px;"></view>
  </scroll-view>

  <!-- 底部导出按钮 -->
  <view class="bottom-action" :style="{ paddingBottom: `${safeBottom}px` }">
    <view class="cta-primary" @tap="handleExport" hover-class="cta-primary-active">
      <view class="cta-ic">
        <text class="cta-ic-glyph">↓</text>
      </view>
      <view class="cta-body">
        <text class="cta-t">生成并导出报告</text>
        <text class="cta-s">大约 5 秒 · 约 320 KB</text>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
import { getCurrentKid } from '@/composables/useKid';

type IncludeOpt = {
  key: string;
  icon: string;
  name: string;
  desc: string;
  on: boolean;
};

export default {
  data() {
    return {
      statusBarHeight: 44 as number,
      safeBottom: 30 as number,
      kid: getCurrentKid(),
      includeOpts: [
        { key: 'trend',  icon: '≣', name: '监测数值趋势', desc: '呼吸 · 心率 · 血氧 · HRV 全时段', on: true },
        { key: 'alert',  icon: '!', name: '关注等级事件', desc: '全部红/黄色关注 · 触发时间 · 处理记录', on: true },
        { key: 'med',    icon: '◐', name: '用药记录',    desc: '缓解 · 维持 · 控制药物使用日志',   on: true },
        { key: 'symp',   icon: '✎', name: '症状手动记录', desc: '咳嗽、喘息、发作诱因等',        on: false },
      ] as IncludeOpt[],
    };
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
    this.safeBottom = (info.safeAreaInsets?.bottom ?? 20) + 10;
  },
  methods: {
    handleBack() { uni.navigateBack({}); },
    handleExport() {
      uni.showLoading({ title: '生成报告中...' });
      setTimeout(() => {
        uni.hideLoading();
        uni.showToast({ title: '已导出到相册', icon: 'success' });
      }, 2000);
    },
  },
};
</script>

