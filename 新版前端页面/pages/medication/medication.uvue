<template>
  <scroll-view class="page" scroll-y="true">
    <view class="status-bar" :style="{ height: `${statusBarHeight}px` }"></view>

    <view class="header">
      <view class="back-btn" @tap="handleBack" hover-class="back-btn-active">
        <text class="back-icon">‹</text>
      </view>
      <text class="header-title">药品库</text>
      <view class="add-btn" @tap="handleAdd" hover-class="add-btn-active">
        <text class="add-icon">+</text>
      </view>
    </view>

    <!-- 顶部统计 -->
    <view class="summary-row">
      <view class="summary-cell">
        <text class="summary-n">3</text>
        <text class="summary-l">在用药品</text>
      </view>
      <view class="summary-cell">
        <text class="summary-n summary-n-warn">4</text>
        <text class="summary-l">本周用药次数</text>
      </view>
      <view class="summary-cell">
        <text class="summary-n summary-n-red">12</text>
        <text class="summary-l">天后过期</text>
      </view>
    </view>

    <!-- 药品卡列表 -->
    <view
      v-for="med in medications"
      :key="med.id"
      class="med-card"
      :class="{ 'med-card-active': med.active }"
    >
      <view class="med-top">
        <view class="pill-icon" :class="`pill-icon-${med.type}`">
          <text class="pill-icon-glyph">{{ med.icon }}</text>
        </view>
        <view class="med-info">
          <view class="med-name-row">
            <text class="med-name">{{ med.name }}</text>
            <view class="type-tag" :class="`type-tag-${med.type}`">
              <text class="type-tag-text" :class="`type-tag-text-${med.type}`">{{ med.typeLabel }}</text>
            </view>
          </view>
          <text class="med-brand">{{ med.brand }}</text>
        </view>
      </view>
      <view class="med-details">
        <view class="detail-cell">
          <text class="detail-l">单次剂量</text>
          <view class="detail-v-row">
            <text class="detail-v">{{ med.dose }}</text>
            <text class="detail-vu">{{ med.doseUnit }}</text>
          </view>
        </view>
        <view class="detail-cell">
          <text class="detail-l">{{ med.freqLabel }}</text>
          <text class="detail-v-text">{{ med.freq }}</text>
        </view>
        <view class="detail-cell">
          <text class="detail-l">剩余</text>
          <view class="detail-v-row">
            <text class="detail-v" :class="{ 'detail-v-warn': med.remainingLow }">{{ med.remaining }}</text>
            <text class="detail-vu">{{ med.remainingUnit }}</text>
          </view>
        </view>
      </view>
      <view v-if="med.lastUsed != ''" class="med-last-used">
        <text class="med-last-icon">⏱</text>
        <text class="med-last-text">{{ med.lastUsed }}</text>
      </view>
    </view>

    <text class="disclaimer">药品剂量请严格遵医嘱 · 本记录仅供参考</text>
    <view style="height: 40px;"></view>
  </scroll-view>
</template>

<script lang="uts">
type Medication = {
  id: string;
  name: string;
  brand: string;
  type: 'rescue' | 'maintain' | 'controller';
  typeLabel: string;
  icon: string;
  dose: string;
  doseUnit: string;
  freqLabel: string;
  freq: string;
  remaining: string;
  remainingUnit: string;
  remainingLow: boolean;
  active: boolean;
  lastUsed: string;
};

export default {
  data() {
    return {
      statusBarHeight: 44 as number,
      medications: [
        {
          id: 'm1',
          name: '沙丁胺醇气雾剂',
          brand: 'Salbutamol · 100μg / 喷 · 万托林',
          type: 'rescue',
          typeLabel: '缓解',
          icon: '↯',
          dose: '2',
          doseUnit: '喷',
          freqLabel: '最小间隔',
          freq: '20 分钟',
          remaining: '156',
          remainingUnit: '喷',
          remainingLow: false,
          active: true,
          lastUsed: '最近使用 · 9 月 1 日 03:15 · 关注等级触发 · 2 喷',
        },
        {
          id: 'm2',
          name: '布地奈德吸入剂',
          brand: 'Budesonide · 100μg / 泵 · 普米克令舒',
          type: 'maintain',
          typeLabel: '维持',
          icon: '◐',
          dose: '1',
          doseUnit: '泵',
          freqLabel: '使用频率',
          freq: '每日 2 次',
          remaining: '42',
          remainingUnit: '泵',
          remainingLow: false,
          active: false,
          lastUsed: '今晚 20:00 · 下次维持治疗',
        },
        {
          id: 'm3',
          name: '孟鲁司特钠',
          brand: 'Montelukast · 4mg / 片 · 顺尔宁',
          type: 'controller',
          typeLabel: '控制',
          icon: '✓',
          dose: '1',
          doseUnit: '片',
          freqLabel: '使用频率',
          freq: '睡前',
          remaining: '6',
          remainingUnit: '天',
          remainingLow: true,
          active: false,
          lastUsed: '',
        },
      ] as Medication[],
    };
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
  },
  methods: {
    handleBack() { uni.navigateBack({}); },
    handleAdd() { uni.showToast({ title: '添加药品', icon: 'none' }); },
  },
};
</script>

