}
.battery-value {
  font-family: $font-num;
  font-size: 22px;
  font-weight: 600;
  color: $ink;
  letter-spacing: -0.02em;
  line-height: 22px;
}
.battery-unit {
  font-size: 12px;
  color: $ink-2;
