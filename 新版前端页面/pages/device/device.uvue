  font-size: 22px;
  font-weight: 700;
  color: $ink;
  letter-spacing: -0.02em;
  margin-top: 8px;
}
.device-sub {
  font-size: 12px;
  color: $ink-2;
  margin-top: 3px;
}
.conn-tag {
  margin-top: 10px;
  padding: 4px 12px;
  border-radius: 20px;
  background: $leaf-wash;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.conn-tag-off {
  background: rgba(156, 139, 114, 0.14);
}
.conn-tag-dot {
  width: 5px;
  height: 5px;
  border-radius: 3px;
  background: $leaf;
  margin-right: 5px;
}
.conn-tag-off .conn-tag-dot { background: $ink-3; }
.conn-tag-text {
  font-size: 10px;
  color: $leaf;
  font-weight: 700;
  letter-spacing: 0.16em;
}
.conn-tag-off .conn-tag-text { color: $ink-3; }

/* Battery */
.battery-card {
  margin: 22px $sp-6 0;
  padding: 18px 20px;
  background: $card;
  border-radius: $r-md;
  border-width: 1px;
  border-style: solid;
  border-color: $hairline;
}
.battery-top {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10px;
}
.battery-label {
  font-size: 11px;
  color: $ink-2;
  letter-spacing: 0.06em;
  font-weight: 500;
}
