<template>
  <scroll-view class="page" scroll-y="true">
    <view class="status-bar" :style="{ height: `${statusBarHeight}px` }"></view>

    <view class="page-h">
      <text class="page-title">戒指设备</text>
    </view>

    <!-- 戒指展示 -->
    <view class="device-hero">
      <view class="device-halo"></view>
      <image
        class="device-img"
        :src="ringStatus.connected ? '/static/icons/ring-lg.png' : '/static/icons/ring-lg-idle.png'"
        mode="aspectFit"
      />
      <text class="device-model">{{ ringStatus.model }}</text>
      <text class="device-sub">{{ kid.name }} 的戒指 · SN {{ ringStatus.serialNumber }}</text>
      <view class="conn-tag" :class="{ 'conn-tag-off': !ringStatus.connected }">
        <view class="conn-tag-dot"></view>
        <text class="conn-tag-text">{{ ringStatus.connected ? '已连接' : '未连接' }}</text>
      </view>
    </view>

    <!-- 电量卡 -->
    <view class="battery-card">
      <view class="battery-top">
        <text class="battery-label">电量</text>
        <view class="battery-value-row">
          <text class="battery-value">{{ ringStatus.battery }}</text>
          <text class="battery-unit">%</text>
        </view>
      </view>
      <view class="battery-bar">
        <view class="battery-fill" :style="{ width: `${ringStatus.battery}%` }"></view>
      </view>
      <text class="battery-est">预计续航 · 约 1 天 8 小时 · 上次充电 9 月 2 日</text>
    </view>

    <!-- 信号 + 同步 -->
    <view class="status-row">
      <view class="status-cell">
        <view class="status-cell-top">
          <view class="status-icon status-icon-signal">
            <text class="status-icon-glyph">≣</text>
          </view>
          <text class="status-cell-label">信号</text>
        </view>
        <text class="status-cell-value status-cell-value-ok">信号强</text>
        <text class="status-cell-sub">{{ ringStatus.signalDbm }} dBm · 蓝牙 5.0</text>
      </view>
      <view class="status-cell">
        <view class="status-cell-top">
          <view class="status-icon status-icon-sync">
            <text class="status-icon-glyph">↻</text>
          </view>
          <text class="status-cell-label">同步</text>
        </view>
        <text class="status-cell-value">{{ lastSyncText }}</text>
        <text class="status-cell-sub">数据实时上传中</text>
      </view>
    </view>

    <!-- 设置列表 -->
    <text class="sec-title">设备设置</text>

    <view class="list">
      <view class="list-item" @tap="openSampling" hover-class="list-item-active">
        <view class="list-icon">
          <text class="list-icon-glyph">⏱</text>
        </view>
        <view class="list-body">
          <text class="list-name">数据采样频率</text>
          <text class="list-desc">每分钟一次 · 更频繁将增加电量消耗</text>
        </view>
        <text class="list-val">1 次/分</text>
        <text class="list-arrow">›</text>
      </view>

      <view class="list-item">
        <view class="list-icon">
          <text class="list-icon-glyph">◐</text>
        </view>
        <view class="list-body">
          <text class="list-name">震动提醒</text>
          <text class="list-desc">数值超出参考区间时震动腕间</text>
        </view>
        <view class="toggle" :class="{ 'toggle-off': !vibrate }" @tap="vibrate = !vibrate">
          <view class="toggle-thumb"></view>
        </view>
      </view>

      <view class="list-item" @tap="openThreshold" hover-class="list-item-active">
        <view class="list-icon">
          <text class="list-icon-glyph">⚡</text>
        </view>
        <view class="list-body">
          <text class="list-name">心率上限阈值</text>
          <text class="list-desc">超过后触发关注等级提升</text>
        </view>
        <text class="list-val">140 bpm</text>
        <text class="list-arrow">›</text>
      </view>

      <view class="list-item">
        <view class="list-icon">
          <text class="list-icon-glyph">↑</text>
        </view>
        <view class="list-body">
          <text class="list-name">固件版本</text>
          <text class="list-desc">最新版本 v2.4.1 已就绪</text>
        </view>
        <text class="list-val">v2.4.0</text>
        <text class="list-arrow">›</text>
      </view>
    </view>

    <!-- 手动测量 CTA -->
    <view class="cta-wrap">
      <ag-button label="开始手动测量" type="primary" @tap="startMeasure" />
    </view>

    <!-- 解绑按钮 -->
    <view class="disconnect-wrap" @tap="handleDisconnect" hover-class="disconnect-wrap-active">
      <text class="disconnect-text">解除设备绑定</text>
    </view>

    <text class="disclaimer">— {{ disclaimerShort }} —</text>
    <view style="height: 90px;"></view>
  </scroll-view>
</template>

<script lang="uts">
import { getCurrentKid } from '@/composables/useKid';
import { getRingStatus } from '@/composables/useRing';
import { DISCLAIMER_SHORT } from '@/utils/copy';
import { fmtRelativeTime } from '@/utils/format';
import AgButton from '@/components/ag-button/ag-button.uvue';

export default {
  components: { AgButton },
  data() {
    return {
      statusBarHeight: 44 as number,
      kid: getCurrentKid(),
      ringStatus: getRingStatus(),
      vibrate: true as boolean,
      disclaimerShort: DISCLAIMER_SHORT,
    };
  },
  computed: {
    lastSyncText(): string {
      return fmtRelativeTime(this.ringStatus.lastSyncAt);
    },
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
  },
  methods: {
    startMeasure() {
      uni.navigateTo({ url: '/pages/measure/measuring' });
    },
    openThreshold() {
      uni.navigateTo({ url: '/pages/threshold/threshold' });
    },
    openSampling() {
      uni.showToast({ title: '采样频率设置', icon: 'none' });
    },
    handleDisconnect() {
      uni.showModal({
        title: '解除设备绑定',
        content: '解除后哨兵将无法接收戒指数据。确定继续吗？',
        confirmText: '解除',
        confirmColor: '#E5574A',
        success: (res) => {
          if (res.confirm) {
            uni.showToast({ title: '已解除绑定', icon: 'success' });
          }
        },
      });
    },
  },
};
</script>

<style lang="scss">
