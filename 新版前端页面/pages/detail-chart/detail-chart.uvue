<template>
  <scroll-view class="page" scroll-y="true">
    <view class="status-bar" :style="{ height: `${statusBarHeight}px` }"></view>

    <view class="header">
      <view class="back-btn" @tap="handleBack" hover-class="back-btn-active">
        <text class="back-icon">‹</text>
      </view>
      <text class="header-title">呼吸频率</text>
      <view class="more-btn">
        <text class="more-icon">⋮</text>
      </view>
    </view>

    <!-- 大号当前值 -->
    <view class="hero-metric">
      <text class="hero-label">CURRENT · 当前</text>
      <view class="hero-num-row">
        <text class="hero-num">{{ currentReading.breath }}</text>
        <text class="hero-unit">次/分</text>
      </view>
      <view class="hero-caption">
        <view class="live-dot"></view>
        <text class="hero-caption-text">实时 · 12 秒前 · 平稳</text>
      </view>
    </view>

    <!-- 时段 tabs -->
    <view class="period-tabs">
      <view
        v-for="p in periods"
        :key="p"
        class="period-seg"
        :class="{ 'period-seg-active': period == p }"
        @tap="period = p"
      >
        <text class="period-text" :class="{ 'period-text-active': period == p }">{{ p }}</text>
      </view>
    </view>

    <!-- 图表卡 -->
    <view class="chart-card">
      <view class="stats-row">
        <view class="stat">
          <text class="stat-l">最低</text>
          <view class="stat-v-row">
            <text class="stat-v stat-v-ok">18</text>
            <text class="stat-unit">次/分</text>
          </view>
        </view>
        <view class="stat">
          <text class="stat-l">平均</text>
          <view class="stat-v-row">
            <text class="stat-v">24</text>
            <text class="stat-unit">次/分</text>
          </view>
        </view>
        <view class="stat">
          <text class="stat-l">最高</text>
          <view class="stat-v-row">
            <text class="stat-v stat-v-warn">36</text>
            <text class="stat-unit">次/分</text>
          </view>
        </view>
        <view class="stat">
          <text class="stat-l">时段</text>
          <text class="stat-v">03:12</text>
        </view>
      </view>

      <!-- 图表主体（柱状图版本，模仿曲线趋势）-->
      <view class="chart-area">
        <view class="chart-ref-band"></view>

        <!-- Y 轴 label -->
        <view class="chart-y-labels">
          <text class="y-label">40</text>
          <text class="y-label">30</text>
          <text class="y-label">20</text>
        </view>

        <!-- 数据柱 -->
        <view class="chart-bars">
          <view v-for="(pt, idx) in dataPoints" :key="idx" class="bar-col">
            <view class="bar-space"></view>
            <view
              class="bar"
              :class="{ 'bar-warn': pt.value > 30, 'bar-med': pt.hasMed }"
              :style="{ height: `${(pt.value / 45) * 100}%` }"
            >
              <text v-if="pt.value > 30" class="bar-peak-label">{{ pt.value }}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="chart-x-labels">
        <text class="x-label">00</text>
        <text class="x-label">06</text>
        <text class="x-label">12</text>
        <text class="x-label">18</text>
        <text class="x-label">现在</text>
      </view>

      <!-- 图例 -->
      <view class="legend">
        <view class="legend-item">
          <view class="legend-dot legend-dot-red"></view>
          <text class="legend-text">关注等级</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot legend-dot-med"></view>
          <text class="legend-text">用药</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot legend-dot-ref"></view>
          <text class="legend-text">参考区间</text>
        </view>
      </view>
    </view>

    <!-- 观察建议 -->
    <view class="insight-card">
      <view class="insight-icon">
        <text class="insight-icon-glyph">i</text>
      </view>
      <view class="insight-body">
        <text class="insight-title">今日观察</text>
        <text class="insight-desc">
          03:12 呼吸频率短时升高至 36 次/分 · 用药后 15 分钟回落至参考区间 · 其余时段平稳
        </text>
      </view>
    </view>

    <text class="disclaimer">— {{ disclaimerShort }} —</text>
    <view style="height: 40px;"></view>
  </scroll-view>
</template>

<script lang="uts">
import { getLatestReading, type RingReading } from '@/composables/useRing';
import { DISCLAIMER_SHORT } from '@/utils/copy';

type DataPoint = {
  value: number;
  hasMed: boolean;
};

export default {
  data() {
    return {
      statusBarHeight: 44 as number,
      periods: ['1H', '24H', '7D', '30D', '全部'] as string[],
      period: '24H' as string,
      currentReading: getLatestReading() as RingReading,
      disclaimerShort: DISCLAIMER_SHORT,
      dataPoints: [
        { value: 22, hasMed: false },
        { value: 21, hasMed: false },
        { value: 20, hasMed: false },
        { value: 22, hasMed: false },
        { value: 23, hasMed: false },
        { value: 22, hasMed: false },
        { value: 25, hasMed: false },
        { value: 28, hasMed: false },
        { value: 36, hasMed: false },  // 峰值 · 03:12
        { value: 30, hasMed: true },   // 用药
        { value: 25, hasMed: false },
        { value: 22, hasMed: false },
        { value: 23, hasMed: false },
        { value: 24, hasMed: false },
        { value: 22, hasMed: false },
        { value: 23, hasMed: false },
      ] as DataPoint[],
    };
  },
  onLoad() {
    const info = uni.getSystemInfoSync();
    this.statusBarHeight = info.statusBarHeight ?? 44;
  },
  methods: {
    handleBack() { uni.navigateBack({}); },
  },
};
</script>

