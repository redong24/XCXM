<template>
  <view class="kid-chip" @tap="onTap" hover-class="kid-chip-active">
    <view class="kid-avatar" :style="{ backgroundColor: kid.avatarColor }">
      <text class="kid-avatar-text">{{ kid.name.charAt(0) }}</text>
    </view>
    <view class="kid-info">
      <text class="kid-name">{{ kid.name }} · {{ kid.age }} 岁</text>
      <view class="kid-meta">
        <view class="conn-dot" :class="{ 'conn-dot-off': !connected }"></view>
        <text class="conn-text">{{ metaText }}</text>
      </view>
    </view>
    <text v-if="showArrow" class="kid-arrow">›</text>
  </view>
</template>

<script lang="uts">
/**
 * AGKidChip · 儿童切换条
 * 用法：<ag-kid-chip :kid="kid" :meta-text="'RWFit R2 · 电量 76%'" @tap="openList" />
 */
import type { Kid } from '@/composables/useKid';

export default {
  props: {
    kid: { type: Object as PropType<Kid>, required: true },
    metaText: { type: String, default: '' },
    connected: { type: Boolean, default: true },
    showArrow: { type: Boolean, default: true },
  },
  emits: ['tap'],
  methods: {
    onTap() {
      this.$emit('tap');
    },
  },
};
</script>

