<template>
  <view class="metric-bar">
    <view
      v-for="(cell, index) in cells"
      :key="cell.label"
      class="m-cell"
      :class="{ 'm-cell-divider': index > 0 }"
    >
      <text class="m-label">{{ cell.label }}</text>
      <view class="m-value-row">
        <text class="m-value">{{ cell.value }}</text>
        <text class="m-unit">{{ cell.unit }}</text>
      </view>
      <text class="m-trend" :style="{ color: cell.trendColor }">{{ cell.trend }}</text>
    </view>
  </view>
</template>

<script lang="uts">
/**
 * AGMetricBar · 三格监测数值条
 * 用法：<ag-metric-bar :cells="[{label:'心率', value:'98', unit:'bpm', trend:'↗ 平稳', trendColor:'#6BB280'}]" />
 */

export type MetricCell = {
  label: string;
  value: string;
  unit: string;
  trend: string;
  trendColor: string;
};

export default {
  props: {
    cells: { type: Array as PropType<MetricCell[]>, required: true },
  },
};
</script>

